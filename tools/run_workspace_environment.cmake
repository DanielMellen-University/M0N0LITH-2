# No case inherits the caller's workspace or home variables.
set(out "")
set(err "")
set(code 0)
foreach(mode explicit empty home profile empty-home home-priority none empty-homes)
  set(env_args --unset=M0N0LITH_WORKSPACE --unset=HOME --unset=USERPROFILE)
  # Windows launches the child with an explicit environment block and, when
  # USERPROFILE is missing from it, copies the caller's value back in. HOME is
  # not restored that way. An empty USERPROFILE is kept, and open_default
  # treats an empty profile the same as an unset one. Cases that set
  # USERPROFILE overwrite this.
  if(WIN32)
    list(APPEND env_args "USERPROFILE=")
  endif()
  set(case_dir "${run_dir}/${mode}")
  file(MAKE_DIRECTORY "${case_dir}")
  set(chosen "-")
  if(mode STREQUAL "explicit")
    set(chosen "${case_dir}/chosen/nested")
    list(APPEND env_args "M0N0LITH_WORKSPACE=${chosen}" "HOME=${case_dir}/unused")
  elseif(mode STREQUAL "empty")
    list(APPEND env_args "M0N0LITH_WORKSPACE=" "HOME=${case_dir}/unused")
  elseif(mode STREQUAL "home" OR mode STREQUAL "home-priority")
    set(chosen "${case_dir}/home/.m0n0lith2/workspace")
    list(APPEND env_args "HOME=${case_dir}/home/")
    if(mode STREQUAL "home-priority")
      list(APPEND env_args "USERPROFILE=${case_dir}/unused")
    endif()
  elseif(mode STREQUAL "profile" OR mode STREQUAL "empty-home")
    set(chosen "${case_dir}/profile/.m0n0lith2/workspace")
    list(APPEND env_args "USERPROFILE=${case_dir}/profile")
    if(mode STREQUAL "empty-home")
      list(APPEND env_args "HOME=")
    endif()
  elseif(mode STREQUAL "empty-homes")
    list(APPEND env_args "HOME=" "USERPROFILE=")
  endif()
  execute_process(COMMAND ${CMAKE_COMMAND} -E env ${env_args} ${RELIC} ${TEST} ${mode} "${chosen}"
    WORKING_DIRECTORY "${case_dir}" OUTPUT_VARIABLE part ERROR_VARIABLE part_err RESULT_VARIABLE part_code)
  string(APPEND out "${part}")
  if(NOT part_code EQUAL 0)
    set(code "${part_code}")
    string(APPEND err "${mode}: ${part_err}")
    break()
  endif()
  if(EXISTS "${case_dir}/unused")
    set(code 1)
    set(err "${mode}: unused home was opened")
    break()
  endif()
endforeach()
