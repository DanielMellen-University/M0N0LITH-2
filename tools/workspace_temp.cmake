# A private host directory for each workspace test, outside the source tree.
function(workspace_temp out)
  set(base "$ENV{TMPDIR}")
  if(NOT base)
    set(base "$ENV{TEMP}")
  endif()
  if(NOT base)
    set(base "/tmp")
  endif()
  string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
  set(dir "${base}/m2-workspace-${suffix}")
  file(MAKE_DIRECTORY "${dir}")
  set(${out} "${dir}" PARENT_SCOPE)
endfunction()
