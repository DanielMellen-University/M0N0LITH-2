# D0122 case 8 setup: one committed generation holding v1. The driver then
# adds a wrong-version g2 by hand and points COMMITTED at it, with META
# naming committed g2 and previous g1. Run from the repo root:
#   relic/build/relic tools/workspace-recovery-muse/case8_setup.relic <dir>
use ../../shell/wm
use std/os
use std/vfs

fun type_line(t, line)
    for ch in line
        if ch == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, ch)
    wm.terminal.on_key(t, "return")

fun desktop()
    return wm.new_desktop(640, 480, wm.default_apps())

let args = os.args()
if len(args) != 1
    fail("case8_setup needs the workspace directory")
let d = desktop()
wm.workspace_open(args[0])
wm.workspace_bind(d)
let t = wm.terminal.init()
type_line(t, "echo first version > note.txt")
print("after v1", [wm.workspace_notice()])
print("note", [vfs.read(t.fs, "/home/note.txt")])
