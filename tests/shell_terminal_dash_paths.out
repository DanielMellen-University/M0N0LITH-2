["/home> cd /tmp"]
["/tmp> write -h", "write: no options, not even -h"]
["/tmp> write -x some text", "write: no options, not even -x"]
["/tmp> echo hi > -x", "echo: a path cannot start with -: -x"]
["/tmp> echo hi >> --", "echo: a path cannot start with -: --"]
["/tmp> ls"]
no dash files: true
["/tmp> echo -n -x", "-n -x"]
["/tmp> write notes -x -y"]
["/tmp> cat notes", "-x -y"]
["/tmp> echo -- > notes"]
["/tmp> cat notes", "--"]
["/tmp> write ./-x made on purpose"]
["/tmp> cat ./-x", "made on purpose"]
["/tmp> rm ./-x"]
["/tmp> rm notes"]
["/tmp> ls"]
