# Terminal Tab: the first word completes from the command names, a later one
# from the names in its folder (a folder gets "/", a file a space); several
# names go as far as they agree, and a Tab that adds nothing lists them under
# the line, as a shell does.
use ../shell/wm
use std/vfs
use std/strings
let t = wm.terminal.init()
fun typed(line)
    for ch in line
        if ch == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, ch)
fun tab(line)
    t.input = ""
    typed(line)
    wm.terminal.on_key(t, "tab")
    return t.input
vfs.make_dir(t.fs, "/home/docs")
vfs.write(t.fs, "/home/draft.txt", "x")
vfs.write(t.fs, "/home/docs/plan.txt", "x")
vfs.write(t.fs, "/home/docs/plans.txt", "x")
print([tab("pw"), tab("c"), tab("mk"), tab("zz"), tab("")])
print([tab("cat w"), tab("cd do"), tab("cat d"), tab("cat docs/p"), tab("cat /home/docs/plans"), tab("ls /nope/x"), tab("cat welcome.txt/x")])
let before = len(t.buf)
tab("cat docs/plan")
wm.terminal.on_key(t, "tab")
print([t.input], slice(t.buf, before, len(t.buf)))
t.cwd = "/home/docs"
print([tab("rm ../dr"), tab("rm p"), tab("rm ./plans")])
# the commands added later complete too: sort, uniq and nl
print([tab("so"), tab("un"), tab("n")])
# every command help lists completes to itself, so a new command cannot be
# left out of the Tab list again (the last two help lines are about > and quotes)
t.cwd = "/home"
t.input = ""
let shown = len(t.buf)
typed("help")
wm.terminal.on_key(t, "return")
let listed = slice(t.buf, shown + 1, len(t.buf) - 2)
print(len(listed), "help lines of commands")
let missing = []
for line in listed
    for word in strings.split(line, " ")
        if tab(word) != word + " "
            append(missing, word)
print("help commands Tab misses:", missing)
# a name with a space goes in quotes (open for a folder), and a word begun
# with a quote, or with spaces in quotes, completes from inside them
t.cwd = "/home"
vfs.make_dir(t.fs, "/home/old stuff")
vfs.write(t.fs, "/home/old stuff/a b.txt", "x")
vfs.write(t.fs, "/home/my notes.txt", "x")
vfs.write(t.fs, "/home/my notes 2.txt", "x")
vfs.write(t.fs, "/home/don't.txt", "x")
print([tab("cat ol"), tab("cat \"ol"), tab("cat 'ol"), tab("cat \"old stuff/a"), tab("cat don't"), tab("cat my")])
print([tab("cat \"my notes.txt\" dr"), tab("echo \"a b\" > dr")])
