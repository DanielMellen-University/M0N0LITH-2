# cd of a missing path that ends in / says it is not found, and stays put.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("cd /tmp/nope/")
run("pwd")
run("cd missing/")
run("pwd")
