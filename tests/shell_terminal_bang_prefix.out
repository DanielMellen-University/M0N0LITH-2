["/home> echo alpha", "alpha"]
["/home> echo beta", "beta"]
["/home> pwd", "/home"]
["/home> echo beta", "beta"]
["/home> echo beta", "beta"]
["/home> pwd", "/home"]
["/home> !nope", "!nope: not in history"]
["/home> pwd", "/home"]
["/home> echo beta", "beta"]
["/home> !", "unknown: !"]
history ["echo alpha", "echo beta", "pwd", "echo beta", "pwd", "echo beta", "!"]
