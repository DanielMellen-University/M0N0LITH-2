# ! and five digits is history entry 1; ! and six digits is not a history number.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
fun type(line)
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
type("echo once")
t.buf = []
type("!00001")
print(t.buf)
t.buf = []
type("!000001")
print(t.buf)
t.buf = []
type("!99999")
print(t.buf)
