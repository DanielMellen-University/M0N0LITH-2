# Editor, Notes and Clicker: keys, saving, and keys the apps ignore
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
fun keys(list)
    for k in list
        wm.key(d, k)

# Editor: backspace eats the newline, enter and space add text, ctrl+s saves
let e = wm.launch(d, wm.editor)
print(e.app.lines(e.state))
keys(["backspace", "backspace", "x", "space", "enter", "y", "ctrl+s"])
print(e.app.lines(e.state))
# keys it does not know change nothing, status included
keys(["tab", "shift", "delete", "escape", "ctrl+x", "F1"])
print(e.app.lines(e.state))
# backspace on an empty buffer does nothing; saving writes the empty text
for i in 0..40
    wm.key(d, "backspace")
keys(["backspace", "ctrl+s"])
print(e.app.lines(e.state))
# a second Editor reads what was saved
let e2 = wm.launch(d, wm.editor)
print(e2.app.lines(e2.state))

# Notes: one line; enter and return are ignored
let n = wm.launch(d, wm.notes)
keys(["h", "i", "space", "enter", "return", "backspace", "backspace", "z"])
print(n.app.lines(n.state))

# Clicker: a click or the space bar counts, other keys do not
let c = wm.launch(d, wm.clicker)
keys(["space", "a", "enter"])
print(c.app.lines(c.state))
print(wm.click(d, c.x + 5, c.y + wm.title_height + 5), c.app.lines(c.state))
