# Ctrl+C keeps the line as it was then, so a later edit is not what Ctrl+V pastes.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("hello")
key("ctrl+c")
key("ctrl+u")
type("z")
key("ctrl+v")
line()
