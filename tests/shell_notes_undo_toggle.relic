# Ctrl+Z swaps the line with the one it just restored, one step only.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("hello")
key("ctrl+u")
line()
key("ctrl+z")
line()
key("ctrl+z")
line()
key("ctrl+z")
line()
