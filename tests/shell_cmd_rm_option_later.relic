# rm stops at a dash word even when a real path came first, and the file stays.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("touch /tmp/keep.txt")
run("rm /tmp/keep.txt -f")
print("kept", vfs.exists(t.fs, "/tmp/keep.txt"))
run("rm /tmp/keep.txt")
print("gone", not vfs.exists(t.fs, "/tmp/keep.txt"))
