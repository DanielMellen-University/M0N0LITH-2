# mkdir of . or .. or / does not make a new folder: those are already there.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("mkdir .")
run("mkdir ..")
run("mkdir /")
run("mkdir /tmp/.")
print("tmp", vfs.is_dir(t.fs, "/tmp"))
print("home", vfs.is_dir(t.fs, "/home"))
