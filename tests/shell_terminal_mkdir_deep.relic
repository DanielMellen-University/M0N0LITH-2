# mkdir makes the missing folders above the new one.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    return slice(t.buf, 1, len(t.buf))

print(run("mkdir /tmp/a/b/c"))
print(vfs.is_dir(t.fs, "/tmp/a"), vfs.is_dir(t.fs, "/tmp/a/b"), vfs.is_dir(t.fs, "/tmp/a/b/c"))
print(run("mkdir /tmp/a/b/c"))
