# Window input arms the snapshot; the app clock and unused mouse motion do not.
use ../shell/wm
use std/files
use std/vfs

fun check(label, got, want)
    if got != want
        fail(label + ": " + str(got) + " != " + str(want))

fun pointer() = files.read("ws-idle-inputs/COMMITTED")
fun pause(d)
    wm.tick(d, 0)
    wm.tick(d, 2001)

wm.workspace_open("ws-idle-inputs")
let d = wm.new_desktop(640, 480, wm.default_apps())
wm.workspace_bind(d)
let notes = wm.launch(d, wm.notes)
wm.key(d, "n")
wm.tick(d, 0)
wm.handle(d, {type: "mouse_move", x: 639, y: 0})
wm.tick(d, 1999)
check("Notes waits", pointer(), "g1\n")
wm.tick(d, 2000)
check("unused motion does not postpone", pointer(), "g2\n")

let ide = wm.launch(d, wm.ide)
wm.key(d, "i")
pause(d)
check("IDE input", pointer(), "g4\n")
check("IDE vfs unchanged", vfs.read(ide.state.fs, ide.state.path), "Welcome to Relic.\n")
let paint = wm.launch(d, wm.paint_app)
wm.key(d, "2")
pause(d)
check("Paint key", pointer(), "g6\n")
let x = paint.x + 6
let y = paint.y + wm.title_height + 40
wm.handle(d, {type: "mouse_down", button: 1, x: x, y: y})
wm.tick(d, 0)
check("Paint click waits", pointer(), "g6\n")
wm.motion(d, x + 8, y)
wm.tick(d, 1999)
wm.tick(d, 3998)
check("Paint drag restarts interval", pointer(), "g6\n")
wm.tick(d, 3999)
check("Paint held stroke snapshot", pointer(), "g7\n")
check("Paint first cell", paint.state.cells[0], 2)
check("Paint dragged cell", paint.state.cells[1], 2)
check("Paint vfs unchanged", vfs.exists(paint.state.fs, paint.state.path), false)
wm.release(d)
check("release snapshot", pointer(), "g8\n")
pause(d)
check("release clears pending", pointer(), "g8\n")

wm.workspace_open("ws-idle-inputs")
let restored = wm.new_desktop(640, 480, wm.default_apps())
wm.workspace_bind(restored)
check("Notes restored", restored.windows[0].state.text, "n")
check("IDE restored", restored.windows[1].state.text, "Welcome to Relic.\ni")
check("Paint restored", restored.windows[2].state.cells[1], 2)
let clicker = wm.launch(restored, wm.clicker)
wm.click(restored, clicker.x + 6, clicker.y + wm.title_height + 6)
pause(restored)
check("click without drag", pointer(), "g10\n")
let term = wm.launch(restored, wm.terminal)
wm.key(restored, "return")
check("Terminal command snapshot", pointer(), "g12\n")
pause(restored)
check("Terminal command clears pending", pointer(), "g12\n")
check("wheel handled", wm.wheel(restored, 1), true)
pause(restored)
check("wheel input", pointer(), "g13\n")
let editor = wm.launch(restored, wm.editor)
wm.key(restored, "ctrl+a")
check("selection snapshot", wm.workspace_flush(), "")
check("Escape handled", wm.dismiss(restored), true)
pause(restored)
check("Escape input", pointer(), "g16\n")

let snake = wm.launch(restored, wm.snake)
# Start without window input, so only the app clock is under test.
snake.app.on_key(snake.state, "right")
snake.state.food = [0, 0]
wm.tick(restored, 0)
wm.tick(restored, 150)
check("tick still reaches Snake", snake.state.body[2], [6, 8])
for i in 2..30
    wm.tick(restored, i * 150)
check("Snake clock does not write", pointer(), "g17\n")
wm.click(restored, 639, 0)
wm.click(restored, 1, wm.bar_top(restored) + 1)
wm.key(restored, "down")
pause(restored)
check("desktop and menu input do not write", pointer(), "g17\n")
files.remove_tree("ws-idle-inputs")
print("Notes, IDE, Paint, clicks, drags, wheel and Escape snapshot; Snake clock stays quiet")
