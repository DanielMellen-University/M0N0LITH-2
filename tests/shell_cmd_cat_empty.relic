# cat of an empty file prints no line of text. A file that is only a newline
# prints one blank line.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("touch /tmp/empty.txt")
run("cat /tmp/empty.txt")
vfs.write(t.fs, "/tmp/blank.txt", "\n")
run("cat /tmp/blank.txt")
