# The title is cut so it stops before the minimize and close boxes.
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
let w = wm.launch(d, wm.notes)
print(wm.title_text(w))
w.width = 48
print("[" + wm.title_text(w) + "]")
w.width = 36
print("[" + wm.title_text(w) + "]")
w.width = 220
print(wm.title_text(w) == "Notes")
