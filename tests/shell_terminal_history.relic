# The Terminal keeps the last 200 lines of output, however much a command prints.
use ../shell/wm
use std/vfs

let d = wm.new_desktop(640, 480, wm.default_apps())
let t = wm.launch(d, wm.terminal)

fun type(text)
    for c in text
        if c == " "
            wm.key(d, "space")
        else
            wm.key(d, c)
    wm.key(d, "return")

print(len(t.state.buf), t.state.buf[0])
for i in 0..150
    type("echo n{i}")
print(len(t.state.buf), t.state.buf[0], t.state.buf[199])

let big = ""
for i in 0..500
    big = big + "row {i}\n"
vfs.write(t.state.fs, "/home/big.txt", big)
type("cat big.txt")
print(len(t.state.buf), t.state.buf[0], t.state.buf[199])
type("clear")
print(len(t.state.buf))
type("echo after")
print(t.state.buf)
# !N runs command N of history again, as history numbers them, shown as it runs
let h = wm.terminal.init()
fun hrun(line)
    for c in line
        if c == " "
            wm.terminal.on_key(h, "space")
        else
            wm.terminal.on_key(h, c)
    wm.terminal.on_key(h, "return")
hrun("echo first")
hrun("echo second")
h.buf = []
hrun("!1")
print(h.buf)
h.buf = []
hrun("history")
print(h.buf)
h.buf = []
hrun("!9")
hrun("!0")
hrun("!x")
print(h.buf)
