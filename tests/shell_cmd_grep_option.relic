# grep rejects flags outside its small supported set.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
vfs.write(t.fs, "/tmp/g.txt", "Apple\napple")
run("grep -x apple /tmp/g.txt")
run("grep -z apple /tmp/g.txt")
run("grep apple /tmp/g.txt")
