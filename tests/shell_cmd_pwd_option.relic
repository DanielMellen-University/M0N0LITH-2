# pwd -P is an extra word, so it prints usage and the folder is unchanged.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("pwd -P")
run("pwd")
run("cd /tmp")
run("pwd --")
run("pwd")
