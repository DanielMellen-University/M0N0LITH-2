# cd with no path returns to /home. cd . stays. cd .. from / stays at /.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    return slice(t.buf, 1, len(t.buf))

run("cd /tmp")
print("tmp", run("pwd"))
print("home", run("cd"), run("pwd"))
run("cd /tmp")
print("dot", run("cd ."), run("pwd"))
print("root", run("cd /"), run("cd .."), run("pwd"))
