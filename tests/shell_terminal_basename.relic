# basename and dirname read the path as written. The file does not have to exist.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("basename /home/a.txt")
run("dirname /home/a.txt")
run("basename a.txt")
run("dirname a.txt")
run("basename /")
run("dirname /")
run("basename /home")
run("dirname /home")
run("basename \"my notes.txt\"")
run("dirname \"/home/my notes.txt\"")
run("basename missing")
run("basename")
run("dirname")
run("basename a b")
run("basename -x")
run("dirname -x")
print("no file", vfs.exists(t.fs, "/home/missing"))
