# cd . stays, and cd ../home from /tmp comes back.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("cd .")
run("pwd")
run("cd /tmp")
run("cd .")
run("pwd")
run("cd ../home")
run("pwd")
run("cd ..")
run("pwd")
