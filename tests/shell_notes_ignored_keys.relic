# Return, arrows Notes does not use, and shortcuts of other apps leave the line alone.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("ab")
line()
for k in ["return", "enter", "up", "down", "pageup", "pagedown", "tab", "f2", "f5", "escape", "ctrl+s", "shift+left", "ctrl+f"]
    key(k)
line()
print("text", n.text)
