# Ctrl+Backspace at the start of the file removes nothing.
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
let e = wm.launch(d, wm.editor)
let s = e.state
fun pos() = len(s.text) - s.back

s.text = "ab"
s.back = len(s.text)
s.undo = []
wm.key(d, "ctrl+backspace")
print([s.text], len(s.undo))
