# Ctrl+Backspace takes the word before the cursor, and spaces after that word go with it.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("hello   ")
key("ctrl+backspace")
line()
type("ab  cd")
key("left")
key("left")
key("ctrl+backspace")
line()
