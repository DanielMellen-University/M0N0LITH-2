# Terminal keys with no action there: Escape, Shift with an arrow, Ctrl+W,
# Alt+Backspace and F1 leave the line and the cursor alone, at the end of
# the line and in the middle of it.
use ../shell/wm
let t = wm.terminal.init()
fun typed(line)
    for ch in line
        if ch == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, ch)
fun keys(list)
    for k in list
        wm.terminal.on_key(t, k)
fun prompt()
    let lines = wm.terminal.lines(t)
    return lines[len(lines) - 1]
typed("ab cd")
keys(["escape", "shift+left", "ctrl+w", "alt+backspace"])
print([t.input], t.left, prompt())
keys(["left", "left"])
keys(["escape", "shift+left", "shift+right", "ctrl+w", "alt+backspace", "f1"])
print([t.input], t.left, prompt())
