# Escape gives up a Delete question. It does not remove the file, and it is
# taken, so it does not quit the desktop. A second Escape is not taken.
use ../shell/wm
use std/vfs
let d = wm.new_desktop(640, 480, wm.default_apps())
let f = wm.launch(d, wm.files_app)
let fs = f.state.fs
vfs.write(fs, "/tmp/z.txt", "z")
f.state.path = "/tmp"
wm.visible_lines(f)
for i in 0..len(f.state.names)
    if f.state.names[i] == "z.txt"
        f.state.sel = i
wm.key(d, "delete")
print("asked", wm.visible_lines(f)[0])
print("escape", wm.dismiss(d))
print("after", wm.visible_lines(f)[0], f.state.confirm, vfs.exists(fs, "/tmp/z.txt"))
print("again", wm.dismiss(d))
