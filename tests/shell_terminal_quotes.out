["/home> touch \"my notes.txt\""]
made true
["/home> echo first line > 'my notes.txt'"]
["/home> cat \"my notes.txt\"", "first line"]
["/home> echo more >> 'my notes.txt'"]
["/home> cat 'my notes.txt'", "first line", "more"]
["/home> wc \"my notes.txt\"", "2 3 16 \"my notes.txt\""]
["/home> mkdir \"a folder\""]
["/home> mv 'my notes.txt' \"a folder\""]
["/home> ls \"a folder\"", "\"my notes.txt\""]
["/home> cd 'a folder'"]
["/home/a folder> pwd", "/home/a folder"]
["/home/a folder> cat \"my notes.txt\" missing", "first line", "more", "cat: not found: /home/a folder/missing"]
["/home/a folder> cp \"my notes.txt\" 'copy of it'"]
["/home/a folder> ls", "\"copy of it\"  \"my notes.txt\""]
["/home/a folder> rm 'copy of it'"]
["/home/a folder> cd .."]
["/home> echo \"it's here\" 'say \"hi\"'", "it's here say \"hi\""]
["/home> echo \"a   b\"", "a   b"]
["/home> echo '' x", " x"]
["/home> mkdir \"\"", "mkdir: already there: /home"]
["/home> echo don't stop, it's \"fine\"", "don't stop, it's fine"]
["/home> touch it's"]
made it's true
["/home> rm it's"]
["/home> touch \"half open", "no closing \""]
not made true true
["/home> echo 'x", "no closing '"]
["/home> echo a \">\" b", "a > b"]
["/home> echo a '>'", "a >"]
["/home> echo a \">>\" '/tmp/x'", "a >> /tmp/x"]
no /tmp/x true
["/home> echo a > \"/tmp/with space\""]
["/home> cat '/tmp/with space'", "a"]
["/home> rm \"a\" \"b\"", "rm: not found: /home/a", "rm: not found: /home/b"]
["/home> touch plain.txt"]
["/home> mkdir \"old stuff\""]
["/home> touch 'old stuff/say \"hi\".txt'"]
["/home> ls", "\"a folder/\"  \"old stuff/\"", "plain.txt  welcome.txt"]
["/home> ls \"old stuff\"", "'say \"hi\".txt'"]
["/home> ls 'a folder/my notes.txt'", "\"my notes.txt\""]
["/home> find stuff", "\"old stuff/\""]
["/home> find hi", "'old stuff/say \"hi\".txt'"]
["/home> write /tmp/poem.txt x"]
["/home> grep \"old pond\" /tmp/poem.txt", "the old pond"]
["/home> grep 'old  pond' /tmp/poem.txt", "old  pond twice"]
["/home> grep \"frog jumps\" '/tmp/poem.txt'", "a frog jumps in"]
["/home> find \"d st\"", "\"old stuff/\""]
["/home> grep \" \" /tmp/poem.txt", "the old pond", "a frog jumps in", "old  pond twice", "sound of water"]
["cat \"/home/a folder/my notes.txt\"", "\"/home/a folder/my notes.txt\"", "cat x/home/a folder/my notes.txt", "cat \"/home/a folder/my notes.txt"]
["echo /home/not there"]
["echo two words"]
