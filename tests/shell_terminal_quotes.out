["/home> touch \"half open", "no closing \""]
not made true true
["/home> echo 'x", "no closing '"]
["/home> echo a \">\" b", "a > b"]
["/home> echo a '>'", "a >"]
["/home> echo a \">>\" '/tmp/x'", "a >> /tmp/x"]
no /tmp/x true
["/home> echo a > \"/tmp/with space\""]
["/home> cat '/tmp/with space'", "a"]
