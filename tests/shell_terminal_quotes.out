["/home> touch \"my notes.txt\""]
made true
["/home> echo first line > 'my notes.txt'"]
["/home> cat \"my notes.txt\"", "first line"]
["/home> echo more >> my' 'notes.txt"]
["/home> cat 'my notes.txt'", "first line", "more"]
["/home> wc \"my notes.txt\"", "2 3 16 my notes.txt"]
["/home> mkdir \"a folder\""]
["/home> mv 'my notes.txt' \"a folder\""]
["/home> ls \"a folder\"", "my notes.txt"]
["/home> cd 'a folder'"]
["/home/a folder> pwd", "/home/a folder"]
["/home/a folder> cat \"my notes.txt\" missing", "first line", "more", "cat: not found: /home/a folder/missing"]
["/home/a folder> cp \"my notes.txt\" 'copy of it'"]
["/home/a folder> ls", "copy of it  my notes.txt"]
["/home/a folder> rm 'copy of it'"]
["/home/a folder> cd .."]
["/home> echo \"it's here\" 'say \"hi\"'", "it's here say \"hi\""]
["/home> echo \"a   b\"", "a   b"]
["/home> echo '' x", " x"]
