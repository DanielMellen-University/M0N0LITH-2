# write will not replace a folder, and will not create a file whose parent is missing.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("write /tmp hello")
print("tmp dir", vfs.is_dir(t.fs, "/tmp"))
run("write /tmp/no/out.txt hello")
print("no", not vfs.exists(t.fs, "/tmp/no"))
run("write /tmp/out.txt hello there")
print("bytes", vfs.read(t.fs, "/tmp/out.txt") == "hello there\n")
