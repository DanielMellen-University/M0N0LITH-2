# Editor click: a click on a text line puts the cursor on that character,
# past the line's end at its end, and drops the selection. The title line
# does nothing; the IDE's output pane and a waiting run ignore clicks.
use ../shell/wm
use std/strings
use std/math
fun frozen_clock() = 1000
wm.ide_clock(frozen_clock)
let d = wm.new_desktop(640, 480, wm.default_apps())
let e = wm.launch(d, wm.editor)
e.state.text = "first line\nsecond\nthe third line"
fun show(label)
    let lines = wm.visible_lines(e)
    let shown = []
    for i in 1..len(lines)
        append(shown, lines[i])
    print(label, shown)
# the point of character col on shown row r (row 0 is the title)
fun at(w, r, col)
    return [w.x + wm.text_left + col * wm.char_width + 3, w.y + wm.title_height + wm.text_top + r * wm.line_height + 5]
fun click_at(w, r, col)
    let p = at(w, r, col)
    print("click row {r} col {col}:", wm.click(d, p[0], p[1]))
show("start")
click_at(e, 1, 3)
show("first line, col 3")
click_at(e, 3, 4)
show("third line, col 4")
click_at(e, 3, 9)
show("after the cursor: the _ does not count")
click_at(e, 2, 20)
show("past the end of second")
wm.key(d, "X")
show("typed there")
# left of the text: the line's start
let p = at(e, 1, 0)
wm.click(d, p[0] - 5, p[1])
show("left margin")
# the title line does nothing
click_at(e, 0, 5)
show("title")
# below the last line does nothing
click_at(e, 4, 2)
show("below the text")
# a click drops the selection
wm.key(d, "ctrl+a")
click_at(e, 1, 2)
wm.visible_lines(e)
print("selection after click", e.state.marks)
show("after select all and click")
# a long line cut on the left: the click counts from what shows
e.state.text = "short\n" + strings.repeat("abcdefghij", 6)
e.state.back = 0
e.state.mark = none
show("long line")
click_at(e, 2, 0)
print("pos", len(e.state.text) - e.state.back)
show("first shown character")
# IDE: the pane ignores clicks, and so does a run waiting for input
let ide = wm.launch(d, wm.ide)
ide.state.text = "print(1)\nprint(2)"
ide.state.back = 0
wm.key(d, "ctrl+r")
let lines = wm.visible_lines(ide)
print(lines)
click_at(ide, 1, 3)
print("ide pos", len(ide.state.text) - ide.state.back)
click_at(ide, len(lines) - 1, 0)
print("pane click pos", len(ide.state.text) - ide.state.back)
ide.state.text = "use std/os\nprint(os.read_line())"
ide.state.back = 0
wm.key(d, "ctrl+r")
wm.visible_lines(ide)
click_at(ide, 1, 2)
print("waiting run pos", len(ide.state.text) - ide.state.back, ide.state.status)
# press and drag selects from the press to the pointer, above or below the
# text to the first or last shown line; a plain click after drops it
let e2 = wm.launch(d, wm.editor)
e2.state.text = "first line\nsecond\nthe third line"
e2.state.back = 0
fun sel(w)
    wm.visible_lines(w)
    let s = w.state
    let a = len(s.text) - s.back
    let b = a
    if s.mark != none
        b = len(s.text) - s.mark
    return [math.min(a, b), math.max(a, b)]
wm.visible_lines(e2)
let p1 = at(e2, 1, 6)
wm.click(d, p1[0], p1[1])
let p2 = at(e2, 3, 3)
wm.motion(d, p2[0], p2[1])
print("dragged", sel(e2), e2.state.marks)
let p3 = at(e2, 2, 2)
wm.motion(d, p3[0], p3[1])
print("back up", sel(e2))
wm.motion(d, p3[0], e2.y + 2)
print("above the text: the first line", sel(e2))
wm.motion(d, p3[0], e2.y + e2.height + 10)
print("below the text: the last line", sel(e2))
wm.release(d)
wm.key(d, "Z")
let typed = wm.visible_lines(e2)
print("typed over it", slice(typed, 1, len(typed)))
# a click with no move selects nothing, and a move after the release does nothing
let p4 = at(e2, 1, 2)
wm.click(d, p4[0], p4[1])
wm.release(d)
wm.motion(d, p2[0], p2[1])
wm.visible_lines(e2)
print("click, release, move", e2.state.mark, e2.state.marks)
# a double-click selects the word under it, a triple-click the line with its
# newline (mouse_down events carry the count)
e2.state.text = "let foo_bar = é1 + x\nnext line"
e2.state.back = 0
e2.state.mark = none
wm.visible_lines(e2)
fun press(w, r, col, n)
    let p = at(w, r, col)
    wm.handle(d, {type: "mouse_down", button: 1, x: p[0], y: p[1], clicks: n})
    wm.handle(d, {type: "mouse_up", button: 1, x: p[0], y: p[1]})
    let s = sel(w)
    print("clicks {n} at col {col}:", s, [slice(w.state.text, s[0], s[1])])
press(e2, 1, 6, 1)
press(e2, 1, 6, 2)
press(e2, 1, 15, 2)
press(e2, 1, 12, 2)
press(e2, 1, 3, 3)
press(e2, 2, 1, 3)
# IDE: a click on the error in the pane, or on the line naming Ctrl+E, goes
# to the error's line and column; other pane lines do nothing
let ide2 = wm.launch(d, wm.ide)
ide2.state.text = "print(1)\nprint(2)\nprint(nope)\nprint(4)"
ide2.state.back = 0
wm.key(d, "ctrl+r")
let il = wm.visible_lines(ide2)
print(il)
fun ide_pos()
    return len(ide2.state.text) - ide2.state.back
fun row_starting(lines, prefix)
    for r in 0..len(lines)
        if strings.starts_with(lines[r], prefix)
            return r
    return -1
let err_row = row_starting(il, "/home/welcome.txt:3:")
let head_row = row_starting(il, "-- output (ctrl+e")
let plain_row = row_starting(il, "2")
click_at(ide2, err_row, 3)
print("error clicked: pos", ide_pos())
wm.key(d, "ctrl+end")
wm.visible_lines(ide2)
click_at(ide2, head_row, 0)
print("header clicked: pos", ide_pos())
wm.key(d, "ctrl+end")
il = wm.visible_lines(ide2)
click_at(ide2, plain_row, 0)
print("output line clicked: pos", ide_pos(), len(ide2.state.text))
# a key while the button is held ends the drag: after the text went, a move
# must not leave the selection's end past the text
let e3 = wm.launch(d, wm.editor)
e3.state.text = "hello world\nmore"
e3.state.back = 0
wm.visible_lines(e3)
let p5 = at(e3, 1, 2)
wm.click(d, p5[0], p5[1])
wm.key(d, "ctrl+a")
wm.key(d, "backspace")
wm.motion(d, p5[0] + 20, p5[1])
print("key during a drag", e3.state.back, e3.state.mark, len(e3.state.text))
wm.release(d)
