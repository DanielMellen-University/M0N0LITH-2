# Paint edges: a key while the button is held ends the stroke or shape, so
# Ctrl+Z in the middle of one cannot draw it back over the undone picture.
use ../shell/wm
use std/vfs
let d = wm.new_desktop(640, 480, wm.default_apps())
let w = wm.launch(d, wm.paint_app)
let s = w.state
fun at(x, y) = [w.x + x, w.y + wm.title_height + y]
fun cell(cx, cy) = [6 + cx * 4 + 2, 40 + cy * 4 + 2]
fun press(c)
    let p = at(cell(c[0], c[1])[0], cell(c[0], c[1])[1])
    wm.click(d, p[0], p[1])
fun move(c)
    let p = at(cell(c[0], c[1])[0], cell(c[0], c[1])[1])
    wm.motion(d, p[0], p[1])
fun count(k)
    let n = 0
    for c in s.cells
        if c == k
            n = n + 1
    return n
# a rectangle, Ctrl+Z while still held, then the pointer moves on
wm.key(d, "r")
press([2, 2])
move([10, 8])
print("rect drawn", count(1) > 0, len(s.undo))
wm.key(d, "ctrl+z")
move([12, 9])
print("after ctrl+z and a move", count(1), len(s.undo), len(s.redo))
wm.release(d)
# a brush stroke, Ctrl+Z while held, then more dragging
wm.key(d, "b")
press([20, 20])
move([25, 20])
wm.key(d, "ctrl+z")
move([30, 20])
print("brush after ctrl+z and a move", count(1), len(s.undo))
wm.release(d)
# c on a blank canvas is not an undo step and leaves the status alone
let p2 = wm.launch(d, wm.paint_app)
let s2 = p2.state
let undo_before = len(s2.undo)
wm.key(d, "c")
print("clear blank", len(s2.undo) - undo_before, s2.status)
s2.cells[5] = 3
wm.key(d, "c")
print("clear drawn", len(s2.undo) - undo_before, s2.status, s2.cells[5])
wm.key(d, "ctrl+z")
print("undone", s2.cells[5])
# typing a name: Ctrl+V pastes the clipboard's first line, Ctrl+Backspace
# drops a word, Ctrl+U empties it
let note = wm.launch(d, wm.notes)
for ch in "/tmp/sketch"
    wm.key(d, ch)
wm.key(d, "ctrl+c")
wm.close(d, note.id)
wm.restore(d, p2.id)
wm.key(d, "n")
wm.key(d, "ctrl+v")
print(wm.visible_lines(p2)[0])
wm.key(d, "ctrl+backspace")
print(wm.visible_lines(p2)[0])
wm.key(d, "ctrl+u")
print(wm.visible_lines(p2)[0])
wm.key(d, "ctrl+v")
wm.key(d, "return")
print(s2.path, vfs.exists(s2.fs, "/tmp/sketch.paint"))
# a name too long for the window keeps its end, where the typing is; a wider
# window shows the hint again
wm.key(d, "n")
for ch in "/tmp/a-long-name-for-paint"
    wm.key(d, ch)
print(wm.visible_lines(p2)[0])
p2.width = 620
print(wm.visible_lines(p2)[0])
wm.dismiss(d)
