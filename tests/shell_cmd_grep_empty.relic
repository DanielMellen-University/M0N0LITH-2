# An empty search text is in every line, including a blank one.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
vfs.write(t.fs, "/tmp/g.txt", "one\n\ntwo")
run("grep \"\" /tmp/g.txt")
run("grep '' /tmp/g.txt")
