# nl needs exactly one path.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
vfs.write(t.fs, "/tmp/n.txt", "a\nb")
run("nl")
run("nl /tmp/n.txt /tmp/n.txt")
print("same", vfs.read(t.fs, "/tmp/n.txt") == "a\nb")
run("nl /tmp/n.txt")
