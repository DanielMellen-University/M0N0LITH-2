# Left and Right stop at the ends of the line.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("ab")
key("left")
key("left")
key("left")
line()
key("right")
key("right")
key("right")
line()
