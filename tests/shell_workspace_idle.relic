# Idle snapshots keep the buffer without saving the Editor's vfs file.
use ../shell/wm
use std/files
use std/vfs

fun check(label, got, want)
    if got != want
        fail(label + ": " + str(got) + " != " + str(want))

fun desktop() = wm.new_desktop(640, 480, wm.default_apps())
fun pointer() = files.read("ws-idle/COMMITTED")

wm.workspace_open("ws-idle")
let d = desktop()
let ed = wm.launch(d, wm.editor)
wm.key(d, "a")
wm.tick(d, 0)
wm.tick(d, 2000)
check("unbound has no snapshot", files.exists("ws-idle/COMMITTED"), false)
wm.workspace_bind(d)
check("initial snapshot", wm.workspace_flush(), "")
check("initial generation", pointer(), "g1\n")
wm.tick(d, 0)
wm.tick(d, 5000)
check("bind clears pending", pointer(), "g1\n")
let disk = vfs.read(ed.state.fs, ed.state.path)
wm.handle(d, {type: "text", text: "bc"})
wm.tick(d, 0)
check("first tick", pointer(), "g1\n")
wm.tick(d, 1999)
check("not idle yet", pointer(), "g1\n")
wm.tick(d, 2000)
check("one idle generation", pointer(), "g2\n")
check("vfs unchanged", vfs.read(ed.state.fs, ed.state.path), disk)
check("still edited", ed.state.status, "edited")
wm.tick(d, 2001)
wm.tick(d, 9000)
check("one write per pause", pointer(), "g2\n")

wm.workspace_open("ws-idle")
let restored = desktop()
wm.workspace_bind(restored)
let buffer = restored.windows[0].state
check("unsaved text restored", buffer.text, disk + "abc")
check("restored disk baseline", buffer.disk, disk)
check("restored vfs unchanged", vfs.read(buffer.fs, buffer.path), disk)
wm.tick(restored, 0)
wm.tick(restored, 2000)
check("load has no pending input", pointer(), "g2\n")

wm.key(restored, "x")
wm.tick(restored, 10000)
wm.key(restored, "y")
# Ticks and input on a different desktop cannot write or start this pause.
wm.key(d, "q")
wm.tick(d, 50000)
wm.tick(d, 60000)
check("other desktop cannot write", pointer(), "g2\n")
wm.tick(restored, 11999)
wm.tick(restored, 13998)
check("new input restarts interval", pointer(), "g2\n")
wm.tick(restored, 13999)
check("second pause writes once", pointer(), "g3\n")
wm.tick(restored, 20000)
check("second pause stays clear", pointer(), "g3\n")

wm.key(restored, "ctrl+s")
check("Ctrl+S still saves vfs", vfs.read(buffer.fs, buffer.path), disk + "abcxy")
check("Ctrl+S generation", pointer(), "g4\n")
wm.tick(restored, 21000)
wm.tick(restored, 24000)
check("commit clears pending", pointer(), "g4\n")
wm.key(restored, "z")
wm.minimize(restored, restored.windows[0].id)
check("window event snapshot", pointer(), "g5\n")
wm.tick(restored, 25000)
wm.tick(restored, 28000)
check("snapshot clears pending", pointer(), "g5\n")

wm.workspace_open("")
wm.restore(restored, restored.windows[0].id)
wm.key(restored, "n")
wm.tick(restored, 0)
wm.tick(restored, 2000)
check("disabled workspace does not write", pointer(), "g5\n")
check("disabled workspace stays quiet", wm.workspace_notice(), "")
files.remove_tree("ws-idle")
print("idle boundaries, restart, repeated input, binding and explicit saves pass")
