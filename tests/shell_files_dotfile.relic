# A name that starts with a dot is listed. Nothing is hidden.
use ../shell/wm
use std/vfs
let d = wm.new_desktop(640, 480, wm.default_apps())
let f = wm.launch(d, wm.files_app)
let fs = f.state.fs
fun show() = wm.visible_lines(f)

vfs.write(fs, "/tmp/.hidden", "h")
f.state.path = "/tmp"
print(show())
