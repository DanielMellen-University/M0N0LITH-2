# mv of a missing file is refused, and the destination is not created.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("mv /tmp/missing.txt /tmp/out.txt")
print("out", not vfs.exists(t.fs, "/tmp/out.txt"))
run("mv welcome.txt /tmp/no/out.txt")
print("welcome", vfs.exists(t.fs, "/home/welcome.txt"))
print("no", not vfs.exists(t.fs, "/tmp/no"))
