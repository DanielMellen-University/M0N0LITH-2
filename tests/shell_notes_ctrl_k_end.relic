# Ctrl+K at the end of the line removes nothing and is not an undo step.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("abcdef")
key("ctrl+k")
line()
key("ctrl+z")
line()
print("text", n.text)
