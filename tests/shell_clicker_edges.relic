# Rapid clicks and keys count independently; a new window starts at zero.
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
let c = wm.launch(d, wm.clicker)
for i in 0..100
    wm.key(d, "space")
    wm.click(d, c.x + 5, c.y + wm.title_height + 5)
wm.handle(d, {type: "text", text: "  x "})
for k in ["return", "backspace", "up", "ctrl+s"]
    wm.key(d, k)
print("rapid", c.state.count, wm.visible_lines(c))
wm.minimize(d, c.id)
wm.key(d, "space")
print("minimized", c.state.count)
wm.restore(d, c.id)
wm.key(d, "space")
print("restored", wm.visible_lines(c))
wm.close(d, c.id)
let fresh = wm.launch(d, wm.clicker)
print("reopened", c.state.count, wm.visible_lines(fresh))
# Return counts like Space
wm.key(d, "return")
wm.key(d, "return")
print("return", fresh.state.count)
# Backspace and - take one off, stopping at 0
wm.key(d, "backspace")
print("back", fresh.state.count)
wm.handle(d, {type: "text", text: "---"})
print("floor", fresh.state.count, wm.visible_lines(fresh))
# Ctrl+C copies the number; Ctrl+V in Notes pastes it
wm.key(d, "space")
wm.key(d, "space")
wm.key(d, "ctrl+c")
let n = wm.launch(d, wm.notes)
wm.key(d, "ctrl+v")
print("copied", n.state.text)
# Delete sets the count back to 0
wm.close(d, n.id)
wm.key(d, "space")
wm.key(d, "delete")
print("reset", fresh.state.count)
# + and = add one, as - takes one off
wm.handle(d, {type: "text", text: "++="})
print("plus", fresh.state.count)
# Ctrl+Z brings back the count Delete cleared, once, and not after counting on
wm.key(d, "delete")
wm.key(d, "ctrl+z")
print("undone", fresh.state.count)
wm.key(d, "ctrl+z")
print("once", fresh.state.count)
wm.key(d, "delete")
wm.key(d, "space")
wm.key(d, "backspace")
wm.key(d, "ctrl+z")
print("counted on", fresh.state.count)
