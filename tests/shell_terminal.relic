# Terminal commands on the shared VFS: extra spaces, folders, redirects and errors
use ../shell/wm
let t = wm.terminal.init()
fun run(line)
    let before = len(t.buf)
    for ch in line
        if ch == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, ch)
    wm.terminal.on_key(t, "return")
    print("> " + line)
    for i in before + 1..len(t.buf)
        print("  " + t.buf[i])
for line in ["pwd", "ls", "cat  welcome.txt", "ls   /home", "cd  ..", "pwd", "cd  home", "pwd", "echo  a    b", "echo hi > a.txt", "echo  there  >>  a.txt", "cat a.txt", "mkdir  d", "mv  a.txt  d", "ls", "ls d", "cd d", "pwd", "rm  a.txt", "cd ..", "rm d", "ls", "cd welcome.txt", "cat d", "cat", "touch", "mv x", "nope"]
    run(line)
# wc: lines (newlines), words and characters
for line in ["echo one two > w.txt", "echo  three >> w.txt", "wc w.txt", "wc /home/w.txt", "touch e.txt", "wc e.txt", "wc nothing.txt", "wc /home", "wc", "wc a b", "rm w.txt", "rm e.txt"]
    run(line)
# cp: a file to a new name or into a folder; not a folder, not over a file
for line in ["echo hi > c.txt", "mkdir cd", "cp c.txt c2.txt", "cat c2.txt", "cp c.txt cd", "ls cd", "cp c.txt c2.txt", "cp cd x", "cp nope.txt y", "cp c.txt", "cp c.txt nope/y.txt", "rm cd/c.txt", "rm cd", "rm c.txt", "rm c2.txt"]
    run(line)
