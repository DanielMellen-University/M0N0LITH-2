# cut selects 1-based fields, preserving empty and absent columns.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    for l in t.buf
        print(l)
vfs.write(t.fs, "/home/csv file", "a,b,c\n1,,3\nx,y\nlast,\n")
run("cut -d , -f 1,3 \"csv file\"")
run("cut -d , -f 2-4 \"csv file\"")
run("cut -d , -f 3-1 \"csv file\"")
run("cut -d xx -f 1 csv")
run("cut -d , -f 0 csv")
run("cut -d , -f 1,,2 csv")
run("cut -d , -g 1 csv")
run("cut -x , -f 1 csv")
run("cut -d , -f 1 missing")
run("cut -d , -f 1 /home")
run("cut -d , -f 1")
