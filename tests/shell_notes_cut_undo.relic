# Ctrl+X clears the line, and Ctrl+Z brings it back with the cursor at the end.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("hello")
key("ctrl+x")
line()
key("ctrl+z")
line()
key("ctrl+z")
line()
