# Terminal cursor: Left, Right, Home and End move it in the line; typing,
# Backspace, Tab and Ctrl+V work at it; Return runs the whole line; Up,
# Down and Ctrl+C put it back at the end.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
t.rows = 3
fun keys(list)
    for k in list
        wm.terminal.on_key(t, k)
fun typed(line)
    for ch in line
        if ch == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, ch)
fun prompt()
    let lines = wm.terminal.lines(t)
    return lines[len(lines) - 1]
typed("eco hi")
keys(["left", "left", "left", "left"])
print(prompt())
typed("h")
print(prompt())
keys(["end"])
print(prompt())
keys(["home"])
print(prompt())
keys(["left"])
print("left at the start", prompt())
keys(["end", "right"])
print("right at the end", prompt())
keys(["home", "right", "right", "right", "right", "backspace"])
print("backspace at the cursor", prompt())
keys(["home", "backspace"])
print("backspace at the start", prompt())
keys(["right", "right", "right"])
typed("o")
keys(["end", "space"])
typed("there")
keys(["return"])
print(t.buf[len(t.buf) - 1], prompt())
# Tab completes the word before the cursor and keeps the rest
vfs.write(t.fs, "/home/notes.txt", "x")
typed("cat no > /tmp/x")
for i in 0..9
    keys(["left"])
print(prompt())
keys(["tab"])
print(prompt())
# Up brings back a command with the cursor at its end; Ctrl+C gives up the whole line
keys(["ctrl+u", "end", "ctrl+u", "up"])
print(prompt())
keys(["home", "ctrl+c"])
print(t.buf[len(t.buf) - 1], prompt())
# Ctrl+V pastes at the cursor
let n = wm.notes.init()
n.text = "PASTE"
wm.notes.on_key(n, "ctrl+c")
typed("ab")
keys(["left", "ctrl+v"])
print(prompt())
# Ctrl+Left and Ctrl+Right jump by words; Delete takes the character after the cursor
keys(["ctrl+u", "end", "ctrl+u"])
typed("cat one/two three")
keys(["ctrl+left"])
print(prompt())
keys(["ctrl+left", "ctrl+left"])
print(prompt())
keys(["ctrl+left"])
print("ctrl+left at the start", prompt())
keys(["ctrl+right", "ctrl+right"])
print(prompt())
keys(["delete", "delete"])
print("delete twice", prompt())
keys(["end", "delete"])
print("delete at the end", prompt())
# Ctrl+Delete removes to the end of the next word
keys(["ctrl+u", "end", "ctrl+u"])
typed("rm old/file.txt now")
keys(["home", "ctrl+right", "ctrl+delete"])
print(prompt())
keys(["ctrl+delete"])
print(prompt())
keys(["ctrl+delete", "ctrl+delete"])
print("to the end", prompt())
# a click on the line being typed puts the cursor there; on the output it does nothing
let d = wm.new_desktop(640, 480, wm.default_apps())
let w = wm.launch(d, wm.terminal)
for ch in "echo"
    wm.key(d, ch)
wm.key(d, "return")
for ch in "cat abc"
    wm.key(d, ch)
fun click_at(r, col)
    let lines = wm.visible_lines(w)
    wm.click(d, w.x + wm.text_left + col * wm.char_width + 3, w.y + wm.title_height + wm.text_top + r * wm.line_height + 5)
    let shown = wm.visible_lines(w)
    print("click row {r} col {col}:", shown[len(shown) - 1])
let rows = len(wm.visible_lines(w))
click_at(rows - 1, 8)
click_at(rows - 1, 12)
click_at(rows - 1, 30)
click_at(rows - 1, 0)
click_at(rows - 2, 3)
wm.key(d, "X")
print(w.state.input)
# a line that wraps: a click on its second row
wm.key(d, "end")
for ch in " 12345678901234567890123456789"
    if ch == " "
        wm.key(d, "space")
    else
        wm.key(d, ch)
let rows2 = len(wm.visible_lines(w))
click_at(rows2 - 1, 2)
print(w.state.left, w.state.input)
# Ctrl+A and Ctrl+E go to the start and end, Ctrl+K removes the rest of the line
wm.key(d, "ctrl+u")
wm.key(d, "end")
wm.key(d, "ctrl+u")
for ch in "ls /tmp"
    if ch == " "
        wm.key(d, "space")
    else
        wm.key(d, ch)
wm.key(d, "ctrl+a")
print("ctrl+a", w.state.left)
wm.key(d, "ctrl+e")
print("ctrl+e", w.state.left)
wm.key(d, "ctrl+left")
wm.key(d, "ctrl+k")
print("ctrl+k", w.state.input, w.state.left)
