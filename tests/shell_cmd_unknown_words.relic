# An unknown command names only its first word, and the rest is not a path error.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("foo bar baz")
run("Foo")
print("no foo", not vfs.exists(t.fs, "/home/foo"))
run("!!")
