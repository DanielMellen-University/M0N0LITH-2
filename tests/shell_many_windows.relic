# many windows: new ones cascade and wrap, so every one opens on the desktop
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
let apps = wm.default_apps()
let off = 0
let xs = []
for i in 0..45
    let w = wm.launch(d, apps[i % len(apps)])
    if w.x < 0 or w.y < 0 or w.x + 40 > d.width or w.y + wm.title_height > wm.bar_top(d)
        off = off + 1
    if i < 12
        append(xs, [w.x, w.y])
print(len(d.windows), "windows,", off, "off the desktop")
print(xs)
# closing windows leaves room: the next one cascades from the count that is left
wm.close(d, d.windows[0].id)
wm.close(d, d.windows[0].id)
let w = wm.launch(d, apps[0])
print(w.x, w.y)

# taskbar tabs share the bar: each one stays on screen and clicking it works
let d2 = wm.new_desktop(640, 480, wm.default_apps())
for n in [1, 6, 7, 12, 20]
    while len(d2.windows) < n
        wm.launch(d2, apps[len(d2.windows) % len(apps)])
    let last = wm.tab_box(d2, n - 1)
    let hit = 0
    let tl = wm.tabs(d2)
    for i in 0..n
        let b = wm.tab_box(d2, i)
        if wm.click(d2, b[0] + b[2] / 2, b[1] + 3) != "bar"
            hit = hit + 1
    print(n, "windows: tab width", wm.tab_width_for(d2), "last tab ends at", last[0] + last[2], "of", d2.width, "- label", wm.tab_label(d2, tl[0]), "- clicks that hit a tab:", hit)
