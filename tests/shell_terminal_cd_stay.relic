# cd of a file leaves the folder unchanged.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    return slice(t.buf, 1, len(t.buf))

print(run("cd /home/welcome.txt"))
print(run("pwd"))
