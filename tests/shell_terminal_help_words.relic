# help takes no words either, but unlike clear, apps, date, pwd and history
# it does not reject them: extra words are ignored and the full help prints.
use ../shell/wm
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("help extra")
run("help clear history")
run("help")
