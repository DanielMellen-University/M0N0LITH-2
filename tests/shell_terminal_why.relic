# Errors that make a file or folder say which part of the path is wrong: a
# folder that is missing, a part that is a file, or a target that is a folder.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("write /tmp/f.txt x")
run("mkdir /tmp/f.txt/a/b")
run("mkdir /tmp/new/deep/er")
run("touch /tmp/gone/a/b.txt")
run("touch /tmp/f.txt/a")
run("write /tmp/gone/x hi")
run("write /tmp hi")
run("echo hi >> /tmp/f.txt/x")
run("mv /tmp/f.txt /tmp/gone/f.txt")
run("mv /tmp/f.txt /tmp/f.txt/g")
run("mv /tmp/new /tmp/f.txt/deep")
run("mv /tmp/f.txt /tmp/new/deep/er")
run("ls /tmp/new/deep/er")
print("moved, nothing made:", vfs.exists(t.fs, "/tmp/new/deep/er/f.txt"), not vfs.exists(t.fs, "/tmp/gone"))
