# A file written by another app shows up on the next draw, and the selection stays on the name it had.
use ../shell/wm
use std/vfs
let d = wm.new_desktop(640, 480, wm.default_apps())
let f = wm.launch(d, wm.files_app)
let fs = f.state.fs
fun show() = wm.visible_lines(f)

vfs.write(fs, "/tmp/keep.txt", "k")
f.state.path = "/tmp"
show()
for i in 0..len(f.state.names)
    if f.state.names[i] == "keep.txt"
        f.state.sel = i
vfs.write(fs, "/tmp/added.txt", "a")
print(show())
print("sel", f.state.names[f.state.sel])
