# A # inside a string is not a comment. Ctrl+/ comments the whole line.
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
let i = wm.launch(d, wm.ide)
let s = i.state
fun pos() = len(s.text) - s.back

s.text = "print(\"# x\")"
s.back = 0
wm.key(d, "ctrl+/")
print([s.text])
wm.key(d, "ctrl+r")
print(s.status, s.out)
