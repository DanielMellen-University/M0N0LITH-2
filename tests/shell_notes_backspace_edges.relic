# Backspace on an empty line, and at the start of a line, removes nothing.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
key("backspace")
line()
type("ab")
key("home")
key("backspace")
line()
key("left")
line()
