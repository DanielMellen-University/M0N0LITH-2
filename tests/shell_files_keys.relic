# Files: Home and End go to the first and last row, and a letter or digit to
# the next name that starts with it (any case, going round, never ".."), and
# Page Up and Page Down a window of rows.
use ../shell/wm
use std/vfs
use std/strings
let d = wm.new_desktop(640, 480, wm.default_apps())
let f = wm.launch(d, wm.files_app)
for name in ["apple.txt", "Avocado.txt", "banana.txt", "cherry.txt", "2026.txt"]
    vfs.write(f.state.fs, "/tmp/" + name, "x")
vfs.make_dir(f.state.fs, "/tmp/art")
f.state.path = "/tmp"
fun sel()
    return f.state.sel
print(wm.visible_lines(f))
wm.key(d, "end")
print(sel())
wm.key(d, "home")
print(sel())
let seen = []
for k in ["a", "a", "a", "a", "B", "c", "c", "2", "z", ".", "/"]
    wm.key(d, k)
    append(seen, sel())
print(seen)
# in the root there is no "..": Home is the first name
f.state.path = "/"
f.state.sel = 0
wm.key(d, "end")
wm.key(d, "home")
wm.key(d, "t")
print(wm.visible_lines(f), sel())
# an empty folder: nothing to go to
vfs.make_dir(f.state.fs, "/tmp/empty")
f.state.path = "/tmp/empty"
f.state.sel = 0
wm.key(d, "end")
wm.key(d, "x")
print(wm.visible_lines(f), sel())
# Page Up and Page Down: a window of rows (the rows less the title, less one)
vfs.make_dir(f.state.fs, "/tmp/many")
for i in 0..40
    vfs.write(f.state.fs, "/tmp/many/f" + strings.pad_left(str(i), 2, "0"), "x")
f.state.path = "/tmp/many"
f.state.sel = 0
wm.visible_lines(f)
let moves = [f.state.rows]
for k in ["pagedown", "pagedown", "pagedown", "pagedown", "pageup", "pageup", "pageup", "pageup", "end", "pageup"]
    wm.key(d, k)
    append(moves, sel())
print(moves)
print(wm.key_of_event({type: "key_down", key: "pagedown", ctrl: false}), wm.key_of_event({type: "key_down", key: "pageup", ctrl: false}))
# Ctrl+Home and Ctrl+End work as Home and End
wm.key(d, "ctrl+end")
let last = sel()
wm.key(d, "ctrl+home")
print(last, sel())
# Left goes up a folder, Right goes into the selected folder only
vfs.make_dir(f.state.fs, "/tmp/many/sub")
wm.visible_lines(f)
fun pick(name)
    for i in 0..len(f.state.names)
        if f.state.names[i] == name
            f.state.sel = i
pick("f00")
wm.key(d, "right")
print("right on a file", f.state.path)
pick("sub")
wm.key(d, "right")
print("right on sub", f.state.path)
wm.visible_lines(f)
f.state.sel = 0
wm.key(d, "right")
print("right on ..", f.state.path, f.state.names[0])
wm.key(d, "left")
print("left", f.state.path, f.state.names[f.state.sel])
