# Ctrl+Left at the start and Ctrl+Right at the end stay put.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("ab cd")
key("home")
key("ctrl+left")
line()
key("end")
key("ctrl+right")
line()
key("ctrl+delete")
line()
