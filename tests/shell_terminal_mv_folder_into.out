["/home> mkdir box"]
["/home> mkdir item"]
["/home> echo in > item/f.txt"]
["/home> mv item box"]
["/home> ls box", "item/"]
["/home> ls box/item", "f.txt"]
["/home> echo one > a.txt"]
["/home> echo two > box/a.txt"]
["/home> mv a.txt box", "mv: already there: /home/box/a.txt"]
["/home> cat box/a.txt", "two"]
["/home> cat a.txt", "one"]
["/home> mkdir dup"]
["/home> mkdir box/dup"]
["/home> mv dup box", "mv: already there: /home/box/dup"]
["/home> ls box", "a.txt  dup/  item/"]
kept true
