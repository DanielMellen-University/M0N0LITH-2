# Editor Ctrl+H replaces non-overlapping matches in one pass: "aa" in "aaaa"
# counts 2, not 3, and a replacement that contains the text it replaces does
# not get replaced again. Matches at the very start and end count too.
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
let e = wm.launch(d, wm.editor)
fun keys(list)
    for k in list
        wm.key(d, k)
fun typed(t)
    for ch in t
        if ch == " "
            wm.key(d, "space")
        else
            wm.key(d, ch)
fun replace(what, with)
    keys(["ctrl+h"])
    typed(what)
    keys(["return"])
    typed(with)
    keys(["return"])
    return [e.state.text, e.state.status, len(e.state.text) - e.state.back]
e.state.text = "aaaa"
e.state.back = 0
print(replace("aa", "b"))
e.state.text = "a b a"
e.state.back = 0
print(replace("a", "aa"))
e.state.text = "catcat"
e.state.back = 0
print(replace("cat", "dog"))
e.state.text = "xxcatyy"
e.state.back = 0
print(replace("cat", ""))
