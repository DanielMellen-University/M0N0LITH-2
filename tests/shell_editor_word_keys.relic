# Editor keys with Ctrl beyond the word moves: Ctrl+Home and Ctrl+End go to
# the start and end of the file, and drop any selection; Ctrl+Backspace and
# Ctrl+Delete remove a word (as far as Ctrl+Left and Ctrl+Right go). Home
# stops after the leading spaces first.
use ../shell/wm
use std/strings
use std/math
let d = wm.new_desktop(640, 480, wm.default_apps())
let e = wm.launch(d, wm.editor)
let s = e.state
fun keys(ks)
    for k in ks
        e.app.on_key(s, k)
    return [s.text, len(s.text) - s.back]
s.text = "one two\nthree four\nfive"
s.back = 12
print(keys(["ctrl+home"]), keys(["ctrl+end"]), keys(["ctrl+home", "x"]))
s.back = 3
s.mark = 0
print(keys(["ctrl+end"]), s.mark)
# the desktop names them so
print(wm.key_of_event({type: "key_down", key: "home", ctrl: true}), wm.key_of_event({type: "key_down", key: "end", ctrl: true}))
s.text = "let total = a + b"
s.back = 0
s.mark = none
print(keys(["ctrl+backspace"]), keys(["ctrl+backspace", "ctrl+backspace"]), keys(["ctrl+home", "ctrl+delete"]), keys(["ctrl+delete"]))
print(keys(["ctrl+end", "ctrl+delete"]), keys(["ctrl+home", "ctrl+backspace"]), len(s.undo))
keys(["ctrl+z"])
print(keys([]))
s.text = "abc def"
s.back = 5
s.mark = 1
print(keys(["ctrl+backspace"]), keys(["ctrl+backspace"]))
# Home goes past the leading spaces first, then to the very start, and back
s.text = "fun f()\n        body\nx"
s.back = 3
s.mark = none
print(keys(["home"]), keys(["home"]), keys(["home"]), keys(["right", "right", "home"]))
s.back = 0
print(keys(["home"]), keys(["shift+home"]), s.mark)
# Page Down and Page Up: the lines that show under the title, less one; with
# Shift they select
let many = ""
for i in 0..30
    many = many + "line " + str(i) + "\n"
s.text = many
s.back = len(many)
s.mark = none
wm.visible_lines(e)
fun line_no() = len(strings.split(slice(s.text, 0, len(s.text) - s.back), "\n")) - 1
let at = [s.rows]
for k in ["pagedown", "pagedown", "pageup", "pagedown", "pagedown", "pagedown", "pagedown", "pagedown", "pageup"]
    e.app.on_key(s, k)
    append(at, line_no())
print(at)
e.app.on_key(s, "ctrl+home")
e.app.on_key(s, "shift+pagedown")
print(line_no(), s.mark == len(s.text))
print(wm.key_of_event({type: "key_down", key: "pagedown", ctrl: false, shift: true}))
# Ctrl+L selects the cursor's line with its newline; again adds the next one
s.text = "one\ntwo\nthree"
s.back = 6
s.mark = none
e.app.on_key(s, "ctrl+l")
fun picked() = slice(s.text, len(s.text) - s.mark, len(s.text) - s.back)
print([picked()])
e.app.on_key(s, "ctrl+l")
print([picked()])
e.app.on_key(s, "ctrl+l")
print([picked()])
e.app.on_key(s, "ctrl+x")
print([s.text])
# Ctrl+D copies the line under it, the cursor going with it; one undo
s.text = "one\ntwo\nthree"
s.back = 6
s.mark = none
e.app.on_key(s, "ctrl+d")
print([s.text], s.back, [slice(s.text, len(s.text) - s.back, len(s.text) - s.back + 2)])
e.app.on_key(s, "ctrl+z")
print([s.text])
# with a selection over two lines, both are copied
s.text = "a\nbc\nd"
s.back = 4
s.mark = 6
e.app.on_key(s, "ctrl+d")
print([s.text])
# Ctrl+K removes the line with its newline, the last line the one before
s.text = "one\ntwo\nthree"
s.back = 7
s.mark = none
e.app.on_key(s, "ctrl+k")
print([s.text], s.back)
e.app.on_key(s, "ctrl+k")
print([s.text], s.back)
e.app.on_key(s, "ctrl+k")
print([s.text], s.back)
e.app.on_key(s, "ctrl+k")
print([s.text], s.back)
e.app.on_key(s, "ctrl+z")
e.app.on_key(s, "ctrl+z")
print([s.text])
# Ctrl+Shift with Left, Right, Home or End selects as far as Ctrl alone moves
print(wm.key_of_event({type: "key_down", key: "left", ctrl: true, shift: true}), wm.key_of_event({type: "key_down", key: "end", ctrl: true, shift: true}), wm.key_of_event({type: "key_down", key: "s", ctrl: true, shift: true}))
fun chosen()
    let a = len(s.text) - s.mark
    let b = len(s.text) - s.back
    return slice(s.text, math.min(a, b), math.max(a, b))
s.text = "alpha beta gamma"
s.back = 6
s.mark = none
e.app.on_key(s, "ctrl+shift+left")
print([chosen()])
e.app.on_key(s, "ctrl+shift+right")
e.app.on_key(s, "ctrl+shift+right")
print([chosen()])
e.app.on_key(s, "ctrl+shift+home")
print([chosen()])
e.app.on_key(s, "ctrl+shift+end")
print([chosen()])
# Ctrl+J joins the next line on with one space, its indent dropped
s.text = "if x\n    go()\n\nend"
s.back = len(s.text)
s.mark = none
e.app.on_key(s, "ctrl+j")
print([s.text], s.back)
e.app.on_key(s, "ctrl+j")
print([s.text])
e.app.on_key(s, "ctrl+j")
e.app.on_key(s, "ctrl+j")
print([s.text])
e.app.on_key(s, "ctrl+z")
print([s.text])
# Ctrl+] indents the line from anywhere in it, Ctrl+[ takes it back off
s.text = "a\nbc\nd"
s.back = 3
s.mark = none
e.app.on_key(s, "ctrl+]")
e.app.on_key(s, "ctrl+]")
print([s.text], s.back)
e.app.on_key(s, "ctrl+[")
print([s.text], s.back)
# Ctrl+Up and Ctrl+Down move the cursor's line, the cursor with it
s.text = "one\ntwo\nthree"
s.back = 7
s.mark = none
e.app.on_key(s, "ctrl+up")
print([s.text], s.back)
e.app.on_key(s, "ctrl+up")
print([s.text], s.back)
e.app.on_key(s, "ctrl+down")
e.app.on_key(s, "ctrl+down")
print([s.text], s.back)
e.app.on_key(s, "ctrl+down")
print([s.text], s.back)
e.app.on_key(s, "ctrl+z")
print([s.text])
