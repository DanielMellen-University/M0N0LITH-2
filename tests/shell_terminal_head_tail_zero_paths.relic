# A zero count still checks the path, but prints no lines from a file.
use ../shell/wm
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
for cmd in ["head", "tail"]
    for path in ["/tmp/nope.txt", "/tmp/no-folder/nope.txt", "welcome.txt/x", "welcome.txt/", "/tmp", "welcome.txt"]
        run(cmd + " " + path + " 0")
