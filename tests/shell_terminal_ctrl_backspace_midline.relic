# Terminal Ctrl+Backspace in the middle of the line: it takes off the word
# before the cursor and keeps what follows it; trailing spaces, and
# punctuation after a word, go with the word. At the end of the line it is
# the same as in shell_terminal_keys.
use ../shell/wm
let t = wm.terminal.init()
fun typed(line)
    for ch in line
        if ch == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, ch)
fun keys(list)
    for k in list
        wm.terminal.on_key(t, k)
fun prompt()
    let lines = wm.terminal.lines(t)
    return lines[len(lines) - 1]
typed("cat one/two three")
keys(["left", "left", "left", "left", "left", "left", "ctrl+backspace"])
print(prompt())
print([t.input])
keys(["ctrl+u", "end", "ctrl+u"])
typed("rm file  ")
keys(["ctrl+backspace"])
print([t.input])
keys(["ctrl+backspace"])
print([t.input])
keys(["ctrl+u", "end", "ctrl+u"])
typed("echo a, ")
keys(["ctrl+backspace"])
print([t.input])
