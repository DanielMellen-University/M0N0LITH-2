# Esc in the Editor and the IDE drops a selection (and the desktop stays);
# with none it is not taken, so the desktop quits as before. In the IDE a run
# waiting for input is stopped first.
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
let e = wm.launch(d, wm.editor)
e.state.text = "hello"
e.state.back = 0
wm.key(d, "shift+left")
wm.key(d, "shift+left")
print(e.state.mark, wm.dismiss(d), e.state.mark, wm.dismiss(d), [e.state.text])
let i = wm.launch(d, wm.ide)
i.state.text = "use std/os\nprint(os.read_line())\n"
wm.key(d, "ctrl+r")
wm.key(d, "ctrl+a")
print(i.state.run != none, wm.dismiss(d), i.state.run, i.state.status)
wm.key(d, "ctrl+a")
print(wm.dismiss(d), i.state.mark, wm.dismiss(d))
