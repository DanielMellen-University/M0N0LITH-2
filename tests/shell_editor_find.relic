# Editor find: Ctrl+F, type the text, Return selects the next place it is
# after the cursor and goes round; Backspace edits it; Esc or another key
# ends finding; the title shows it; case counts.
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
let e = wm.launch(d, wm.editor)
e.state.text = "one two one\nTwo one\nthree"
e.state.back = len(e.state.text)
fun keys(list)
    for k in list
        if k == " "
            wm.key(d, "space")
        else
            wm.key(d, k)
fun typed(t)
    for ch in t
        keys([ch])
fun sel()
    let s = e.state
    let a = len(s.text) - s.back
    if s.mark == none
        return [a]
    return [len(s.text) - s.mark, a]
fun title() = wm.visible_lines(e)[0]
keys(["ctrl+f"])
print(title())
typed("one")
print(title())
keys(["return"])
print("first", sel(), title())
keys(["return"])
print("second", sel())
keys(["return"])
print("third", sel())
keys(["return"])
print("round to the first", sel())
keys(["backspace", "backspace", "backspace"])
typed("Two")
keys(["return"])
print("case counts", sel())
keys(["backspace", "backspace", "backspace"])
typed("nope")
keys(["return"])
print("not found", sel(), title())
# Esc ends finding and keeps the selection; the title is as before
wm.dismiss(d)
print("esc", title(), sel())
# another key ends it and does what it does
keys(["ctrl+f"])
typed("three")
keys(["return", "right"])
print("right after", title(), sel())
# typing after finding is plain typing again
keys(["X"])
print(e.state.text)
# the IDE finds too
let i = wm.launch(d, wm.ide)
i.state.text = "print(1)\nprint(22)"
i.state.back = len(i.state.text)
keys(["ctrl+f", "2", "2", "return"])
print("ide", len(i.state.text) - i.state.mark, len(i.state.text) - i.state.back)
wm.dismiss(d)
print(wm.visible_lines(i)[0])
# F3 finds the last text again, Shift+F3 the place before; nothing found says so
let e2 = wm.launch(d, wm.editor)
e2.state.text = "ab ab ab"
e2.state.back = len(e2.state.text)
keys(["f3"])
print("f3 before any find", e2.state.mark, e2.state.status)
keys(["ctrl+f", "a", "b", "return"])
wm.dismiss(d)
fun sel2()
    let s = e2.state
    return [len(s.text) - s.mark, len(s.text) - s.back]
print("found", sel2())
keys(["f3"])
print("f3", sel2())
keys(["f3"])
print("f3", sel2())
keys(["f3"])
print("f3 round", sel2())
keys(["shift+f3"])
print("shift+f3 round back", sel2())
keys(["shift+f3"])
print("shift+f3", sel2())
e2.state.text = "zz"
e2.state.back = 0
e2.state.mark = none
keys(["f3"])
print(e2.state.status)
print(wm.key_of_event({type: "key_down", key: "f3", shift: true, ctrl: false}), wm.key_of_event({type: "key_down", key: "f3", shift: false, ctrl: false}))
# Ctrl+F with a selection on one line starts with it; across lines it starts empty
e2.state.text = "red green red\nblue"
e2.state.back = len(e2.state.text)
e2.state.mark = len(e2.state.text)
keys(["shift+right", "shift+right", "shift+right"])
keys(["ctrl+f"])
print(wm.visible_lines(e2)[0])
keys(["return"])
print("next red", sel2())
wm.dismiss(d)
keys(["ctrl+a", "ctrl+f"])
print(wm.visible_lines(e2)[0])
wm.dismiss(d)
# typing replaces the text it started with; Backspace edits it
e2.state.back = len(e2.state.text)
e2.state.mark = len(e2.state.text)
keys(["shift+right", "shift+right", "shift+right", "ctrl+f", "b", "l"])
print(wm.visible_lines(e2)[0])
wm.dismiss(d)
keys(["ctrl+f", "backspace", "e"])
print(wm.visible_lines(e2)[0])
wm.dismiss(d)
# Ctrl+H replaces every place a text is, in one undo step, and says how many
let e3 = wm.launch(d, wm.editor)
e3.state.text = "cat sat on the cat mat"
e3.state.back = 0
keys(["ctrl+h"])
print(wm.visible_lines(e3)[0])
typed("cat")
print(wm.visible_lines(e3)[0])
keys(["return"])
print(wm.visible_lines(e3)[0])
typed("dog")
keys(["return"])
print(e3.state.text, "|", e3.state.status)
keys(["ctrl+z"])
print("undone", e3.state.text)
keys(["ctrl+h"])
typed("zebra")
keys(["return", "return"])
print(e3.state.text, "|", e3.state.status)
# replacing with nothing removes them; Esc gives up halfway
keys(["ctrl+h", "a", "return", "return"])
print(e3.state.text, "|", e3.state.status)
keys(["ctrl+h", "t", "return"])
wm.dismiss(d)
print(e3.state.text, "|", wm.visible_lines(e3)[0])
# an empty text to replace waits for one
keys(["ctrl+h", "return"])
print(wm.visible_lines(e3)[0])
wm.dismiss(d)
