# cp of / is a folder into itself wherever it goes, so it is refused at once
# and nothing is made, rather than copying until the calls run out.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("cp / /tmp/x")
run("cp / /tmp")
run("cp .. /home/up")
run("ls /tmp")
print("home", vfs.list(t.fs, "/home"))
