# sort prints the ordered lines and leaves the file in its old order.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
vfs.write(t.fs, "/tmp/s.txt", "pear\napple\nfig")
run("sort /tmp/s.txt")
run("cat /tmp/s.txt")
print("same", vfs.read(t.fs, "/tmp/s.txt") == "pear\napple\nfig")
