# Notes and Clicker keep separate state as focus, minimization and close change.
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
let a = wm.launch(d, wm.notes)
wm.handle(d, {type: "text", text: "Hi é!"})
let b = wm.launch(d, wm.notes)
wm.handle(d, {type: "text", text: "Other"})
let c = wm.launch(d, wm.clicker)
wm.handle(d, {type: "text", text: " x  "})
print("initial", wm.visible_lines(a), wm.visible_lines(b), wm.visible_lines(c))
wm.minimize(d, c.id)
wm.key(d, "backspace")
print("minimized", wm.focused(d).id == b.id, wm.visible_lines(b), c.state.count)
wm.restore(d, a.id)
wm.key(d, "backspace")
wm.key(d, "return")
print("restored", wm.visible_lines(a), wm.visible_lines(b))
wm.close(d, a.id)
wm.key(d, "space")
print("closed", wm.focused(d).id == b.id, wm.visible_lines(b))
wm.restore(d, c.id)
let box = wm.resize_box(c)
print("resize", wm.click(d, box[0], box[1]), c.state.count)
wm.release(d)
let close = wm.close_box(c)
print("close", wm.click(d, close[0], close[1]), c.state.count, wm.focused(d).id == b.id)
