# A hyphen splits a word, the way it does in the Editor.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("foo-bar")
key("ctrl+left")
line()
key("ctrl+left")
line()
key("home")
key("ctrl+right")
line()
