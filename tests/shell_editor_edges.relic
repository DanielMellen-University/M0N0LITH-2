# Edits happen at the end; empty backspace and ignored movement keys are no-ops.
use ../shell/wm
use std/vfs
let d = wm.new_desktop(640, 480, wm.default_apps())
let f = wm.launch(d, wm.files_app)
vfs.make_dir(f.state.fs, "/tmp/ed")
vfs.write(f.state.fs, "/tmp/ed/empty", "")
f.state.path = "/tmp/ed"
wm.key(d, "down")
wm.key(d, "return")
let e = wm.launch(d, wm.editor)
print(wm.visible_lines(e))
wm.key(d, "backspace")
wm.key(d, "left")
print(e.state.status, e.state.text == "")
wm.key(d, "return")
wm.key(d, "x")
wm.key(d, "up")
wm.key(d, "backspace")
wm.key(d, "backspace")
print(wm.visible_lines(e))
wm.key(d, "ctrl+s")
print(e.state.status, vfs.read(e.state.fs, e.state.path) == "")
wm.key(d, "a")
vfs.remove(e.state.fs, "/tmp/ed/empty")
vfs.remove(e.state.fs, "/tmp/ed")
wm.key(d, "ctrl+s")
print(wm.visible_lines(e))
print("buffer retained", e.state.text)
vfs.make_dir(e.state.fs, "/tmp/ed")
wm.key(d, "ctrl+s")
print(e.state.status, vfs.read(e.state.fs, e.state.path))
