# Ctrl+Delete removes the next word, and at the end it removes nothing.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("foo-bar baz")
key("home")
key("ctrl+delete")
line()
key("end")
key("ctrl+delete")
line()
key("ctrl+z")
line()
