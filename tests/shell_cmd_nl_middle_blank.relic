# nl counts a blank line in the middle, and the numbers keep going.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
vfs.write(t.fs, "/tmp/n.txt", "a\n\nb\n")
run("nl /tmp/n.txt")
print("file", vfs.read(t.fs, "/tmp/n.txt") == "a\n\nb\n")
