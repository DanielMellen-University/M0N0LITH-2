# Terminal quotes: a part in double or single quotes is one word with its
# spaces, the quotes dropped; a quote left open is an error; a quoted > is
# text for echo, not a redirect.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("touch \"my notes.txt\"")
print("made", vfs.exists(t.fs, "/home/my notes.txt"))
run("echo first line > 'my notes.txt'")
run("cat \"my notes.txt\"")
run("echo more >> 'my notes.txt'")
run("cat 'my notes.txt'")
run("wc \"my notes.txt\"")
run("mkdir \"a folder\"")
run("mv 'my notes.txt' \"a folder\"")
run("ls \"a folder\"")
run("cd 'a folder'")
run("pwd")
run("cat \"my notes.txt\" missing")
run("cp \"my notes.txt\" 'copy of it'")
run("ls")
run("rm 'copy of it'")
run("cd ..")
# the other quote inside is plain text
run("echo \"it's here\" 'say \"hi\"'")
# spaces inside quotes are kept as they are
run("echo \"a   b\"")
# an empty quoted word is a word
run("echo '' x")
run("mkdir \"\"")
# a quote opens only at the start of a word: in a word it is a letter
run("echo don't stop, it's \"fine\"")
run("touch it's")
print("made it's", vfs.exists(t.fs, "/home/it's"))
run("rm it's")
# a quote left open runs nothing
run("touch \"half open")
print("not made", not vfs.exists(t.fs, "/home/\"half open"), not vfs.exists(t.fs, "/home/half open"))
run("echo 'x")
# a quoted > is text
run("echo a \">\" b")
run("echo a '>'")
run("echo a \">>\" '/tmp/x'")
print("no /tmp/x", not vfs.exists(t.fs, "/tmp/x"))
run("echo a > \"/tmp/with space\"")
run("cat '/tmp/with space'")
# quoted words still count as words for usage
run("rm \"a\" \"b\"")
# ls and find show a name with a space in quotes (single ones when it has a ")
run("touch plain.txt")
run("mkdir \"old stuff\"")
run("touch 'old stuff/say \"hi\".txt'")
run("ls")
run("ls \"old stuff\"")
run("ls 'a folder/my notes.txt'")
run("find stuff")
run("find hi")
# grep looks for a quoted phrase, spaces and all, and find for a quoted name part
run("write /tmp/poem.txt x")
vfs.write(t.fs, "/tmp/poem.txt", "the old pond\na frog jumps in\nold  pond twice\nsound of water\n")
run("grep \"old pond\" /tmp/poem.txt")
run("grep 'old  pond' /tmp/poem.txt")
run("grep \"frog jumps\" '/tmp/poem.txt'")
run("find \"d st\"")
run("grep \" \" /tmp/poem.txt")
# Ctrl+V of a path with a space that is there (Files' Ctrl+C) goes in quotes;
# other text, a path that is not there, or a paste onto a typed word, does not
let files = wm.files_app.init()
files.path = "/home/a folder"
let names = wm.files_app.lines(files)
for i in 0..len(files.names)
    if files.names[i] == "my notes.txt"
        files.sel = i
wm.files_app.on_key(files, "ctrl+c")
fun paste(before)
    t.input = before
    wm.terminal.on_key(t, "ctrl+v")
    return t.input
print([paste("cat "), paste(""), paste("cat x"), paste("cat \"")])
let note = wm.notes.init()
note.text = "/home/not there"
wm.notes.on_key(note, "ctrl+c")
print([paste("echo ")])
note.text = "two words"
wm.notes.on_key(note, "ctrl+c")
print([paste("echo ")])
t.input = ""
