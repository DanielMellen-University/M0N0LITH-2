# Terminal error messages say what went wrong.
use ../shell/wm

let d = wm.new_desktop(640, 480, wm.default_apps())
let t = wm.launch(d, wm.terminal)

fun type(text)
    for c in text
        if c == " "
            wm.key(d, "space")
        else
            wm.key(d, c)
    wm.key(d, "return")

fun run(cmds)
    t.state.buf = []
    for c in cmds
        type(c)
    for l in t.state.buf
        print(l)

# mv of a folder into itself
run(["mkdir /home/sub", "mv /home /home/sub", "mv /home /home", "mv / /home/sub", "mv /home/welcome.txt /home/welcome.txt", "ls /home"])

# mkdir of something that is already there, cat of a folder
run(["mkdir /tmp", "mkdir /home/welcome.txt", "mkdir /home/new", "mkdir /home/new", "cat /home", "cat /", "cat nope"])

# a path that goes through a file is just not there
run(["ls welcome.txt/x", "cat welcome.txt/x", "mkdir welcome.txt/x", "touch welcome.txt/x", "rm welcome.txt/x", "mv welcome.txt/x y", "cd welcome.txt/x", "write welcome.txt/x t"])

# a word too many is an error, not a quiet half-run
run(["touch a.txt", "touch b.txt", "rm a.txt b.txt", "cat a.txt b.txt", "mkdir x y", "touch p q", "cd /tmp /home", "ls /tmp /home", "mv a.txt b.txt c.txt", "ls"])

# options are not supported; say so instead of looking for a file named -l
run(["ls -l", "rm -r sub", "cat -n a.txt", "mkdir -p x/y", "cd -", "echo -n hi", "touch ./-odd", "ls", "rm ./-odd", "mv a.txt -b", "write -x text"])
