# cat prints the last line of a file that has no newline at the end.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
vfs.write(t.fs, "/tmp/bare.txt", "no newline")
run("cat /tmp/bare.txt")
vfs.write(t.fs, "/tmp/two.txt", "one\ntwo")
run("cat /tmp/two.txt")
