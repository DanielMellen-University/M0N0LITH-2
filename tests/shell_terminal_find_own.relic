# find matches the name, not the path, and a folder is shown with a slash.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    return slice(t.buf, 1, len(t.buf))

vfs.make_dir(t.fs, "/tmp/notes")
vfs.write(t.fs, "/tmp/notes/note.txt", "x")
vfs.write(t.fs, "/tmp/other.txt", "x")
run("cd /tmp")
print(run("find note"))
print(run("find tmp"))
