# Delete at the end of the file is not an edit.
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
let e = wm.launch(d, wm.editor)
let s = e.state
fun pos() = len(s.text) - s.back

s.text = "ab"
s.back = 0
s.undo = []
s.status = "open"
wm.key(d, "delete")
print([s.text], len(s.undo), s.status)
