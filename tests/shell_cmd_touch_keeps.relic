# touch of a file that is already there leaves its bytes alone.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
print("before", vfs.read(t.fs, "/home/welcome.txt"))
run("touch welcome.txt")
run("touch /home/welcome.txt")
print("after", vfs.read(t.fs, "/home/welcome.txt"))
