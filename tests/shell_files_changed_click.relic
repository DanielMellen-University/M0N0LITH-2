# A directory changed after drawing: a click must not open a different row.
use ../shell/wm
use std/vfs
let d = wm.new_desktop(640, 480, wm.default_apps())
let f = wm.launch(d, wm.files_app)
f.state.path = "/tmp"
vfs.write(f.state.fs, "/tmp/b.txt", "b")
vfs.write(f.state.fs, "/tmp/c.txt", "c")
print("drawn", wm.visible_lines(f))
vfs.write(f.state.fs, "/tmp/a.txt", "a")
let y = f.y + wm.title_height + wm.text_top + 2 * wm.line_height + 7
print("click old b", wm.click(d, f.x + 20, y), f.state.sel)
let e = wm.launch(d, wm.editor)
print("editor", e.state.path)
wm.restore(d, f.id)
print("redrawn", wm.visible_lines(f))
print("click new b", wm.click(d, f.x + 20, y + wm.line_height), f.state.sel)
let e2 = wm.launch(d, wm.editor)
print("editor", e2.state.path)
