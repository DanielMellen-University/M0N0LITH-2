# A > that is not its own word is text, not a redirect, and makes no file.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("echo hi>file")
run("echo hi >file")
print("glued", not vfs.exists(t.fs, "/home/hi>file"))
print("word", not vfs.exists(t.fs, "/home/>file"))
print("file", not vfs.exists(t.fs, "/home/file"))
