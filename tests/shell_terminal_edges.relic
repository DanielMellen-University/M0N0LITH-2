# Existing Terminal parsing and path behavior at input boundaries.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("")
run("   ")
run("cd /../../")
run("pwd")
run("cd ./home/../tmp//")
run("pwd")
run("touch ./odd!@#")
run("ls /tmp/./")
run("echo 'two words'")
run("cat 'two words'")
let long = ""
for i in 0..300
    long = long + "x"
run("write /tmp/long " + long)
print("long file length", len(vfs.read(t.fs, "/tmp/long")))
run("rm /tmp/long")
print("removed", not vfs.exists(t.fs, "/tmp/long"))
# sort: the lines in order, capitals first; the file stays as it was
run("write /tmp/fruit pear")
run("echo apple >> /tmp/fruit")
run("echo Fig >> /tmp/fruit")
run("sort /tmp/fruit")
run("cat /tmp/fruit")
run("sort /tmp/nothere")
run("sort /tmp")
run("sort -r /tmp/fruit")
run("sort")
# uniq: a line the same as the one before it is left out, a later repeat stays
run("write /tmp/rep a")
run("echo a >> /tmp/rep")
run("echo b >> /tmp/rep")
run("echo a >> /tmp/rep")
run("uniq /tmp/rep")
run("uniq /tmp/nothere")
run("uniq /tmp/rep /tmp/rep")
# nl: each line after its number
run("nl /tmp/rep")
run("touch /tmp/empty")
run("nl /tmp/empty")
run("nl /tmp")
# head and tail take a count of lines after the path
run("head /tmp/rep 2")
run("tail /tmp/rep 1")
run("head /tmp/rep 0")
run("tail /tmp/rep 99")
run("head /tmp/rep two")
run("tail /tmp/rep 1 2")
run("head")
