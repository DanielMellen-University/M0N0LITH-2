# grep of a path ending in / on a file says it is not a folder.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
vfs.write(t.fs, "/tmp/g.txt", "hi")
run("grep hi /tmp/g.txt/")
run("grep hi /tmp/nope.txt/")
