# minimize and restore in shell/wm.relic: taskbar buttons and the _ box
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
fun show(d)
    let names = []
    for w in d.windows
        let n = "{w.app.name}#{w.id}"
        if w.minimized
            n = n + " (min)"
        append(names, n)
    let f = wm.focused(d)
    let top = "none"
    if f != none
        top = f.app.name
    print(names, "focus", top)
fun start(d, i)
    wm.click(d, 10, 470)
    let b = wm.menu_item_box(d, i)
    return wm.click(d, b[0] + 5, b[1] + 5)
# click taskbar button of the window with this id
fun tab(d, id)
    let t = wm.tabs(d)
    for i in 0..len(t)
        if t[i].id == id
            let b = wm.tab_box(d, i)
            return wm.click(d, b[0] + 5, b[1] + 5)
    return "no tab"

print(start(d, 0), start(d, 1), start(d, 2))
show(d)

# the front window's taskbar button minimizes it; focus moves down
print(tab(d, 3))
show(d)
# keys go to the new front window (Notes), not the minimized Terminal
wm.key(d, "a")
print(d.windows[1].app.lines(d.windows[1].state)[1])

# clicking where the minimized window sits hits the window below or desktop
let term = d.windows[2]
print(wm.click(d, term.x + term.width - 30, term.y + 60))
show(d)

# its taskbar button again restores and raises it
print(tab(d, 3))
show(d)
print(term.minimized)

# the _ box minimizes; it sits just left of the x box
let mb = wm.minimize_box(term)
let cb = wm.close_box(term)
print(mb[0] + mb[2] == cb[0], mb[1] == cb[1], mb[2] == wm.title_height)
print(wm.click(d, mb[0] + 2, mb[1] + 2))
show(d)

# a non-front window's button raises it (no minimize)
print(tab(d, 1))
show(d)

# minimize everything: no focus, keys go nowhere, clicks hit the desktop
print(tab(d, 1), tab(d, 2))
show(d)
wm.key(d, "b")
print(wm.click(d, 300, 200))

# restore a minimized window that is not on top via its button
print(tab(d, 2))
show(d)

# close() works on a minimized window: it leaves the taskbar. Then the x box
wm.close(d, 3)
show(d)
print(tab(d, 3))
let n = d.windows[len(d.windows) - 1]
cb = wm.close_box(n)
print(wm.click(d, cb[0] + 2, cb[1] + 2))
show(d)

# minimizing mid-drag drops the drag
wm.click(d, 10, 470)
let b = wm.menu_item_box(d, 0)
wm.click(d, b[0] + 5, b[1] + 5)
let w = wm.focused(d)
print(wm.click(d, w.x + 10, w.y + 4), d.drag != none)
wm.minimize(d, w.id)
print(d.drag)
show(d)
