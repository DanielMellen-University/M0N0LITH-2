["/home> grep alpha a.txt", "alpha"]
["/home> grep alpha /home", "/home/a.txt:alpha", "/home/docs/c.txt:alpha", "\"/home/docs/my notes.txt\":alpha note"]
["/home> grep beta", "/home/a.txt:beta", "/home/b.txt:beta"]
["/home> grep missing /home"]
["/home> grep alpha empty"]
["/home> grep alpha missing", "grep: not found: /home/missing"]
["/home> grep alpha a.txt/", "grep: not a folder: /home/a.txt"]
["/home> grep alpha", "/home/a.txt:alpha", "/home/docs/c.txt:alpha", "\"/home/docs/my notes.txt\":alpha note"]
["/home> grep", "usage: grep <text> [path]"]
["/home> grep alpha a.txt extra", "usage: grep <text> [path]"]
["/home> grep -n a.txt", "grep: no options, not even -n"]
