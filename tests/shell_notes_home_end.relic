# Home and End move to the ends, and a second press stays there.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("abcd")
key("home")
line()
key("home")
line()
key("end")
line()
key("end")
line()
key("right")
line()
