# Ctrl+V at the start of the line inserts there.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("XY")
key("ctrl+c")
key("home")
key("ctrl+v")
line()
