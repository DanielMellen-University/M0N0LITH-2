# tail -f is refused, so the last line is not printed.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
vfs.write(t.fs, "/tmp/t.txt", "one\ntwo")
run("tail -f /tmp/t.txt")
run("tail /tmp/t.txt -n")
run("tail /tmp/t.txt 1")
