# A redirect is only recognized at the end of the line.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("echo hello > out.txt world")
print("out", not vfs.exists(t.fs, "/home/out.txt"))
print("world", not vfs.exists(t.fs, "/home/world"))
