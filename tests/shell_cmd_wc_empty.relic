# wc of an empty file is all zeros, and a single newline is one line and one character.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("touch /tmp/empty.txt")
run("wc /tmp/empty.txt")
vfs.write(t.fs, "/tmp/nl.txt", "\n")
run("wc /tmp/nl.txt")
vfs.write(t.fs, "/tmp/sp.txt", "   ")
run("wc /tmp/sp.txt")
