# Home goes to the first character after the indent, and Home again goes to the start.
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
let e = wm.launch(d, wm.editor)
let s = e.state
fun pos() = len(s.text) - s.back

s.text = "    hi"
s.back = 0
wm.key(d, "home")
print("first", pos())
wm.key(d, "home")
print("start", pos())
