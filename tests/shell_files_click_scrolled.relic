# Files: after scrolling down a long list, a click on a visible row opens
# the row shown there, not the row that would be there without scrolling.
use ../shell/wm
use std/vfs
use std/strings
let d = wm.new_desktop(640, 480, wm.default_apps())
let f = wm.launch(d, wm.files_app)
vfs.make_dir(f.state.fs, "/tmp/clickscroll")
for i in 0..20
    vfs.write(f.state.fs, "/tmp/clickscroll/f" + strings.pad_left(str(i), 2, "0") + ".txt", "x")
f.state.path = "/tmp/clickscroll"
for k in 0..12
    wm.key(d, "down")
let shown = wm.visible_lines(f)
print("scrolled", f.state.sel, shown)
# the third visible row under the title is the row at that place on screen
let y = f.y + wm.title_height + wm.text_top + 3 * wm.line_height + 7
print(wm.click(d, f.x + 20, y), f.state.sel, f.state.names[f.state.sel])
let e = wm.launch(d, wm.editor)
print("opened", e.state.path)
