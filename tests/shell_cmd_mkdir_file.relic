# mkdir of a path that is already a file is refused.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("mkdir welcome.txt")
run("mkdir /home/welcome.txt")
print("still file", not vfs.is_dir(t.fs, "/home/welcome.txt"))
print("bytes", vfs.read(t.fs, "/home/welcome.txt") == "Welcome to Relic.\n")
