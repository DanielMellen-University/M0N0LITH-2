# cp into a folder that is not there is refused, and the source stays.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("cp welcome.txt /tmp/no/such.txt")
print("no", not vfs.exists(t.fs, "/tmp/no"))
print("src", vfs.read(t.fs, "/home/welcome.txt") == "Welcome to Relic.\n")
run("cp /tmp/missing.txt /tmp/out.txt")
print("out", not vfs.exists(t.fs, "/tmp/out.txt"))
