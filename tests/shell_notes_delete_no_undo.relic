# Delete of one character is not an undo step, so Ctrl+Z does not put it back.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("ab")
key("left")
key("delete")
line()
key("ctrl+z")
line()
print("text", n.text)
