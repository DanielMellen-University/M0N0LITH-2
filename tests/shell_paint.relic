# Paint: swatches, brush and eraser, brush size, a drag that leaves no gaps,
# clear and undo, save to the desktop's files and open again, fill, line,
# rectangle and ellipse tools (outline and filled), save as a typed name.
use ../shell/wm
use std/vfs
use std/strings
let d = wm.new_desktop(640, 480, wm.default_apps())
let w = wm.launch(d, wm.paint_app)
let s = w.state
# content point (x, y) to desktop coordinates
fun at(x, y) = [w.x + x, w.y + wm.title_height + y]
fun press(x, y)
    let p = at(x, y)
    return wm.click(d, p[0], p[1])
fun move(x, y)
    let p = at(x, y)
    wm.motion(d, p[0], p[1])
# the cell (cx, cy) on the canvas, as a content point in its middle
fun cell(cx, cy) = [6 + cx * 4 + 2, 40 + cy * 4 + 2]
fun count(k)
    let n = 0
    for c in s.cells
        if c == k
            n = n + 1
    return n
fun row(y, a, b)
    let out = ""
    for x in a..b
        out = out + str(s.cells[y * 60 + x])
    return out

print(wm.visible_lines(w), len(wm.paint_boxes(w)))
# a dot, then a drag from (2, 2) to (12, 6) in one move: every cell on the way
let p = cell(2, 2)
print(press(p[0], p[1]), d.drag.mode)
p = cell(12, 6)
move(p[0], p[1])
wm.release(d)
print(count(1), row(2, 0, 14), row(4, 0, 14), row(6, 0, 14))
# red from its swatch (black, red, ... brown, eraser), size 3
print(press(6 + 18 + 3, 22 + 3), s.color)
wm.release(d)
wm.key(d, "+")
wm.key(d, "+")
wm.key(d, "+")
wm.key(d, "+")
print(s.size)
wm.key(d, "-")
p = cell(30, 20)
press(p[0], p[1])
wm.release(d)
print(count(2), row(19, 28, 33), row(20, 28, 33), row(21, 28, 33), row(22, 28, 33))
# the eraser (last swatch) takes out part of the black line
press(6 + 8 * 18 + 3, 22 + 3)
print(s.color, wm.visible_lines(w))
p = cell(5, 3)
press(p[0], p[1])
wm.release(d)
print(count(1), count(2))
# undo the eraser stroke, then the red dot
wm.key(d, "ctrl+z")
print(count(1), count(2))
wm.key(d, "ctrl+z")
print(count(1), count(2))
# a drag off the canvas and back in goes on from where it comes back
wm.key(d, "1")
wm.key(d, "-")
wm.key(d, "-")
p = cell(50, 30)
press(p[0], p[1])
move(300, p[1])
move(cell(55, 30)[0], p[1])
move(cell(58, 30)[0], p[1])
wm.release(d)
print(row(30, 48, 60))
# a press outside the canvas and a drag in do not draw
let before = count(1)
press(100, 10)
p = cell(40, 10)
move(p[0], p[1])
wm.release(d)
print(count(1) == before)
# colors by key, the eraser by key, sizes stay 1 to 4
for k in ["8", "e", "3", "0", "5"]
    wm.key(d, k)
    print(k, s.color)
wm.key(d, "-")
wm.key(d, "-")
print(s.size)
# boxes: runs of one color per row, cut to the window
print(len(wm.paint_boxes(w)))
w.width = 100
w.height = 60
let inside = true
for b in wm.paint_boxes(w)
    if b[0] < w.x or b[1] < w.y + wm.title_height or b[0] + b[2] > w.x + w.width or b[1] + b[3] > w.y + wm.title_height + w.height
        inside = false
print(len(wm.paint_boxes(w)), inside)
# save, clear, undo the clear, and open the saved picture in a new window
wm.key(d, "ctrl+s")
print(wm.visible_lines(w))
let text = vfs.read(s.fs, s.path)
let newlines = 0
for c in text
    if c == "\n"
        newlines = newlines + 1
print(slice(text, 0, 11), newlines)
let saved = count(1)
wm.key(d, "c")
print(count(0), s.status)
wm.key(d, "ctrl+z")
print(count(1) == saved)
let w2 = wm.launch(d, wm.paint_app)
print(w2.state.status, w2.state.cells == s.cells)
# a file that is not a picture, and one of another size
vfs.write(s.fs, "/home/bad.paint", "hello\n")
vfs.write(s.fs, "/home/small.paint", "paint 3 2\n123\n45\n")
# open a file from Files: the next Paint opens it when its name ends in .paint
let f = wm.launch(d, wm.files_app)
fun open_in_files(name)
    let i = 0
    for e in vfs.entries(s.fs, "/home")
        if e[0] == name
            f.state.sel = i + 1   # row 0 is ".."
        i = i + 1
    f.app.on_key(f.state, "return")
open_in_files("bad.paint")
let w3 = wm.launch(d, wm.paint_app)
let blank = true
for c in w3.state.cells
    if c != 0
        blank = false
print(w3.state.status, w3.state.path, blank)
w3.app.on_key(w3.state, "5")
let p3 = cell(1, 1)
w3.app.on_click(w3.state, p3[0], p3[1])
w3.app.on_key(w3.state, "ctrl+s")
print(w3.state.status, [vfs.read(s.fs, "/home/bad.paint")])
open_in_files("small.paint")
let w4 = wm.launch(d, wm.paint_app)
let c4 = w4.state.cells
print(w4.state.status, c4[0], c4[1], c4[2], c4[3], c4[60], c4[61], c4[62])
# a save that cannot happen says why
w4.state.path = "/nope/x.paint"
wm.key(d, "ctrl+s")
print(w4.state.status)
# fill: f, then a click fills the area of one color under it, side by side only
let wf = wm.launch(d, wm.paint_app)
let sf = wf.state
fun fcount(k)
    let n = 0
    for c in sf.cells
        if c == k
            n = n + 1
    return n
# a blank canvas with a black box from (10, 10) to (20, 20), and a black cell
# at (21, 21) that only touches it corner to corner
for i in 0..len(sf.cells)
    sf.cells[i] = 0
sf.color = 1
for i in 10..21
    for c in [[i, 10], [i, 20], [10, i], [20, i]]
        sf.cells[c[1] * 60 + c[0]] = 1
sf.cells[21 * 60 + 21] = 1
wf.app.on_key(sf, "f")
wf.app.on_key(sf, "6")
print(wf.app.lines(sf))
let pf = cell(15, 15)
wf.app.on_click(sf, pf[0], pf[1])
print(fcount(6), fcount(1), sf.status)
# drag does nothing with the fill tool
wf.app.on_drag(sf, cell(2, 2)[0], cell(2, 2)[1])
print(fcount(6))
# filling with the same color changes nothing; filling outside fills the rest but not the box inside
wf.app.on_click(sf, pf[0], pf[1])
print(fcount(6), len(sf.undo))
wf.app.on_key(sf, "3")
let po = cell(30, 30)
wf.app.on_click(sf, po[0], po[1])
print(fcount(3), fcount(6), fcount(1), sf.cells[21 * 60 + 21])
# undo the outside fill, then b goes back to the brush
wf.app.on_key(sf, "ctrl+z")
print(fcount(3), fcount(0))
wf.app.on_key(sf, "b")
wf.app.on_click(sf, po[0], po[1])
print(sf.tool, fcount(3), wf.app.lines(sf))
# line: l, press at one end, drag to the other; the line follows the pointer
# and only the last one stays
let wl = wm.launch(d, wm.paint_app)
let sl = wl.state
for i in 0..len(sl.cells)
    sl.cells[i] = 0
fun lcount(k)
    let n = 0
    for c in sl.cells
        if c == k
            n = n + 1
    return n
fun lrow(y, a, b)
    let out = ""
    for x in a..b
        out = out + str(sl.cells[y * 60 + x])
    return out
wl.app.on_key(sl, "l")
wl.app.on_key(sl, "2")
print(wl.app.lines(sl))
let a = cell(5, 5)
wl.app.on_click(sl, a[0], a[1])
print(lcount(2), len(sl.undo))
wl.app.on_drag(sl, cell(20, 5)[0], cell(20, 5)[1])
print(lcount(2), lrow(5, 3, 22))
wl.app.on_drag(sl, cell(5, 15)[0], cell(5, 15)[1])
print(lcount(2), lrow(5, 3, 22), sl.cells[15 * 60 + 5])
# a diagonal; past the canvas the end stays on its edge
wl.app.on_drag(sl, 6 + 70 * 4, 40 - 30)
print(lcount(2), sl.cells[5 * 60 + 5], sl.cells[0 * 60 + 59])
wm.release(d)
# a new press starts a new line on top; undo takes the line back in one step
wl.app.on_key(sl, "6")
let b = cell(0, 30)
wl.app.on_click(sl, b[0], b[1])
wl.app.on_drag(sl, cell(9, 30)[0], cell(9, 30)[1])
print(lcount(6), lcount(2), len(sl.undo))
wl.app.on_key(sl, "ctrl+z")
print(lcount(6), lcount(2))
# rect: r, the outline from one corner to the other, in the brush size
wl.app.on_key(sl, "c")
wl.app.on_key(sl, "r")
wl.app.on_key(sl, "3")
print(wl.app.lines(sl))
let r1 = cell(10, 10)
wl.app.on_click(sl, r1[0], r1[1])
wl.app.on_drag(sl, cell(14, 13)[0], cell(14, 13)[1])
print(lcount(3), lrow(10, 9, 16), lrow(11, 9, 16), lrow(13, 9, 16))
# dragged back past the first corner, the rectangle turns the other way
wl.app.on_drag(sl, cell(8, 8)[0], cell(8, 8)[1])
print(lcount(3), lrow(8, 7, 12), lrow(9, 7, 12), lrow(10, 7, 12))
wl.app.on_key(sl, "+")
wl.app.on_click(sl, cell(30, 20)[0], cell(30, 20)[1])
wl.app.on_drag(sl, cell(33, 23)[0], cell(33, 23)[1])
print(wl.app.lines(sl), lrow(20, 29, 35), lrow(21, 29, 35), lrow(22, 29, 35))
# n: save as a name typed on the status line
let ws = wm.launch(d, wm.paint_app)
let ss = ws.state
ws.app.on_key(ss, "4")
ws.app.on_click(ss, cell(1, 1)[0], cell(1, 1)[1])
ws.app.on_key(ss, "n")
for k in ["m", "y", "space", "c", "a", "x", "backspace", "t"]
    ws.app.on_key(ss, k)
print(ws.app.lines(ss), ss.color)
ws.app.on_key(ss, "return")
print(ss.status, ss.path, ws.app.lines(ss), strings.split(vfs.read(ss.fs, "/home/my cat.paint"), "\n")[2][1])
# while typing, the keys are the name, not tools; Esc gives up (and the desktop keeps running)
ws.app.on_key(ss, "n")
ws.app.on_key(ss, "r")
print(ss.tool, wm.dismiss(d), ss.naming, ws.app.lines(ss), wm.dismiss(d))
# a name with an ending or a whole path is used as it is; a folder that is not there fails and keeps the old name
vfs.write(ss.fs, "/home/notes.txt", "keep me")
vfs.make_dir(ss.fs, "/home/pics")
fun save_as(name)
    ws.app.on_key(ss, "n")
    for ch in name
        ws.app.on_key(ss, ch)
    ws.app.on_key(ss, "return")
    return [ss.status, ss.path]
print(save_as("notes.txt"), vfs.read(ss.fs, "/home/notes.txt"))
vfs.make_dir(ss.fs, "/home/old.d")
print(save_as("pics"), save_as("old.d"), save_as("/home/pics/one"), save_as("/home/none/two"))
print(save_as(""), save_as("   "), save_as("/home/pics/"))
# saving as over another picture writes it; the old file stays as it was
print(save_as("my cat.paint"), vfs.exists(ss.fs, "/home/pics/one.paint"))
# R: a filled rectangle; o and O: an ellipse in the box from one corner to
# the other, as an outline in the brush size or filled
let wo = wm.launch(d, wm.paint_app)
let so = wo.state
fun ocount(k)
    let n = 0
    for c in so.cells
        if c == k
            n = n + 1
    return n
fun orows(y0, y1, x0, x1)
    for y in y0..y1
        let out = ""
        for x in x0..x1
            out = out + str(so.cells[y * 60 + x])
        print(out)
wo.app.on_key(so, "c")
wo.app.on_key(so, "R")
wo.app.on_key(so, "5")
print(wo.app.lines(so))
wo.app.on_click(so, cell(4, 4)[0], cell(4, 4)[1])
wo.app.on_drag(so, cell(1, 2)[0], cell(1, 2)[1])
print(ocount(5))
orows(1, 6, 0, 6)
wo.app.on_key(so, "c")
wo.app.on_key(so, "o")
print(wo.app.lines(so))
wo.app.on_click(so, cell(2, 2)[0], cell(2, 2)[1])
wo.app.on_drag(so, cell(12, 8)[0], cell(12, 8)[1])
orows(1, 10, 1, 14)
wo.app.on_key(so, "O")
wo.app.on_key(so, "2")
print(wo.app.lines(so))
wo.app.on_click(so, cell(20, 2)[0], cell(20, 2)[1])
wo.app.on_drag(so, cell(28, 9)[0], cell(28, 9)[1])
orows(1, 11, 19, 30)
# one cell, a thin one, and a drag back over the first corner; undo takes the ellipse in one step
wo.app.on_click(so, cell(40, 20)[0], cell(40, 20)[1])
print(ocount(2), so.cells[20 * 60 + 40])
wo.app.on_drag(so, cell(40, 24)[0], cell(40, 24)[1])
orows(20, 25, 39, 42)
wo.app.on_drag(so, cell(37, 17)[0], cell(37, 17)[1])
orows(16, 22, 36, 42)
let before = ocount(2)
wo.app.on_key(so, "ctrl+z")
print(before, ocount(2), ocount(5))
# Shift or Caps Lock: capital letters pick the same tools, but R and O are the filled shapes
let wk = wm.launch(d, wm.paint_app)
let sk = wk.state
let seen = []
for k in ["F", "L", "B", "E", "R", "O", "N"]
    wk.app.on_key(sk, k)
    append(seen, [sk.tool, sk.color, sk.naming])
print(seen)
# Ctrl+Y puts back what Ctrl+Z took, newest first, until the next change
wo.app.on_key(so, "c")
so.undo = []
so.redo = []
so.color = 3
so.tool = "brush"
for c in [[2, 2], [10, 10]]
    let p = cell(c[0], c[1])
    wo.app.on_click(so, p[0], p[1])
let steps = [ocount(3)]
for k in ["ctrl+z", "ctrl+z", "ctrl+z", "ctrl+y", "ctrl+y", "ctrl+y", "ctrl+z"]
    wo.app.on_key(so, k)
    append(steps, ocount(3))
print(steps)
let p2 = cell(20, 20)
wo.app.on_click(so, p2[0], p2[1])
wo.app.on_key(so, "ctrl+y")
print(ocount(3), len(so.redo))
# [ and ] change the brush size like - and +, within 1 to 4
let sizes = []
for k in ["]", "]", "]", "]", "]", "[", "[", "[", "[", "["]
    wo.app.on_key(so, k)
    append(sizes, so.size)
print(sizes)
