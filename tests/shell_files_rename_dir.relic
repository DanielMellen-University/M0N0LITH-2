# Renaming a folder keeps what is inside it and leaves that folder selected.
use ../shell/wm
use std/vfs
let d = wm.new_desktop(640, 480, wm.default_apps())
let f = wm.launch(d, wm.files_app)
let fs = f.state.fs
fun show() = wm.visible_lines(f)

vfs.make_dir(fs, "/tmp/box")
vfs.write(fs, "/tmp/box/a.txt", "a")
f.state.path = "/tmp"
show()
for i in 0..len(f.state.names)
    if f.state.names[i] == "box"
        f.state.sel = i
for k in ["f2", "ctrl+u", "b", "i", "n", "return"]
    wm.key(d, k)
show()
print(f.state.names[f.state.sel], vfs.read(fs, "/tmp/bin/a.txt"), vfs.exists(fs, "/tmp/box"))
