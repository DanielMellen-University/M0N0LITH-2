# mv with one path prints usage and leaves that file where it is.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("touch /tmp/only.txt")
run("mv /tmp/only.txt")
print("still", vfs.exists(t.fs, "/tmp/only.txt"))
run("mv")
