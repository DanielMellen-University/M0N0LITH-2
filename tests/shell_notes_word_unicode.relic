# A character past ASCII is part of a word, so the accented word is one jump.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("café lait")
key("ctrl+left")
line()
key("ctrl+left")
line()
key("end")
key("ctrl+backspace")
line()
