# Paint: a line drawn with a bigger brush is that many cells thick, and
# the whole line is still one undo step.
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
let w = wm.launch(d, wm.paint_app)
let s = w.state
for i in 0..len(s.cells)
    s.cells[i] = 0
fun cell(cx, cy) = [6 + cx * 4 + 2, 40 + cy * 4 + 2]
fun row(y, a, b)
    let out = ""
    for x in a..b
        out = out + str(s.cells[y * 60 + x])
    return out
w.app.on_key(s, "l")
w.app.on_key(s, "+")
w.app.on_key(s, "+")
w.app.on_key(s, "2")
print(w.app.lines(s))
let a = cell(5, 5)
w.app.on_click(s, a[0], a[1])
w.app.on_drag(s, cell(15, 5)[0], cell(15, 5)[1])
print(row(4, 3, 17), row(5, 3, 17), row(6, 3, 17), len(s.undo))
