["/home> mkdir out docs/inner"]
["/home> write a.txt alpha"]
["/home> write \"b c.txt\" beta"]
["/home> write docs/inner/x.txt x"]
["/home> cp a.txt \"b c.txt\" docs out"]
["/home> tree out", "/home/out", "  a.txt", "  \"b c.txt\"", "  docs/", "    inner/", "      x.txt", "2 folders, 3 files"]
["/home> cat out/a.txt \"out/b c.txt\" out/docs/inner/x.txt", "alpha", "beta", "x"]
["/home> write out/b.txt old"]
["/home> write b.txt new"]
["/home> cp missing.txt b.txt out out/ a.txt welcome.txt out", "cp: not found: /home/missing.txt", "cp: already there: /home/out/b.txt", "cp: cannot copy a folder into itself", "cp: cannot copy a folder into itself", "cp: already there: /home/out/a.txt"]
["/home> cat out/b.txt out/welcome.txt", "old", "Welcome to Relic."]
["/home> cp a.txt b.txt nofolder", "cp: not found: /home/nofolder"]
