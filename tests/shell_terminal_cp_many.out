["/home> cp a.txt b.txt welcome.txt/x", "cp: not a folder: /home/welcome.txt"]
["/home> ls", "a.txt  \"b c.txt\"  b.txt  docs/", "out/  welcome.txt"]
["/home> cp", "usage: cp <from>... <to>"]
["/home> cp a.txt", "usage: cp <from>... <to>"]
