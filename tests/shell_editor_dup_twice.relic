# Ctrl+D again copies the copy, not the original a second time beside it.
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
let e = wm.launch(d, wm.editor)
let s = e.state
fun pos() = len(s.text) - s.back

s.text = "ab"
s.back = 0
wm.key(d, "ctrl+d")
wm.key(d, "ctrl+d")
print([s.text])
