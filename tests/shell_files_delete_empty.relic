# Files Delete: an empty folder is removed, the question names it, and the
# selection stays on its line, now the next name, or the one before when the
# removed folder was the last row.
use ../shell/wm
use std/vfs
let d = wm.new_desktop(640, 480, wm.default_apps())
let f = wm.launch(d, wm.files_app)
let fs = f.state.fs
vfs.make_dir(fs, "/tmp/del/vacant")
vfs.write(fs, "/tmp/del/keep.txt", "x")
vfs.write(fs, "/tmp/del/last.txt", "x")
f.state.path = "/tmp/del"
fun pick(name)
    wm.visible_lines(f)
    for i in 0..len(f.state.names)
        if f.state.names[i] == name
            f.state.sel = i
pick("vacant")
wm.key(d, "delete")
print(wm.visible_lines(f)[0])
wm.key(d, "delete")
print(wm.visible_lines(f), vfs.exists(fs, "/tmp/del/vacant"))
vfs.make_dir(fs, "/tmp/del2/zempty")
vfs.write(fs, "/tmp/del2/a.txt", "x")
f.state.path = "/tmp/del2"
pick("zempty")
wm.key(d, "delete")
wm.key(d, "delete")
print(wm.visible_lines(f), vfs.exists(fs, "/tmp/del2/zempty"))
