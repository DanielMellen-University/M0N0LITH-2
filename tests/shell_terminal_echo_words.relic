# A > that is not the redirect is text, and echo into a folder writes nothing.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    return slice(t.buf, 1, len(t.buf))

print(run("echo a > b c"))
print("no b", not vfs.exists(t.fs, "/home/b"))
print(run("echo hi > /tmp"))
print("tmp still folder", vfs.is_dir(t.fs, "/tmp"))
print(run("echo one > /tmp/out.txt"))
print([vfs.read(t.fs, "/tmp/out.txt")])
