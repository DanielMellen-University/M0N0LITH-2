# Deleting the last row leaves the selection on the row before it.
use ../shell/wm
use std/vfs
let d = wm.new_desktop(640, 480, wm.default_apps())
let f = wm.launch(d, wm.files_app)
let fs = f.state.fs
fun show() = wm.visible_lines(f)

vfs.write(fs, "/tmp/only.txt", "o")
f.state.path = "/tmp"
show()
for i in 0..len(f.state.names)
    if f.state.names[i] == "only.txt"
        f.state.sel = i
wm.key(d, "delete")
wm.key(d, "delete")
show()
print(f.state.names[f.state.sel], vfs.exists(fs, "/tmp/only.txt"))
