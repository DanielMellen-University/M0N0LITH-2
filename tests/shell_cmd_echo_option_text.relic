# echo does not treat a leading dash as a flag, including in front of a redirect.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("echo -n > /tmp/flag.txt")
print("bytes", vfs.read(t.fs, "/tmp/flag.txt") == "-n\n")
run("echo -- -n")
run("cat /tmp/flag.txt")
