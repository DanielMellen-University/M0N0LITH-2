# Notes cursor: Left, Right, Home, End and Ctrl+Left and Ctrl+Right move it,
# Delete takes the character after it (Ctrl+Delete the word), typing and the editing keys work at
# it, and Ctrl+Z brings back the whole line.
use ../shell/wm
let n = wm.notes.init()
fun keys(list)
    for k in list
        wm.notes.on_key(n, k)
fun typed(t)
    for ch in t
        if ch == " "
            wm.notes.on_key(n, "space")
        else
            wm.notes.on_key(n, ch)
fun show(label)
    print(label, wm.notes.lines(n)[1])
typed("hello world")
keys(["left", "left", "left", "left", "left"])
show("left 5")
typed("big ")
show("typed")
keys(["home"])
show("home")
keys(["left"])
show("left at the start")
keys(["ctrl+right"])
show("ctrl+right")
keys(["delete"])
show("delete")
keys(["end", "delete"])
show("delete at the end")
keys(["ctrl+left", "backspace"])
show("backspace")
keys(["ctrl+backspace"])
show("ctrl+backspace")
keys(["ctrl+z"])
show("ctrl+z: the whole line back, cursor at the end")
keys(["home", "right", "right"])
keys(["ctrl+u"])
show("ctrl+u before the cursor")
keys(["ctrl+z"])
show("ctrl+z")
# Ctrl+Delete takes the word after the cursor, and Ctrl+Z brings it back
keys(["ctrl+u"])
typed("one two three")
keys(["ctrl+left", "ctrl+left", "ctrl+delete"])
show("ctrl+delete")
keys(["end", "ctrl+delete"])
show("ctrl+delete at the end")
keys(["ctrl+z"])
show("ctrl+z")
# Ctrl+K takes the rest of the line, and Ctrl+Z brings it back
keys(["ctrl+left", "ctrl+k"])
show("ctrl+k")
keys(["ctrl+z"])
show("ctrl+z")
# a line wider than the window keeps the cursor in view
let d = wm.new_desktop(640, 480, wm.default_apps())
let w = wm.launch(d, wm.notes)
for ch in "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJ"
    wm.key(d, ch)
print("at the end", wm.visible_lines(w)[1])
wm.key(d, "home")
print("home", wm.visible_lines(w)[1])
for i in 0..30
    wm.key(d, "right")
print("30 right", wm.visible_lines(w)[1])
