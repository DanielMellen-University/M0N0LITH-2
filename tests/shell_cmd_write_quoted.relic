# write joins words with one space, and a quoted word keeps the spaces inside it.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("write /tmp/w.txt \"a  b\" c")
print("bytes", vfs.read(t.fs, "/tmp/w.txt") == "a  b c\n")
run("cat /tmp/w.txt")
