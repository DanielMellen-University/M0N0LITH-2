["/home> echo 1 > /tmp/c.txt"]
["/home> echo 2 >> /tmp/c.txt"]
["/home> echo 3 >> /tmp/c.txt"]
["/home> echo 4 >> /tmp/c.txt"]
["/home> echo 5 >> /tmp/c.txt"]
["/home> tail /tmp/c.txt 0"]
["/home> head /tmp/c.txt 02", "1", "2"]
["/home> tail /tmp/c.txt 03", "3", "4", "5"]
["/home> head /tmp/c.txt 1234567", "head: not a count of lines: 1234567"]
["/home> head /tmp/c.txt 1x", "head: not a count of lines: 1x"]
["/home> head /tmp/c.txt -1", "head: no options, not even -1"]
["/home> head /tmp/nothere two", "head: not a count of lines: two"]
["/home> tail /tmp/nothere 999999", "tail: not found: /tmp/nothere"]
["/home> rm /tmp/c.txt"]
