# Right enters a folder and does nothing on a file or on ..
use ../shell/wm
use std/vfs
let d = wm.new_desktop(640, 480, wm.default_apps())
let f = wm.launch(d, wm.files_app)
let fs = f.state.fs
fun show() = wm.visible_lines(f)

vfs.make_dir(fs, "/tmp/docs")
vfs.write(fs, "/tmp/a.txt", "a")
f.state.path = "/tmp"
show()
fun pick(name)
    for i in 0..len(f.state.names)
        if f.state.names[i] == name
            f.state.sel = i
pick("a.txt")
wm.key(d, "right")
print("file", f.state.path)
pick("..")
wm.key(d, "right")
print("up", f.state.path)
pick("docs")
wm.key(d, "right")
print("in", f.state.path)
