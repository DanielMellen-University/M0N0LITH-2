# uniq -c is refused, and the file is left as it was.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
vfs.write(t.fs, "/tmp/rep.txt", "a\na\nb")
run("uniq -c /tmp/rep.txt")
print("same", vfs.read(t.fs, "/tmp/rep.txt") == "a\na\nb")
