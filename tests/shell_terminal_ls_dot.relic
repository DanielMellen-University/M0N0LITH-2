# ls . lists the current folder and ls .. lists its parent.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    return slice(t.buf, 1, len(t.buf))

run("cd /tmp")
vfs.write(t.fs, "/tmp/here.txt", "x")
print(run("ls ."))
print(run("ls .."))
