# Ctrl+Right jumps to the end of the next word and stops on the punctuation after it.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("hello, world")
key("home")
key("ctrl+right")
line()
key("ctrl+right")
line()
key("ctrl+right")
line()
