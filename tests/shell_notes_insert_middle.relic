# Typing in the middle inserts there and leaves the rest of the line.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("abcd")
key("left")
key("left")
type("XY")
line()
print("text", n.text)
