# Typing after Ctrl+U is not its own undo step: Ctrl+Z brings back the cleared line.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("hello")
key("ctrl+u")
type("ab")
line()
key("ctrl+z")
line()
