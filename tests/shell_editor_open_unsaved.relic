# Unsaved text needs two fresh Returns on an unchanged path. Esc keeps it;
# an intervening key, a click, or a failed validation disarms confirmation.
use ../shell/wm
use std/vfs
let d = wm.new_desktop(640, 480, wm.default_apps())
let e = wm.launch(d, wm.editor)
let s = e.state
vfs.write(s.fs, "/home/a.txt", "A")
vfs.write(s.fs, "/home/b.txt", "B")
fun typed(t) = wm.handle(d, {type: "text", text: t})
fun ask(path)
    wm.key(d, "ctrl+o")
    typed(path)
    wm.key(d, "return")
wm.key(d, "!")
wm.key(d, "shift+left")
let before = [s.text, s.path, s.back, s.mark, len(s.undo)]
ask("a.txt")
print(wm.visible_lines(e)[0])
print("warn kept", [s.text, s.path, s.back, s.mark, len(s.undo)] == before)
print("esc keeps", wm.dismiss(d), [s.text, s.path, s.back, s.mark, len(s.undo)] == before, s.status)
ask("a.txt")
wm.handle(d, {type: "key_down", key: "return", ctrl: false, repeat: true})
print("held return", s.status, s.path)
wm.key(d, "ctrl+s")
wm.key(d, "return")
print("other key disarmed", s.status, s.path)
wm.key(d, "backspace")
typed("t")
wm.key(d, "return")
print("retyped same path", s.status, s.path)
wm.key(d, "return")
print("confirmed", s.path, [s.text], s.status, s.back, s.mark, len(s.undo), len(s.redo))
wm.key(d, "ctrl+z")
print("undo", [s.text], s.status)
# Same-path reload also warns, and a changed path needs its own confirmation.
wm.key(d, "!")
ask("a.txt")
print("reload warns", s.status, [s.text])
wm.key(d, "ctrl+u")
typed("b.txt")
wm.key(d, "return")
print("changed path", s.status, s.path)
wm.editor.on_click(s, 20, 25)
wm.key(d, "return")
print("click disarmed", s.status, s.path)
vfs.remove(s.fs, "/home/b.txt")
wm.key(d, "return")
print("gone", s.status, [s.text])
vfs.write(s.fs, "/home/b.txt", "B now")
wm.key(d, "return")
print("back warns", s.status, s.path)
vfs.remove(s.fs, "/home/b.txt")
vfs.make_dir(s.fs, "/home/b.txt")
wm.key(d, "return")
print("became folder", s.status, [s.text])
vfs.remove(s.fs, "/home/b.txt")
vfs.write(s.fs, "/home/b.txt", "B now")
wm.key(d, "return")
print("file again warns", s.status, s.path)
wm.key(d, "return")
print("opens latest", s.path, [s.text])
# Undo back to the last saved text is clean, even with history left.
wm.key(d, "!")
wm.key(d, "ctrl+z")
ask("a.txt")
print("undo to clean", s.path, [s.text], s.status, len(s.undo), len(s.redo))
# An unnamed/new buffer has no disk baseline; text still needs confirmation.
s.path = ""
s.disk = none
s.text = "draft"
ask("b.txt")
print("new warns", s.status, [s.text])
wm.dismiss(d)
print("new kept", s.path == "", [s.text])
ask("b.txt")
wm.key(d, "return")
print("new confirmed", s.path, [s.text])
