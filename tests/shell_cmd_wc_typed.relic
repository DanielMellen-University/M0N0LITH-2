# wc prints the path as it was typed, not the folder it resolved to.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("wc ./welcome.txt")
run("wc welcome.txt/../welcome.txt")
run("wc /home/../home/welcome.txt")
