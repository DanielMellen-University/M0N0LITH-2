# ls of an empty quoted word lists the current folder.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    print(t.buf)
run("ls \"\"")
run("cd /tmp")
run("touch /tmp/a.txt")
run("ls ''")
