# A comma is not part of a word: Ctrl+Left stops after it, then before the first word.
use ../shell/wm
let n = wm.notes.init()
fun key(k)
    wm.notes.on_key(n, k)
fun type(text)
    for ch in text
        if ch == " "
            key("space")
        else
            key(ch)
fun line()
    print(wm.notes.lines(n)[1])
type("hello, world")
key("ctrl+left")
line()
key("ctrl+left")
line()
key("end")
key("ctrl+backspace")
line()
