# Two Editor windows undo on their own.
use ../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
let e = wm.launch(d, wm.editor)
let s = e.state
fun pos() = len(s.text) - s.back

let g = wm.launch(d, wm.editor)
g.state.text = "other"
g.state.back = 0
s.text = "mine"
s.back = 0
wm.key(d, "x")
print("focused", [g.state.text], "other", [s.text])
wm.key(d, "ctrl+z")
print("undone", [g.state.text], [s.text])
