# echo >> creates a file that was not there, then adds a line.
use ../shell/wm
use std/vfs
let t = wm.terminal.init()
fun run(line)
    t.buf = []
    for c in line
        if c == " "
            wm.terminal.on_key(t, "space")
        else
            wm.terminal.on_key(t, c)
    wm.terminal.on_key(t, "return")
    return slice(t.buf, 1, len(t.buf))

print(run("echo first >> /tmp/new.txt"))
print([vfs.read(t.fs, "/tmp/new.txt")])
print(run("echo second >> /tmp/new.txt"))
print([vfs.read(t.fs, "/tmp/new.txt")])
