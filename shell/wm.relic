# shell/wm.relic: the MONOLITH 2 desktop model (begun in Relic's M11). No drawing here, so it
# runs and tests without SDL. shell/desktop.relic draws it with std/graphics.
#
# A desktop has apps (what the Start menu can launch) and windows (running
# apps, last one on top). An app is a map:
#   {name, width, height, init(), lines(state), on_click(state, x, y), on_key(state, key)}
# lines() gives the text rows for the window. visible_lines(w) cuts them to
# what fits, and that is what desktop.relic draws. An app may also have:
#   tail: true, pinned: n   keep the first n lines and the last ones (Terminal, Editor, IDE, Notes)
#   selected(state)         the line to keep in view (Files)
#   marks(state)            highlighted [line, from, to] parts (the Editor and IDE selection)
#   on_escape(state)        takes Escape when no menu is open; true if it used it (the IDE)
#   on_drag(state, x, y)    the pointer moved with the button held after a press inside (Paint)
#   paint(state)            colored [x, y, w, h, r, g, b] boxes under the text, in window content coordinates (Paint, Snake)
#   on_tick(state, ms)      the clock, in milliseconds, each frame while the window is focused (Snake)
# visible_lines puts the window's rows and cols in the state of a tail app,
# and cols in the state of a selected app, before it calls lines().
# Input comes in as key(d, name) and click(d, x, y), or as a graphics event
# through handle(d, e). Drag and resize use press (via click), motion, and
# release. drag on the desktop is none, or {id, mode, ox, oy} with mode "move",
# "resize" or "app" (a press inside an app with on_drag).
# When the tabs would be narrower than min_tab, the ones that do not fit go
# behind a "+N" button at the end of the bar. It opens a list of those windows
# (d.overflow_open). The focused window always keeps a tab.
# A minimized window stays in windows and on the taskbar but is not drawn,
# takes no clicks or keys, and is never focused.

use std/strings
use std/time
use std/vfs
use std/paths
use std/math
use ../relic/selfhost/lexer
use ../relic/selfhost/parser
use ../relic/selfhost/interp

let bar_height = 24     # taskbar along the bottom
let title_height = 16   # window title bar
let start_width = 56
let menu_row = 18
let tab_width = 90
let min_tab = 40         # the narrowest a tab gets: four letters of the name
let overflow_width = 40  # the "+N" button at the end of the tab strip (wider for a long N)
let overflow_col = 80    # a column of the hidden-windows list
let grip = 12           # bottom-right resize handle
let min_width = 80
let min_height = 40
let cascade_steps = 10   # windows per cascade before it wraps
let char_width = 8       # the font's characters
let line_height = 14     # text rows are this far apart
let text_left = 6        # text starts this far in from a window's left edge
let text_top = 6         # and this far below the title bar

# Shared in-memory VFS for Files, Editor and Terminal (not the host disk).
let _shell_fs = vfs.new()
# The file Editor opens next. Files sets it when you open a file.
let _shell_open = {path: "/home/welcome.txt"}

# p if it is a folder, else its nearest parent that is. Used when a folder
# an app is in gets removed or moved from another app.
fun _existing_dir(fs, p)
    let x = p
    while not vfs.is_dir(fs, x)
        x = paths.dir(x)
    return x

fun new_desktop(width, height, apps)
    return {width: width, height: height, apps: apps, windows: [], menu_open: false, overflow_open: false, next_id: 1, drag: none, clicks: 1}

fun bar_top(d) = d.height - bar_height

# Start menu rows, bottom up from the taskbar: [x, y, w, h] of row i.
fun menu_item_box(d, i)
    let n = len(d.apps)
    return [0, bar_top(d) - (n - i) * menu_row, 120, menu_row]

# Taskbar button i: [x, y, w, h]. Buttons run left to right in the order of shown_tabs(d).
fun tab_box(d, i)
    let w = tab_width_for(d)
    return [start_width + 4 + i * (w + 4), bar_top(d) + 3, w, bar_height - 6]

# How many tabs fit at min_tab, leaving room for the overflow button when they do not all fit.
fun tab_capacity(d)
    let room = d.width - start_width - 4
    if len(d.windows) * (min_tab + 4) <= room
        return len(d.windows)
    return math.max(1, int((room - overflow_width_for(d) - 4) / (min_tab + 4)))

# The tabs that get a button: all of them while they fit, else the first ones in
# launch order, with the focused window's tab in place of the last one.
fun shown_tabs(d)
    let t = tabs(d)
    let k = tab_capacity(d)
    if k >= len(t)
        return t
    let f = focused(d)
    let out = []
    for i in 0..k
        append(out, t[i])
    if f != none
        let present = false
        for w in out
            if w.id == f.id
                present = true
        if not present
            out[k - 1] = f
    return out

# The windows that have no tab, in launch order. They are behind the overflow button.
fun hidden_tabs(d)
    let shown = shown_tabs(d)
    let out = []
    for w in tabs(d)
        let seen = false
        for s in shown
            if s.id == w.id
                seen = true
        if not seen
            append(out, w)
    return out

# The "+N" button [x, y, w, h], at the right end of the bar, or none when every window has a tab.
fun overflow_box(d)
    if tab_capacity(d) >= len(d.windows)
        return none
    let w = overflow_width_for(d)
    return [d.width - w - 2, bar_top(d) + 3, w, bar_height - 6]

fun overflow_label(d) = "+{len(d.windows) - tab_capacity(d)}"

# The +N button's width: overflow_width, or wider when the window count has
# enough digits that the label (drawn 6 pixels in) would not fit. It goes by
# the window count, which N never passes, so the width does not depend on N.
fun overflow_width_for(d) = math.max(overflow_width, 8 + (1 + len("{len(d.windows)}")) * char_width)

# How many windows have no tab: the same as len(hidden_tabs(d)), without building
# the list, since the list layout below asks for it once per row.
fun _hidden_count(d) = len(d.windows) - math.min(len(d.windows), tab_capacity(d))

# Rows in a column of the hidden-windows list, and columns it takes (a new column
# starts to the left once the rows reach the top of the desktop).
fun overflow_rows(d) = math.max(1, math.min(_hidden_count(d), int(bar_top(d) / menu_row)))
fun overflow_cols(d) = int((_hidden_count(d) + overflow_rows(d) - 1) / overflow_rows(d))

# Row i of the hidden-windows list: [x, y, w, h]. Column 0 is at the right edge,
# the first row at the top, like the Start menu.
fun overflow_item_box(d, i)
    let rows = overflow_rows(d)
    let col = int(i / rows)
    return [d.width - (col + 1) * overflow_col, bar_top(d) - (rows - i % rows) * menu_row, overflow_col, menu_row]

# How many list rows get drawn and take clicks: what fits across the desktop.
fun overflow_shown(d) = math.min(_hidden_count(d), overflow_rows(d) * int(d.width / overflow_col))

# Tabs share the bar: tab_width while they fit, narrower after, never under
# min_tab, except on a bar too narrow for even one min_tab tab beside the +N
# button: there the one tab gets what is left, so it never overlaps the button.
fun tab_width_for(d)
    let n = len(d.windows)
    if n == 0
        return tab_width
    let shown = math.min(n, tab_capacity(d))
    let room = d.width - start_width - 4
    if shown < n
        room = room - overflow_width_for(d) - 4
    let w = int(room / shown) - 4
    if w > tab_width
        return tab_width
    if w < min_tab
        if shown < n
            return math.max(1, w)
        return min_tab
    return w

# A window's tab text, cut to what fits in its tab (the font is 8 pixels wide);
# empty in a tab too narrow for one letter.
fun tab_label(d, w)
    let room = math.max(0, int((tab_width_for(d) - char_width) / char_width))
    return slice(w.app.name, 0, room)

fun close_box(w) = [w.x + w.width - title_height, w.y, title_height, title_height]

# The window's name cut to the room the title bar has left of the _ and x boxes
# (desktop.relic draws it 4 pixels in).
fun title_text(w)
    let room = int((w.width - 2 * title_height - 4) / char_width)
    return slice(w.app.name, 0, math.max(0, room))

# The _ box, just left of the x box. It minimizes the window.
fun minimize_box(w) = [w.x + w.width - 2 * title_height, w.y, title_height, title_height]

fun resize_box(w) = [w.x + w.width - grip, w.y + title_height + w.height - grip, grip, grip]

fun _inside(b, x, y) = x >= b[0] and x < b[0] + b[2] and y >= b[1] and y < b[1] + b[3]

# New windows cascade down and right, then start over after cascade_steps, so
# they never open off the desktop.
fun launch(d, app)
    let n = _cascade_slot(d)
    let w = {id: d.next_id, app: app, state: app.init(), x: 40 + n * 24, y: 30 + n * 20, width: app.width, height: app.height, minimized: false}
    d.next_id = d.next_id + 1
    # Leave room for the minimum size before fitting a cascaded window.
    w.x = math.min(w.x, math.max(0, d.width - min_width))
    w.y = math.min(w.y, math.max(0, bar_top(d) - title_height - min_height))
    _clamp_size(d, w)   # a small desktop cuts the window to fit, as a resize would
    _clamp_pos(d, w)
    append(d.windows, w)
    return w

# The cascade step for a new window: the window count, or the next step after it
# that no window is sitting on. Counting alone put a new window exactly on top of
# another one after a close (open three, close the first, open one more).
fun _cascade_slot(d)
    let n = len(d.windows) % cascade_steps
    for k in 0..cascade_steps
        let slot = (n + k) % cascade_steps
        let taken = false
        for w in d.windows
            if w.x == 40 + slot * 24 and w.y == 30 + slot * 20
                taken = true
        if not taken
            return slot
    return n

# The top window that is not minimized, or none.
fun focused(d)
    let i = len(d.windows) - 1
    while i >= 0
        if not d.windows[i].minimized
            return d.windows[i]
        i = i - 1
    return none

fun _raise(d, i)
    let w = d.windows[i]
    remove(d.windows, i)
    append(d.windows, w)

fun _index_of(d, id)
    for i in 0..len(d.windows)
        if d.windows[i].id == id
            return i
    return -1

fun _end_drag_for(d, id)
    if d.drag != none and d.drag.id == id
        d.drag = none

fun close(d, id)
    let i = _index_of(d, id)
    if i >= 0
        remove(d.windows, i)
    _end_drag_for(d, id)
    if overflow_box(d) == none
        d.overflow_open = false

# Hide a window. Focus goes to the next visible window down.
fun minimize(d, id)
    let i = _index_of(d, id)
    if i < 0
        return
    d.windows[i].minimized = true
    _end_drag_for(d, id)

# Show a window again and bring it to the front.
fun restore(d, id)
    let i = _index_of(d, id)
    if i < 0
        return
    d.windows[i].minimized = false
    _raise(d, i)

# Keep enough of the title bar on screen so the window stays reachable: 40
# pixels of it at either edge. Off the left edge the _ and x boxes sit in the part
# that shows, so 40 more than those are kept there (it used to leave 8 to grab).
fun _clamp_pos(d, w)
    let max_x = d.width - 40
    let min_x = 40 + 2 * title_height - w.width
    if w.x < min_x
        w.x = min_x
    if w.x > max_x
        w.x = max_x
    let max_y = bar_top(d) - title_height
    if w.y < 0
        w.y = 0
    if w.y > max_y
        w.y = max_y

fun _clamp_size(d, w)
    if w.width < min_width
        w.width = min_width
    if w.height < min_height
        w.height = min_height
    if w.x + w.width > d.width
        w.width = d.width - w.x
        if w.width < min_width
            w.width = min_width
    let room = bar_top(d) - w.y - title_height
    if w.height > room
        w.height = room
        if w.height < min_height
            w.height = min_height

# The windows in taskbar order: launch order (by id), whatever their stacking is.
fun tabs(d)
    let out = []
    for w in d.windows
        let placed = false
        for i in 0..len(out)
            if not placed and w.id < out[i].id
                insert(out, i, w)
                placed = true
        if not placed
            append(out, w)
    return out

fun _begin_drag(d, w, mode, x, y)
    d.drag = {id: w.id, mode: mode, ox: x - w.x, oy: y - w.y}
    if mode == "resize"
        d.drag.ox = x - (w.x + w.width)
        d.drag.oy = y - (w.y + title_height + w.height)

# A mouse click at (x, y). Gives a short word saying what it hit:
#   "launch" a Start menu row (opened that app)   "start" the Start button
#   "tab" a taskbar button that showed its window  "minimize" the _ box, or a tab of the window on top
#   "overflow" the +N button (toggled the hidden-windows list)   "tab" also a row of that list
#   "bar" empty taskbar   "close" the x box   "title" and "resize" start a drag
#   "app" inside a window (its on_click ran)   "desktop" nothing
# Call motion and release after a "title" or "resize". A press first drops any drag still on.
fun click(d, x, y)
    d.drag = none   # a new press ends a drag whose release never came (let go outside the window)
    let menu_was_open = d.menu_open
    let overflow_was_open = d.overflow_open
    d.overflow_open = false   # any press closes the list; the button below reopens it
    if x < 0 or x >= d.width or y < 0 or y >= d.height
        d.menu_open = false
        return "desktop"
    if overflow_was_open
        let r = _click_overflow_list(d, x, y)
        if r != none
            return r
    if menu_was_open
        d.menu_open = false
        let r = _click_menu(d, x, y)
        if r != none
            return r
    if y >= bar_top(d)
        return _click_bar(d, x, y, menu_was_open, overflow_was_open)
    return _click_windows(d, x, y)

# A press while the Start menu is open: the app it picked, or none.
fun _click_menu(d, x, y)
    for i in 0..len(d.apps)
        if _inside(menu_item_box(d, i), x, y)
            launch(d, d.apps[i])
            return "launch"
    return none

# A press while the hidden-windows list is open: the window it picked (restored
# and in front, so it gets a tab), or none.
fun _click_overflow_list(d, x, y)
    let hidden = hidden_tabs(d)
    for i in 0..overflow_shown(d)
        if _inside(overflow_item_box(d, i), x, y)
            restore(d, hidden[i].id)
            return "tab"
    return none

# A press on the taskbar: Start (which toggles the menu), the +N button (which
# toggles the list), a tab, or empty bar.
fun _click_bar(d, x, y, menu_was_open, overflow_was_open)
    if x < start_width
        d.menu_open = not menu_was_open
        return "start"
    let ob = overflow_box(d)
    if ob != none and _inside(ob, x, y)
        d.overflow_open = not overflow_was_open
        return "overflow"
    let t = shown_tabs(d)
    for i in 0..len(t)
        if _inside(tab_box(d, i), x, y)
            let f = focused(d)
            if f != none and f.id == t[i].id
                minimize(d, t[i].id)
                return "minimize"
            restore(d, t[i].id)
            return "tab"
    return "bar"

# A press above the taskbar: the top window under it gets raised and takes the press.
fun _click_windows(d, x, y)
    let i = len(d.windows) - 1
    while i >= 0
        let w = d.windows[i]
        if not w.minimized and _inside([w.x, w.y, w.width, w.height + title_height], x, y)
            _raise(d, i)
            return _click_in(d, d.windows[len(d.windows) - 1], x, y)
        i = i - 1
    return "desktop"

# A press inside window w, already on top: its boxes first, then the app.
fun _click_in(d, w, x, y)
    if _inside(close_box(w), x, y)
        close(d, w.id)
        return "close"
    if _inside(minimize_box(w), x, y)
        minimize(d, w.id)
        return "minimize"
    if y < w.y + title_height
        _begin_drag(d, w, "move", x, y)
        return "title"
    if _inside(resize_box(w), x, y)
        _begin_drag(d, w, "resize", x, y)
        return "resize"
    if "selected" in w.app
        let lines = w.app.lines(w.state)
        # The rows under the pointer may have changed since the last frame.
        if "drawn" in w.state and (w.state.drawn != lines or w.state.drawn_rows != rows_fit(w))
            return "app"
        w.state.first = _first_row(w, lines)
        w.state.rows = rows_fit(w)
        w.state.clicks = d.clicks
    w.app.on_click(w.state, x - w.x, y - w.y - title_height)
    if "on_drag" in w.app
        d.drag = {id: w.id, mode: "app", ox: 0, oy: 0}
    return "app"

# Mouse move while a button may be held. Updates a drag or resize in progress.
fun motion(d, x, y)
    if d.drag == none
        return
    let i = _index_of(d, d.drag.id)
    if i < 0
        d.drag = none
        return
    let w = d.windows[i]
    if d.drag.mode == "move"
        w.x = x - d.drag.ox
        w.y = y - d.drag.oy
        _clamp_pos(d, w)
    else if d.drag.mode == "resize"
        w.width = x - w.x - d.drag.ox
        w.height = y - w.y - title_height - d.drag.oy
        _clamp_size(d, w)
    else if d.drag.mode == "app"
        if w.minimized
            d.drag = none
        else
            w.app.on_drag(w.state, x - w.x, y - w.y - title_height)

# The clock for the focused window's app, if it has on_tick (Snake moves on
# it). desktop.relic calls this every frame with graphics.ticks(); tests pass
# their own times.
fun tick(d, ms)
    let w = focused(d)
    if w != none and "on_tick" in w.app
        w.app.on_tick(w.state, ms)

# Mouse button up ends any drag or resize.
fun release(d)
    d.drag = none

# Escape closes the Start menu or the hidden-windows list if one is open, else
# goes to the window on top when its app has on_escape (the IDE stops a run
# waiting for input), and gives true when something took it; desktop.relic
# quits on an Escape that nothing took. Quitting drops the whole in-memory
# filesystem, so it should not be how a menu closes.
fun dismiss(d)
    let was_open = d.menu_open or d.overflow_open
    d.menu_open = false
    d.overflow_open = false
    if was_open
        return true
    # then the window on top, if its app takes Esc (the IDE stops a waiting run)
    let w = focused(d)
    if w != none and "on_escape" in w.app
        return w.app.on_escape(w.state)
    return false

# A key press goes to the window on top.
# Ctrl+Tab is the desktop's: it brings the lowest window that is not
# minimized to the front, so pressing it again goes round all of them. Every
# other key goes to the window in front.
fun key(d, k)
    if k == "ctrl+tab"
        for i in 0..len(d.windows)
            if not d.windows[i].minimized
                _raise(d, i)
                return
        return
    if k == "ctrl+shift+tab"
        # the other way round: the window with focus goes to the bottom, so
        # it undoes a Ctrl+Tab
        let top = focused(d)
        if top != none
            let i = _index_of(d, top.id)
            remove(d.windows, i)
            insert(d.windows, 0, top)
        return
    let w = focused(d)
    if w != none and k == "ctrl+w"
        # closes the window with focus, as its x box does (no app sees the key)
        close(d, w.id)
    else if w != none
        w.app.on_key(w.state, k)

# ---- input events ----

# Keys that are not typed text; the apps handle these by name. Letters, digits,
# punctuation and space come as text events, which carry shift, layout and Unicode.
let _named_keys = ["return", "backspace", "tab", "up", "down", "left", "right", "delete", "home", "end", "pageup", "pagedown", "f5"]
let _shift_keys = ["left", "right", "up", "down", "home", "end", "tab", "pageup", "pagedown"]   # shift+left and so on select in the Editor; shift+tab takes out an indent
let _ctrl_shift_keys = ["left", "right", "home", "end", "tab"]
let _modifier_keys = ["left ctrl", "right ctrl", "left shift", "right shift", "left alt", "right alt", "left gui", "right gui"]

# The app key for a key_down event, or none when it needs no key. With ctrl held
# the key is "ctrl+" and its name ("ctrl+s"), and the same with Cmd (gui) and a
# letter; text events do not come with ctrl.
# Ctrl and Alt together is AltGr on Windows, which types characters such as the
# Polish s with an accent (AltGr+S): that comes as text, so it is not Ctrl+S.
fun key_of_event(e)
    if e.type != "key_down"
        return none
    let altgr = e.ctrl and "alt" in e and e.alt
    if e.ctrl and not altgr and not e.key in _modifier_keys
        # Ctrl+Shift with a word or file move selects that far in the Editor
        if "shift" in e and e.shift and e.key in _ctrl_shift_keys
            return "ctrl+shift+" + e.key
        return "ctrl+" + e.key
    # Cmd on macOS (gui, since Relic 1.0.40) with a letter is the Ctrl shortcut
    # there: Cmd+S saves, Cmd+Z undoes, Cmd+A selects all.
    if "gui" in e and e.gui and len(e.key) == 1
        return "ctrl+" + e.key
    if "shift" in e and e.shift and e.key in _shift_keys
        return "shift+" + e.key
    if e.key == "keypad enter"
        return "return"
    if e.key in _named_keys
        return e.key
    return none

# Feeds one graphics event to the desktop: typed text and named keys go to the
# window on top, the left mouse button clicks, drags and releases. Gives the
# click result word for a click, else none.
fun handle(d, e)
    if e.type == "text"
        for ch in e.text
            if ch == " "
                key(d, "space")
            else
                key(d, ch)
    else if e.type == "key_down"
        let k = key_of_event(e)
        if k != none
            key(d, k)
    else if e.type == "mouse_down" and e.button == 1
        # clicks is 2 for the second press of a double-click (3 for a triple)
        d.clicks = 1
        if "clicks" in e
            d.clicks = e.clicks
        let r = click(d, e.x, e.y)
        d.clicks = 1
        return r
    else if e.type == "mouse_move"
        motion(d, e.x, e.y)
    else if e.type == "mouse_up" and e.button == 1
        release(d)
    return none

# ---- what fits in a window ----

# desktop.relic draws row r at y = text_top + r * line_height under the title
# bar, and each character char_width wide from text_left. A row counts as
# fitting with 4 pixels to spare below it, a column with 2 to spare on the right.
fun rows_fit(w) = math.max(1, int((w.height - 4) / line_height))
fun cols_fit(w) = math.max(1, int((w.width - text_left - 2) / char_width))

fun _fit(text, cols, keep_end)
    if len(text) <= cols
        return text
    if keep_end
        return slice(text, len(text) - cols, len(text))
    return slice(text, 0, cols)

# For a list app (one with selected): the index of the first list line shown
# under the title line, so the selected line is in view.
fun _first_row(w, lines)
    let avail = math.max(1, rows_fit(w) - 1)
    let sel = math.min(math.max(w.app.selected(w.state), 1), len(lines) - 1)
    let first = math.min(math.max(1, sel - avail + 1), len(lines) - avail)
    return math.max(first, 1)

# The lines of a window that fit it. An app with tail: true is one where you
# type at the end (Terminal, Editor, Notes): it keeps its first pinned lines
# and the last ones, and the last line, which has the cursor, keeps its end.
# An app with a selected(state) call (Files) keeps its title line and scrolls
# just far enough to show the selected line. Other apps show their first lines
# and the start of each line.
fun visible_lines(w)
    let rows = rows_fit(w)
    let tail = "tail" in w.app and w.app.tail
    if tail
        # lets an app build only the lines that can show, and wrap at the window's width
        w.state.rows = rows
    if tail or "selected" in w.app
        w.state.cols = cols_fit(w)   # Files shortens its title path to this
    if "selected" in w.app
        w.state.rows = rows   # Files pages by it (a click sets it too)
    let lines = w.app.lines(w.state)
    if "selected" in w.app
        w.state.drawn = lines
        w.state.drawn_rows = rows
    let cols = cols_fit(w)
    let out = []
    let shown = _shown(w, lines, rows, tail)
    for i in shown
        append(out, _fit(lines[i], cols, tail and i == len(lines) - 1))
    if "marks" in w.app
        w.state.shown_lines = shown
    return out

# The highlighted parts (the Editor's selection) as [x, y, w, h] boxes, for the
# lines the last visible_lines(w) gave. An app with marks(state) gives them as
# [line, from, to] in the lines it returned.
fun mark_boxes(w)
    let out = []
    if not "marks" in w.app or not "shown_lines" in w.state
        return out
    let cols = cols_fit(w)
    for m in w.app.marks(w.state)
        for row in 0..len(w.state.shown_lines)
            if w.state.shown_lines[row] == m[0]
                let a = math.min(m[1], cols)
                let b = math.min(m[2], cols)
                if b > a
                    append(out, [w.x + text_left + a * char_width, w.y + title_height + text_top + row * line_height, (b - a) * char_width, line_height])
    return out

# An app's painted boxes (Paint's canvas and swatches) in desktop coordinates,
# cut to the window's content so nothing spills over the edges.
fun paint_boxes(w)
    let out = []
    if not "paint" in w.app
        return out
    let top = w.y + title_height
    # plain comparisons, not math.max / math.min: a busy picture is ~2,000 boxes a frame
    let wx = w.x
    let ww = w.width
    let wh = w.height
    for b in w.app.paint(w.state)
        let x0 = b[0]
        let y0 = b[1]
        let x1 = x0 + b[2]
        let y1 = y0 + b[3]
        if x0 < 0
            x0 = 0
        if y0 < 0
            y0 = 0
        if x1 > ww
            x1 = ww
        if y1 > wh
            y1 = wh
        if x1 > x0 and y1 > y0
            append(out, [wx + x0, top + y0, x1 - x0, y1 - y0, b[4], b[5], b[6]])
    return out

# The indexes of the lines visible_lines shows, in order.
fun _shown(w, lines, rows, tail)
    let shown = []
    if len(lines) <= rows
        for i in 0..len(lines)
            append(shown, i)
    else if "selected" in w.app
        append(shown, 0)
        let first = _first_row(w, lines)
        for i in first..first + math.max(1, rows - 1)
            append(shown, i)
    else if not tail
        for i in 0..rows
            append(shown, i)
    else
        let pinned = math.min(w.app.pinned, rows - 1)
        for i in 0..pinned
            append(shown, i)
        for i in len(lines) - (rows - pinned)..len(lines)
            append(shown, i)
    return shown

# ---- small apps ----

fun _clicker_init() = {count: 0}
fun _clicker_lines(s) = ["Clicks: {s.count}", "Click here to count."]
fun _clicker_click(s, x, y)
    s.count = s.count + 1
fun _clicker_key(s, k)
    if k == "space" or k == "return"
        s.count = s.count + 1
    else if k == "backspace" or k == "-"
        s.count = math.max(0, s.count - 1)   # a miscount taken back, never below 0
    else if k == "ctrl+c"
        _clip.text = str(s.count)   # the number alone, to paste into Notes or the Editor

# What typing key k does to text: backspace drops the last character, space and
# any single character except a newline are added. Return is handled separately
# by the Editor; Notes and Terminal keep their input on one line.
# The desktop's clipboard, one for all windows: Ctrl+C and Ctrl+X in the
# Editor and the IDE put the selection in it, and Ctrl+V pastes it there, or
# its first line in Notes, the Terminal and the IDE's input line. It is not
# the system's clipboard.
let _clip = {text: ""}

fun _clip_line()
    let i = strings.find(_clip.text, "\n")
    if i < 0
        return _clip.text
    return slice(_clip.text, 0, i)

fun _typed(text, k)
    if k == "backspace"
        return slice(text, 0, math.max(0, len(text) - 1))
    if k == "space"
        return text + " "
    if len(k) == 1 and k != "\n"
        return text + k
    return text

fun _notes_init() = {text: ""}
fun _notes_lines(s) = ["Type something:", s.text + "_"]
fun _notes_click(s, x, y)
    return none
# Ctrl+Backspace in a one-line input: back to where the Editor's Ctrl+Left would go.
fun _drop_word(text) = slice(text, 0, _word_left(text, len(text)))

fun _notes_key(s, k)
    if k == "ctrl+v"
        s.text = s.text + _clip_line()
    else if k == "ctrl+backspace"
        s.text = _drop_word(s.text)
    else if k == "ctrl+u"
        s.text = ""   # like the Terminal's Ctrl+U
    else if k == "ctrl+c" or k == "ctrl+x"
        # the whole line (Notes has no selection); an empty one leaves the clipboard
        if s.text != ""
            _clip.text = s.text
            if k == "ctrl+x"
                s.text = ""
    else
        s.text = _typed(s.text, k)

# Seconds since 1970 as "2026-10-27 05:12:16 UTC" (days to a date by Howard Hinnant's civil_from_days).
fun format_time(secs)
    let total = math.max(0, int(secs))
    let days = int(total / 86400)
    let rest = total - days * 86400
    let z = days + 719468
    let era = int(z / 146097)
    let doe = z - era * 146097
    let yoe = int((doe - int(doe / 1460) + int(doe / 36524) - int(doe / 146096)) / 365)
    let doy = doe - (365 * yoe + int(yoe / 4) - int(yoe / 100))
    let mp = int((5 * doy + 2) / 153)
    let day = doy - int((153 * mp + 2) / 5) + 1
    let month = mp + 3
    if month > 12
        month = month - 12
    let year = yoe + era * 400
    if month <= 2
        year = year + 1
    return "{year}-{_two(month)}-{_two(day)} {_two(int(rest / 3600))}:{_two(int((rest % 3600) / 60))}:{_two(rest % 60)} UTC"

fun _two(n)
    if n < 10
        return "0{n}"
    return "{n}"

# Relic-native terminal (no host process spawn). It works on the shared VFS
# from a current folder that starts at /home. Paths may be relative to it.
fun _term_init() = {buf: ["Terminal. Type help."], input: "", cwd: "/home", fs: _shell_fs, cols: term_width, past: [], back: 0, draft: ""}

# A line cut into pieces of at most width characters, so a long line wraps
# in the window instead of losing its end.
fun _wrap(line, width)
    let w = math.max(1, width)
    if len(line) <= w
        return [line]
    let out = []
    let at = 0
    while at < len(line)
        append(out, slice(line, at, math.min(len(line), at + w)))
        at = at + w
    return out

# The last k pieces _wrap(line, width) would give, without cutting the rest.
fun _wrap_last(line, width, k)
    let w = math.max(1, width)
    let n = int((len(line) + w - 1) / w)
    if n <= 1
        return [line]
    let out = []
    for p in math.max(0, n - k)..n
        append(out, slice(line, p * w, math.min(len(line), (p + 1) * w)))
    return out

# The output and the prompt, wrapped to cols. Once visible_lines has set rows,
# only the last rows rows are built: wrapping all 200 kept lines each frame took
# about 0.24 s after cat of a file with one 200,000-character line.
fun _term_lines(s)
    s.cwd = _existing_dir(s.fs, s.cwd)   # another Terminal may have removed or moved it
    let prompt = s.cwd + "> " + s.input + "_"
    let out = []
    if not "rows" in s or s.rows <= 0
        for line in s.buf
            for piece in _wrap(line, s.cols)
                append(out, piece)
        for piece in _wrap(prompt, s.cols)
            append(out, piece)
        return out
    let parts = [_wrap_last(prompt, s.cols, s.rows)]   # last line first
    let have = len(parts[0])
    let i = len(s.buf) - 1
    while i >= 0 and have < s.rows
        let p = _wrap_last(s.buf[i], s.cols, s.rows - have)
        append(parts, p)
        have = have + len(p)
        i = i - 1
    let j = len(parts) - 1
    while j >= 0
        for piece in parts[j]
            append(out, piece)
        j = j - 1
    return out

fun _term_click(s, x, y)
    return none

# Older output falls off the top, so `cat` of a big file cannot grow the buffer (and the frame time) without limit.
let term_history = 200

fun _term_reply(s, line)
    append(s.buf, line)
    if len(s.buf) > term_history
        s.buf = slice(s.buf, len(s.buf) - term_history, len(s.buf))

fun _term_path(s, p) = paths.normalize(paths.join(s.cwd, p))

# A word ending in / names a folder, but normalizing drops the slash, so without
# this check `rm notes.txt/` removed the file and `touch new/` made one. True (after
# printing the error) when word ends in / and is a file, or is not there and the
# command would create a file from it.
fun _term_not_folder(s, cmd, word, creates)
    if not (strings.ends_with(word, "/") or strings.ends_with(word, "\\"))
        return false
    let p = _term_path(s, word)
    if vfs.is_dir(s.fs, p) or not (creates or vfs.exists(s.fs, p))
        return false
    if vfs.exists(s.fs, p)
        _term_reply(s, cmd + ": not a folder: " + p)
    else
        _term_reply(s, cmd + ": no folder: " + p)   # touch new/ when there is no new
    return true

# cd and ls accept an optional path, with different defaults.
fun _term_optional_path(s, parts, default)
    if len(parts) > 1
        return _term_path(s, parts[1])
    return default

# True when the command got exactly n words after it, else prints usage. A word
# too many is an error too: `rm a b` must not quietly remove only a.
fun _term_args(s, parts, n, usage)
    if len(parts) - 1 == n
        return true
    _term_reply(s, "usage: " + usage)
    return false

# How many characters of output fit a new Terminal window (280 pixels), so ls
# does not run off the right edge where the names could not be read.
let term_width = 34

# The words joined with two spaces, in as few lines of at most width characters
# as fit; a word longer than that gets a line to itself.
fun _pack(words, width)
    let lines = []
    let line = ""
    for w in words
        if line == ""
            line = w
        else if len(line) + 2 + len(w) <= width
            line = line + "  " + w
        else
            append(lines, line)
            line = w
    if line != ""
        append(lines, line)
    return lines

fun _term_ls(s, parts)
    if len(parts) > 1 and _term_not_folder(s, "ls", parts[1], false)
        return
    let p = _term_optional_path(s, parts, s.cwd)
    if not vfs.exists(s.fs, p)
        _term_reply(s, "ls: " + _term_missing(s, p))
        return
    if not vfs.is_dir(s.fs, p)
        _term_reply(s, paths.base(p))
        return
    let names = []
    for e in vfs.entries(s.fs, p)
        if e[1]
            append(names, e[0] + "/")
        else
            append(names, e[0])
    for line in _pack(names, s.cols)
        _term_reply(s, line)

fun _term_cat(s, path)
    if _term_not_folder(s, "cat", path, false)
        return
    let p = _term_path(s, path)
    if not vfs.exists(s.fs, p)
        _term_reply(s, "cat: " + _term_missing(s, p))
        return
    if vfs.is_dir(s.fs, p)
        _term_reply(s, "cat: is a folder: " + p)
        return
    try
        let text = vfs.read(s.fs, p)
        if strings.ends_with(text, "\n")
            text = slice(text, 0, len(text) - 1)
        if text != "" or vfs.size(s.fs, p) > 0
            # only the lines the history keeps, so a big file does not stall the frame
            for line in last_lines(text, term_history)
                _term_reply(s, line)
    catch err
        _term_reply(s, "cat: " + err.message)

# wc: lines (newlines, as Unix counts them), words (runs of non-space) and
# characters, then the path as given.
fun _term_wc(s, path)
    if _term_not_folder(s, "wc", path, false)
        return
    let p = _term_path(s, path)
    if not vfs.exists(s.fs, p)
        _term_reply(s, "wc: " + _term_missing(s, p))
        return
    if vfs.is_dir(s.fs, p)
        _term_reply(s, "wc: is a folder: " + p)
        return
    let text = vfs.read(s.fs, p)
    let words = 0
    let inside = false
    for c in text
        if strings.is_space(c)
            inside = false
        else if not inside
            inside = true
            words = words + 1
    _term_reply(s, "{strings.count(text, "\n")} {words} {len(text)} {path}")

fun _term_cd(s, parts)
    let p = _term_optional_path(s, parts, "/home")
    if vfs.is_dir(s.fs, p)
        s.cwd = p
    else if vfs.exists(s.fs, p)
        _term_reply(s, "cd: not a folder: " + p)
    else
        _term_reply(s, "cd: " + _term_missing(s, p))

# Why p cannot be made as a new file or folder, or none: the nearest part of
# the path that exists is a file, or the folder it should go in is missing.
# vfs only says "cannot write p", which does not say which part is wrong.
fun _why_not_new(fs, p)
    let up = paths.dir(p)
    while not vfs.exists(fs, up)
        up = paths.dir(up)
    if not vfs.is_dir(fs, up)
        return "not a folder: " + up
    if up != paths.dir(p)
        return "no folder: " + paths.dir(p)
    return none

# Why p is not there: a part of its path is a file, or it is simply missing.
fun _term_missing(s, p)
    let up = paths.dir(p)
    while not vfs.exists(s.fs, up)
        up = paths.dir(up)
    if not vfs.is_dir(s.fs, up)
        return "not a folder: " + up
    return "not found: " + p

fun _term_mkdir(s, path)
    let p = _term_path(s, path)
    if vfs.exists(s.fs, p)
        _term_reply(s, "mkdir: already there: " + p)
        return
    let up = paths.dir(p)
    while not vfs.exists(s.fs, up)
        up = paths.dir(up)
    if not vfs.is_dir(s.fs, up)   # mkdir makes missing folders, but not inside a file
        _term_reply(s, "mkdir: not a folder: " + up)
        return
    try
        vfs.make_dir(s.fs, p)
    catch err
        _term_reply(s, "mkdir: " + err.message)

fun _term_touch(s, path)
    if _term_not_folder(s, "touch", path, true)
        return
    let p = _term_path(s, path)
    if vfs.exists(s.fs, p)
        return
    let why = _why_not_new(s.fs, p)
    if why != none
        _term_reply(s, "touch: " + why)
        return
    try
        vfs.write(s.fs, p, "")
    catch err
        _term_reply(s, "touch: " + err.message)

# write and echo > replace the file; echo >> adds to the end. Each adds a newline.
fun _term_write(s, cmd, path, text, add)
    if _term_not_folder(s, cmd, path, true)
        return
    let p = _term_path(s, path)
    if vfs.is_dir(s.fs, p)
        _term_reply(s, cmd + ": is a folder: " + p)
        return
    if not vfs.exists(s.fs, p)
        let why = _why_not_new(s.fs, p)
        if why != none
            _term_reply(s, cmd + ": " + why)
            return
    try
        if add
            vfs.append(s.fs, p, text + "\n")
        else
            vfs.write(s.fs, p, text + "\n")
    catch err
        _term_reply(s, cmd + ": " + err.message)

fun _term_echo(s, parts)
    let n = len(parts)
    if n >= 2 and (parts[n - 1] == ">" or parts[n - 1] == ">>")
        _term_reply(s, "echo: missing redirect path")
    else if n >= 3 and (parts[n - 2] == ">" or parts[n - 2] == ">>") and strings.starts_with(parts[n - 1], "-")
        _term_reply(s, "echo: a path cannot start with -: " + parts[n - 1])
    else if n >= 3 and (parts[n - 2] == ">" or parts[n - 2] == ">>")
        _term_write(s, "echo", parts[n - 1], strings.join(slice(parts, 1, n - 2), " "), parts[n - 2] == ">>")
    else
        _term_reply(s, strings.join(slice(parts, 1, n), " "))

fun _term_rm(s, path)
    if _term_not_folder(s, "rm", path, false)
        return
    let p = _term_path(s, path)
    if not vfs.exists(s.fs, p)
        _term_reply(s, "rm: " + _term_missing(s, p))
    else if vfs.is_dir(s.fs, p) and len(vfs.list(s.fs, p)) > 0
        _term_reply(s, "rm: folder not empty: " + p)
    else
        try
            vfs.remove(s.fs, p)
        catch err
            _term_reply(s, "rm: " + err.message)

# mv a b: rename a to b, or move a into b when b is a folder.
fun _term_mv(s, a, b)
    # a folder may move to a new name ending in /, a file may not
    let file = not vfs.is_dir(s.fs, _term_path(s, a))
    if _term_not_folder(s, "mv", a, false) or _term_not_folder(s, "mv", b, file)
        return
    let src = _term_path(s, a)
    let dst = _term_path(s, b)
    if vfs.is_dir(s.fs, dst)
        dst = paths.join(dst, paths.base(src))
    if not vfs.exists(s.fs, src)
        _term_reply(s, "mv: " + _term_missing(s, src))
    else if vfs.is_dir(s.fs, src) and (src == "/" or strings.starts_with(dst, src + "/"))
        _term_reply(s, "mv: cannot move " + src + " into itself")
    else if vfs.exists(s.fs, dst)
        _term_reply(s, "mv: already there: " + dst)
    else if _why_not_new(s.fs, dst) != none
        _term_reply(s, "mv: " + _why_not_new(s.fs, dst))
    else
        try
            vfs.rename(s.fs, src, dst)
        catch err
            _term_reply(s, "mv: " + err.message)

# head: the first 10 lines of a file, read only as far as they go.
let _head_lines = 10
fun _term_head(s, path)
    if _term_not_folder(s, "head", path, false)
        return
    let p = _term_path(s, path)
    if not vfs.exists(s.fs, p)
        _term_reply(s, "head: " + _term_missing(s, p))
        return
    if vfs.is_dir(s.fs, p)
        _term_reply(s, "head: is a folder: " + p)
        return
    let text = vfs.read(s.fs, p)
    if text == ""
        return
    for line in first_lines(text, _head_lines)
        _term_reply(s, line)

# tail: the last 10 lines of a file, the way cat finds them from the end.
fun _term_tail(s, path)
    if _term_not_folder(s, "tail", path, false)
        return
    let p = _term_path(s, path)
    if not vfs.exists(s.fs, p)
        _term_reply(s, "tail: " + _term_missing(s, p))
        return
    if vfs.is_dir(s.fs, p)
        _term_reply(s, "tail: is a folder: " + p)
        return
    let text = vfs.read(s.fs, p)
    if strings.ends_with(text, "\n")
        text = slice(text, 0, len(text) - 1)
    if text == "" and vfs.size(s.fs, p) == 0
        return
    for line in last_lines(text, _head_lines)
        _term_reply(s, line)

# grep: the lines of a file that have the text in them (plain text, case
# counts, no patterns), as many as the output keeps.
fun _term_grep(s, word, path)
    if _term_not_folder(s, "grep", path, false)
        return
    let p = _term_path(s, path)
    if not vfs.exists(s.fs, p)
        _term_reply(s, "grep: " + _term_missing(s, p))
        return
    if vfs.is_dir(s.fs, p)
        _term_reply(s, "grep: is a folder: " + p)
        return
    let found = []
    for line in strings.lines(vfs.read(s.fs, p))
        if strings.contains(line, word)
            append(found, line)
    for line in slice(found, math.max(0, len(found) - term_history), len(found))
        _term_reply(s, line)

# cp copies a file (not a folder) to a new name, or into a folder; like mv it
# does not write over a file that is already there.
fun _term_cp(s, a, b)
    if _term_not_folder(s, "cp", a, false) or _term_not_folder(s, "cp", b, true)
        return
    let src = _term_path(s, a)
    let dst = _term_path(s, b)
    if vfs.is_dir(s.fs, dst)
        dst = paths.join(dst, paths.base(src))
    if not vfs.exists(s.fs, src)
        _term_reply(s, "cp: " + _term_missing(s, src))
    else if vfs.is_dir(s.fs, src)
        _term_reply(s, "cp: is a folder: " + src)
    else if vfs.exists(s.fs, dst)
        _term_reply(s, "cp: already there: " + dst)
    else if _why_not_new(s.fs, dst) != none
        _term_reply(s, "cp: " + _why_not_new(s.fs, dst))
    else
        try
            vfs.write(s.fs, dst, vfs.read(s.fs, src))
        catch err
            _term_reply(s, "cp: " + err.message)

# The words of a line; a run of spaces counts as one.
fun _words(line)
    let out = []
    for w in strings.split(line, " ")
        if w != ""
            append(out, w)
    return out

# Commands whose words are all paths, so a word like -l or -r is a mistake, not a name.
let _path_commands = ["cd", "ls", "cat", "mkdir", "touch", "rm", "mv", "cp", "wc", "head", "tail", "grep"]

fun _term_run(s, line)
    s.cwd = _existing_dir(s.fs, s.cwd)
    let trimmed = strings.trim(line)
    _term_reply(s, s.cwd + "> " + line)
    if trimmed == ""
        return
    let parts = _words(trimmed)
    let cmd = parts[0]
    if cmd in _path_commands
        for word in slice(parts, 1, len(parts))
            if strings.starts_with(word, "-")
                _term_reply(s, cmd + ": no options, not even " + word)
                return
    # write's first word is a path too (the rest is text): a file named -x could
    # not be read or removed afterwards, since cat and rm refuse the word
    if cmd == "write" and len(parts) > 1 and strings.starts_with(parts[1], "-")
        _term_reply(s, "write: no options, not even " + parts[1])
        return
    if cmd == "help"
        _term_reply(s, "help clear history echo apps date")
        _term_reply(s, "pwd cd ls cat head tail")
        _term_reply(s, "mkdir touch write rm mv cp")
        _term_reply(s, "wc grep")
        _term_reply(s, "echo text > file, >> adds")
    else if cmd == "clear"
        if _term_args(s, parts, 0, "clear")
            s.buf = []
    else if cmd == "history"
        # the commands Up brings back, numbered from the oldest; this one is
        # kept already, so it is the last
        if _term_args(s, parts, 0, "history")
            let i = 1
            for line in s.past
                _term_reply(s, strings.pad_left(str(i), 3, " ") + "  " + line)
                i = i + 1
    else if cmd == "echo"
        _term_echo(s, parts)
    else if cmd == "apps"
        if _term_args(s, parts, 0, "apps")
            let names = []
            for app in default_apps()
                append(names, app.name)
            _term_reply(s, strings.join(names, ", "))
    else if cmd == "date"
        if _term_args(s, parts, 0, "date")
            _term_reply(s, format_time(time.now()))
    else if cmd == "pwd"
        if _term_args(s, parts, 0, "pwd")
            _term_reply(s, s.cwd)
    else if cmd == "cd"
        if len(parts) > 2
            _term_reply(s, "usage: cd [path]")
        else
            _term_cd(s, parts)
    else if cmd == "ls"
        if len(parts) > 2
            _term_reply(s, "usage: ls [path]")
        else
            _term_ls(s, parts)
    else if cmd == "cat"
        # one file after another, as Unix cat; an error for one does not stop the rest
        if len(parts) < 2
            _term_reply(s, "usage: cat <path>...")
        for path in slice(parts, 1, len(parts))
            _term_cat(s, path)
    else if cmd == "mkdir"
        if _term_args(s, parts, 1, "mkdir <path>")
            _term_mkdir(s, parts[1])
    else if cmd == "touch"
        if _term_args(s, parts, 1, "touch <path>")
            _term_touch(s, parts[1])
    else if cmd == "write"
        if len(parts) > 1
            _term_write(s, "write", parts[1], strings.join(slice(parts, 2, len(parts)), " "), false)
        else
            _term_reply(s, "usage: write <path> <text>")
    else if cmd == "head"
        if _term_args(s, parts, 1, "head <path>")
            _term_head(s, parts[1])
    else if cmd == "tail"
        if _term_args(s, parts, 1, "tail <path>")
            _term_tail(s, parts[1])
    else if cmd == "grep"
        if _term_args(s, parts, 2, "grep <text> <path>")
            _term_grep(s, parts[1], parts[2])
    else if cmd == "cp"
        if _term_args(s, parts, 2, "cp <from> <to>")
            _term_cp(s, parts[1], parts[2])
    else if cmd == "wc"
        if _term_args(s, parts, 1, "wc <path>")
            _term_wc(s, parts[1])
    else if cmd == "rm"
        if _term_args(s, parts, 1, "rm <path>")
            _term_rm(s, parts[1])
    else if cmd == "mv"
        if _term_args(s, parts, 2, "mv <from> <to>")
            _term_mv(s, parts[1], parts[2])
    else
        _term_reply(s, "unknown: " + cmd)

# Up and Down go through the commands run before (the last _term_recall_keep,
# a command the same as the one before it kept once); Down past the newest
# gives back the line that was being typed.
let _term_recall_keep = 50

# Tab completes the word being typed: the first word from the command names,
# a later one from the names in its folder. One match goes in whole (a folder
# with "/" after it, anything else with a space); several are taken as far as
# they agree, and when that adds nothing they are listed. No match, or an
# empty line: nothing.
let _term_commands = ["apps", "cat", "cd", "clear", "cp", "date", "echo", "grep", "head", "help", "history", "ls", "mkdir", "mv", "pwd", "rm", "tail", "touch", "wc", "write"]

fun _common_start(names)
    let out = names[0]
    for n in names
        while not strings.starts_with(n, out)
            out = slice(out, 0, len(out) - 1)
    return out

# Where the last c in text is, plus one (0 when there is none).
fun _after_last(text, c)
    let i = len(text)
    while i > 0 and text[i - 1] != c
        i = i - 1
    return i

fun _term_complete(s)
    if strings.trim(s.input) == ""
        return   # nothing typed: nothing to complete, and no list of every command
    let cut = _after_last(s.input, " ")
    let head = slice(s.input, 0, cut)
    let word = slice(s.input, cut, len(s.input))
    let folder = ""
    let names = []
    let dirs = []
    if strings.trim(head) == ""
        names = _term_commands
    else
        folder = slice(word, 0, _after_last(word, "/"))
        let where = s.cwd
        if folder != ""
            where = _term_path(s, folder)
        if not vfs.is_dir(s.fs, where)
            return
        for e in vfs.entries(s.fs, where)
            append(names, e[0])
            if e[1]
                append(dirs, e[0])
    let part = slice(word, len(folder), len(word))
    let found = []
    for n in names
        if strings.starts_with(n, part)
            append(found, n)
    if len(found) == 0
        return
    if len(found) == 1
        let end = " "
        if found[0] in dirs
            end = "/"
        s.input = head + folder + found[0] + end
        return
    let common = _common_start(found)
    if len(common) > len(part)
        s.input = head + folder + common
    else
        _term_reply(s, s.cwd + "> " + s.input)
        _term_reply(s, strings.join(found, "  "))

fun _term_key(s, k)
    if k == "return" or k == "enter"
        let line = s.input
        if strings.trim(line) == "!!"
            # the command before, again, as in a Unix shell; shown as it runs
            if len(s.past) == 0
                _term_reply(s, s.cwd + "> " + line)
                _term_reply(s, "!!: no command before")
                s.input = ""
                return
            line = s.past[len(s.past) - 1]
        if strings.trim(line) != "" and (len(s.past) == 0 or s.past[len(s.past) - 1] != line)
            append(s.past, line)
            if len(s.past) > _term_recall_keep
                remove(s.past, 0)
        s.back = 0
        s.draft = ""
        _term_run(s, line)
        s.input = ""
    else if k == "up"
        if s.back < len(s.past)
            if s.back == 0
                s.draft = s.input
            s.back = s.back + 1
            s.input = s.past[len(s.past) - s.back]
    else if k == "down"
        if s.back > 0
            s.back = s.back - 1
            if s.back == 0
                s.input = s.draft
            else
                s.input = s.past[len(s.past) - s.back]
    else if k == "ctrl+v"
        s.input = s.input + _clip_line()
    else if k == "ctrl+c"
        # gives up the line, as a shell does: shown with ^C, not run, not kept
        _term_reply(s, s.cwd + "> " + s.input + "^C")
        s.input = ""
        s.back = 0
        s.draft = ""
    else if k == "ctrl+l"
        s.buf = []   # what clear does, keeping the line being typed
    else if k == "ctrl+backspace"
        s.input = _drop_word(s.input)
    else if k == "tab"
        _term_complete(s)
    else if k == "ctrl+u"
        s.input = ""   # empties the line, as in most shells; nothing is shown
    else
        s.input = _typed(s.input, k)

# Files: browse the shared VFS. Click a row or use up/down/return/backspace.
fun _files_init() = {fs: _shell_fs, path: "/home", sel: 0, first: 1, rows: 0, names: [], dirs: [], names_path: "", stale: false, recovered: false}

fun _files_names(s)
    let old_path = s.path
    s.path = _existing_dir(s.fs, s.path)
    s.recovered = old_path != s.path
    let names = []
    let dirs = []   # dirs[i]: names[i] is a folder (".." is not marked)
    if s.path != "/"
        append(names, "..")
        append(dirs, false)
    for e in vfs.entries(s.fs, s.path)
        append(names, e[0])
        append(dirs, e[1])
    s.dirs = dirs
    s.stale = false
    if s.names_path == s.path and s.sel < len(s.names) and s.sel >= 0
        let selected = s.names[s.sel]
        let found = false
        for i in 0..len(names)
            if names[i] == selected
                s.sel = i
                found = true
        if not found
            s.sel = 0
            s.stale = true
    else if s.names_path != "" and s.names_path != s.path
        s.sel = 0
    if s.recovered
        s.sel = 0
        s.stale = true
    s.names = names
    s.names_path = s.path
    return names

fun _files_full(s, name)
    if name == ".."
        return paths.dir(s.path)
    if s.path == "/"
        return "/" + name
    return s.path + "/" + name

fun _files_clamp_selection(s, names)
    if s.sel >= len(names)
        s.sel = len(names) - 1
    if s.sel < 0
        s.sel = 0

# prefix + path, with the start of the path replaced by ... when it is longer
# than cols, so the folder you are in stays readable in a narrow window. With
# no room for the prefix it goes too. cols 0 means not drawn yet: no change.
fun _fit_path(prefix, path, cols)
    if cols <= 3 or len(prefix) + len(path) <= cols
        return prefix + path
    let keep = cols - len(prefix) - 3
    if keep < 1
        return "..." + slice(path, math.max(0, len(path) - (cols - 3)), len(path))
    return prefix + "..." + slice(path, len(path) - keep, len(path))

fun _files_lines(s)
    let names = _files_names(s)
    let cols = 0
    if "cols" in s
        cols = s.cols
    let out = [_fit_path("Files: ", s.path, cols)]
    _files_clamp_selection(s, names)
    for i in 0..len(names)
        let mark = "  "
        if i == s.sel
            mark = "> "
        if s.dirs[i]
            append(out, mark + names[i] + "/")
        else
            append(out, mark + names[i])
    return out

# The line of _files_lines that holds the selection (line 0 is the title).
fun _files_selected(s)
    return s.sel + 1

# Go to the parent folder with the folder you were in selected, so going back
# down is one key. Used by backspace and by opening "..".
fun _files_up(s)
    let child = paths.base(s.path)
    s.path = paths.dir(s.path)
    let names = _files_names(s)
    for i in 0..len(names)
        if names[i] == child
            s.sel = i

fun _files_open(s, name)
    let full = _files_full(s, name)
    if name == ".."
        _files_up(s)
    else if vfs.is_dir(s.fs, full)
        s.path = full
        s.sel = 0
    else
        # the next Editor window opens this file
        _shell_open.path = full

# Line r covers y from text_top + line_height * r. Line 0 is the title.
# A row opens on a single click. The second press of a double-click is
# ignored, so double-clicking a folder enters it once instead of also opening
# the row that lands under the pointer inside.
fun _files_click(s, x, y)
    if "clicks" in s and s.clicks >= 2
        return
    if y < text_top
        return
    let row = int((y - text_top) / line_height)
    if row <= 0 or row >= s.rows
        return
    let names = _files_names(s)
    let i = row - 1 + s.first - 1   # s.first is the first visible list line, set by _click_in
    if i >= 0 and i < len(names)
        s.sel = i
        _files_open(s, names[i])

fun _files_key(s, k)
    let names = _files_names(s)
    # another app may have removed files since the last draw
    _files_clamp_selection(s, names)
    if k == "up"
        if s.sel > 0
            s.sel = s.sel - 1
    else if k == "down"
        if s.sel < len(names) - 1
            s.sel = s.sel + 1
    else if k == "return" or k == "enter"
        if len(names) > 0 and not s.stale
            _files_open(s, names[s.sel])
    else if k == "backspace" or k == "left"
        # Left as in a folder tree: up to the folder this one is in
        if s.path != "/" and not s.recovered
            _files_up(s)
    else if k == "right"
        # Right goes into the selected folder; on a file or .. it does nothing
        if len(names) > 0 and not s.stale and names[s.sel] != ".." and vfs.is_dir(s.fs, _files_full(s, names[s.sel]))
            _files_open(s, names[s.sel])
    else if k == "ctrl+c"
        # the selected row's full path, to paste into the Terminal or a note
        if len(names) > 0 and names[s.sel] != ".."
            _clip.text = _files_full(s, names[s.sel])
    else if k == "home" or k == "ctrl+home"
        s.sel = 0
    else if k == "end" or k == "ctrl+end"
        s.sel = math.max(0, len(names) - 1)   # Ctrl too, as in the Editor
    else if k == "pageup" or k == "pagedown"
        # a window of rows at a time (the title is one row), at least one
        let page = math.max(1, s.rows - 2)
        if k == "pageup"
            s.sel = math.max(0, s.sel - page)
        else
            s.sel = math.max(0, math.min(len(names) - 1, s.sel + page))
    else if len(k) == 1 and k != "." and k != "/"
        # a letter or digit: the next name that starts with it, going round
        let want = strings.lower(k)
        for step in 1..len(names) + 1
            let i = (s.sel + step) % len(names)
            if names[i] != ".." and strings.lower(slice(names[i], 0, 1)) == want
                s.sel = i
                break

# Editor: text buffer over a VFS path. Type like Notes; ctrl+s saves.
# It opens the file last opened in Files, or /home/welcome.txt.
fun _editor_init()
    let path = _shell_open.path
    let text = ""
    let status = "open"
    if vfs.is_dir(_shell_fs, path)
        status = "is a folder"
    else if not vfs.exists(_shell_fs, path)
        # nothing to read yet: Ctrl+S makes it, unless a part of the path is wrong
        status = "new file"
        if _why_not_new(_shell_fs, path) != none
            status = _why_not_new(_shell_fs, path)
    else
        try
            text = vfs.read(_shell_fs, path)
        catch err
            status = err.message
    # disk: the file as the Editor last read or saved it (none: no file then)
    let disk = none
    if status == "open"
        disk = text
    return {fs: _shell_fs, path: path, text: text, status: status, rows: 0, disk: disk, overwrite: false, undo: [], redo: [], back: 0, mark: none}

# The cursor is `back` characters before the end of the text (0: at the end, so
# text set from outside keeps the cursor at its end). A selection runs from the
# cursor to `mark`, also counted from the end, or there is none.
fun _editor_pos(s) = math.max(0, len(s.text) - s.back)

fun _editor_set_pos(s, pos)
    s.back = len(s.text) - math.min(math.max(0, pos), len(s.text))

# The selected range [from, to) of the text, or none.
fun _editor_selection(s)
    if s.mark == none
        return none
    let a = _editor_pos(s)
    let b = math.max(0, len(s.text) - s.mark)
    if a == b
        return none
    return [math.min(a, b), math.max(a, b)]

# Where the line holding position i starts, and where it ends (at its newline
# or the end of the text). They scan in chunks, like last_lines.
fun _line_start(text, i)
    let stop = i
    while stop > 0
        let start = math.max(0, stop - _scan_chunk)
        let cs = []
        for c in slice(text, start, stop)
            append(cs, c)
        let j = len(cs) - 1
        while j >= 0
            if cs[j] == "\n"
                return start + j + 1
            j = j - 1
        stop = start
    return 0

fun _line_end(text, i)
    let n = len(text)
    let start = i
    while start < n
        let stop = math.min(n, start + _scan_chunk)
        let j = 0
        for c in slice(text, start, stop)
            if c == "\n"
                return start + j
            j = j + 1
        start = stop
    return n

# Ctrl+Z steps back one edit (a typed character, a Backspace, a Delete, a new
# line, or a selection typed over or removed), up to the last _undo_steps edits. Saving does not clear it. An edit is kept as
# {at, removed, added}, not a copy of the text, so a big file stays cheap.
let _undo_steps = 500

# Replace `count` characters at `at` with `added`, and remember how to go back.
fun _editor_change(s, at, count, added)
    let removed = slice(s.text, at, at + count)
    s.text = slice(s.text, 0, at) + added + slice(s.text, at + count, len(s.text))
    append(s.undo, {at: at, removed: removed, added: added})
    if len(s.undo) > _undo_steps
        remove(s.undo, 0)
    s.redo = []   # a new edit ends what Ctrl+Y could bring back
    _editor_set_pos(s, at + len(added))
    s.mark = none
    s.status = "edited"

# Typing replaces the selection, if there is one; else it goes in at the cursor.
fun _editor_type(s, added)
    let sel = _editor_selection(s)
    if sel != none
        _editor_change(s, sel[0], sel[1] - sel[0], added)
    else
        _editor_change(s, _editor_pos(s), 0, added)

# Return keeps the spaces the line starts with (up to the cursor). In the
# IDE a line that opens a block (if, else, for, while, fun, try, catch) gets
# 4 more, so the next line goes inside it.
let _block_words = ["if", "else", "for", "while", "fun", "try", "catch"]

fun _editor_indent(s)
    let pos = _editor_pos(s)
    if _editor_selection(s) != none
        pos = _editor_selection(s)[0]
    let start = _line_start(s.text, pos)
    let line = slice(s.text, start, pos)
    let n = 0
    while n < len(line) and line[n] == " "
        n = n + 1
    let pad = slice(line, 0, n)
    if "run" in s
        let first = strings.split(strings.trim(line), " ")[0]
        if first in _block_words and not strings.contains(line, " = ")
            pad = pad + "    "
    return pad

# Shift+Tab takes the line's leading spaces back to the multiple of 4 before
# (one undo step); the cursor stays on the same character.
fun _editor_dedent(s)
    let pos = _editor_pos(s)
    let start = _line_start(s.text, pos)
    let n = 0
    while start + n < len(s.text) and s.text[start + n] == " "
        n = n + 1
    let r = n % 4
    if r == 0
        r = math.min(4, n)
    if r == 0
        return
    _editor_change(s, start, r, "")
    _editor_set_pos(s, math.max(start, pos - r))

# Backspace removes the selection, or the character before the cursor. In the
# leading spaces of a line it takes them back to the multiple of 4 before, so
# it undoes a Tab in one press.
fun _editor_backspace(s)
    let sel = _editor_selection(s)
    let pos = _editor_pos(s)
    if sel != none
        _editor_change(s, sel[0], sel[1] - sel[0], "")
    else if pos > 0
        let start = _line_start(s.text, pos)
        let col = pos - start
        let n = 1
        if col > 0 and slice(s.text, start, pos) == strings.repeat(" ", col)
            n = col % 4
            if n == 0
                n = 4
        _editor_change(s, pos - n, n, "")

# Delete: the selection, or the character after the cursor (none at the end).
fun _editor_delete(s)
    let sel = _editor_selection(s)
    if sel != none
        _editor_change(s, sel[0], sel[1] - sel[0], "")
    else if _editor_pos(s) < len(s.text)
        _editor_change(s, _editor_pos(s), 1, "")

# Ctrl+Backspace and Ctrl+Delete: the selection, or back to where Ctrl+Left
# would go, or on to where Ctrl+Right would (one undo step each).
fun _editor_delete_word(s, k)
    let sel = _editor_selection(s)
    let pos = _editor_pos(s)
    if sel != none
        _editor_change(s, sel[0], sel[1] - sel[0], "")
    else if k == "ctrl+backspace"
        let to = _word_left(s.text, pos)
        if to < pos
            _editor_change(s, to, pos - to, "")
    else
        let to = _word_right(s.text, pos)
        if to > pos
            _editor_change(s, pos, to - pos, "")

# The cursor's new position for a movement key: left, right, up, down
# (same column, or the end of a shorter line).
fun _editor_moved(s, k)
    let pos = _editor_pos(s)
    if k == "left"
        return pos - 1
    if k == "right"
        return pos + 1
    if k == "ctrl+left"
        return _word_left(s.text, pos)
    if k == "ctrl+right"
        return _word_right(s.text, pos)
    if k == "ctrl+home"
        return 0
    if k == "pageup" or k == "pagedown"
        # as many lines as show under the title, less one, so one stays in view
        let step = "up"
        if k == "pagedown"
            step = "down"
        let at = pos
        for i in 0..math.max(1, s.rows - 2)
            _editor_set_pos(s, at)
            at = _editor_moved(s, step)
        _editor_set_pos(s, pos)
        return at
    if k == "ctrl+end"
        return len(s.text)
    if k == "end"
        return _line_end(s.text, pos)
    let start = _line_start(s.text, pos)
    if k == "home"
        # the line's first character after its leading spaces; a second Home
        # from there goes to the very start, as code editors do
        let first = start
        while first < len(s.text) and s.text[first] == " "
            first = first + 1
        if pos == first or first == start
            return start
        return first
    let col = pos - start
    if k == "up"
        if start == 0
            return 0
        let prev = _line_start(s.text, start - 1)
        return math.min(prev + col, start - 1)
    if k == "down"
        let end = _line_end(s.text, pos)
        if end >= len(s.text)
            return len(s.text)
        return math.min(end + 1 + col, _line_end(s.text, end + 1))
    return pos

# Letters, digits, _ and anything past ASCII make up words for ctrl+left/right.
fun _word_char(c) = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_" or ord(c) > 127

# ctrl+left: to the start of the word before the cursor (past any spaces and
# punctuation first); ctrl+right: to the end of the next word. Both read the
# text in chunks.
fun _word_left(text, pos)
    let in_word = false
    let stop = pos
    while stop > 0
        let start = math.max(0, stop - _scan_chunk)
        let cs = []
        for c in slice(text, start, stop)
            append(cs, c)
        let j = len(cs) - 1
        while j >= 0
            if _word_char(cs[j])
                in_word = true
            else if in_word
                return start + j + 1
            j = j - 1
        stop = start
    return 0

fun _word_right(text, pos)
    let n = len(text)
    let in_word = false
    let start = pos
    while start < n
        let stop = math.min(n, start + _scan_chunk)
        let j = 0
        for c in slice(text, start, stop)
            if _word_char(c)
                in_word = true
            else if in_word
                return start + j
            j = j + 1
        start = stop
    return n

# A movement key without shift: a selection collapses to its left or right end
# for left and right; otherwise the cursor moves and the selection goes.
fun _editor_move(s, k)
    let sel = _editor_selection(s)
    s.mark = none
    if sel != none and k == "left"
        _editor_set_pos(s, sel[0])
    else if sel != none and k == "right"
        _editor_set_pos(s, sel[1])
    else
        _editor_set_pos(s, _editor_moved(s, k))

# Shift and a movement key: move the cursor and keep the other end of the selection.
fun _editor_select(s, k)
    if s.mark == none
        s.mark = s.back
    _editor_set_pos(s, _editor_moved(s, k))

fun _editor_undo(s)
    if len(s.undo) == 0
        s.status = "nothing to undo"
        return
    let u = s.undo[len(s.undo) - 1]
    remove(s.undo, len(s.undo) - 1)
    s.text = slice(s.text, 0, u.at) + u.removed + slice(s.text, u.at + len(u.added), len(s.text))
    _editor_set_pos(s, u.at + len(u.removed))
    s.mark = none
    s.status = "undone"
    append(s.redo, u)

# Ctrl+Y does again what Ctrl+Z undid, newest first, until another edit.
fun _editor_redo(s)
    if len(s.redo) == 0
        s.status = "nothing to redo"
        return
    let u = s.redo[len(s.redo) - 1]
    remove(s.redo, len(s.redo) - 1)
    s.text = slice(s.text, 0, u.at) + u.added + slice(s.text, u.at + len(u.removed), len(s.text))
    append(s.undo, u)
    _editor_set_pos(s, u.at + len(u.added))
    s.mark = none
    s.status = "redone"

# Ctrl+S on a file another app changed since the Editor opened or saved it warns
# first; a second Ctrl+S in a row overwrites. A file that was removed meanwhile
# is just written again: nothing is lost.
let _editor_changed = "changed on disk: ctrl+s again"  # fits the default window's title

fun _editor_disk_changed(s)
    if not vfs.exists(s.fs, s.path) or vfs.is_dir(s.fs, s.path)
        return false
    try
        return vfs.read(s.fs, s.path) != s.disk
    catch err
        return false

# The last `count` lines of text, split on newlines (all of them when count is 0).
# It scans back from the end, so a big file costs a few rows, not a split of everything.
# It reads the text in chunks: indexing one character of a long string costs time
# in proportion to its length, so scanning a 200,000-character line one index at a
# time took seconds.
let _scan_chunk = 1024
fun last_lines(text, count)
    if count <= 0
        return strings.split(text, "\n")
    let found = 0
    let stop = len(text)
    while stop > 0
        let start = math.max(0, stop - _scan_chunk)
        let cs = []
        for c in slice(text, start, stop)
            append(cs, c)
        let j = len(cs) - 1
        while j >= 0
            if cs[j] == "\n"
                found = found + 1
                if found == count
                    return strings.split(slice(text, start + j + 1, len(text)), "\n")
            j = j - 1
        stop = start
    if found == 0
        return [text]
    return strings.split(text, "\n")

# The first `count` lines of text (all of them when count is 0).
fun first_lines(text, count)
    let out = []
    let start = 0
    let n = len(text)
    while count <= 0 or len(out) < count - 1
        let end = _line_end(text, start)
        if end >= n
            break
        append(out, slice(text, start, end))
        start = end + 1
    append(out, slice(text, start, _line_end(text, start)))
    return out

# The title line (the status first: a window is often too narrow for the end of
# it), then one line per line of text (the font has no newline glyph), with "_"
# for the cursor. The line with the cursor is the bottom one when the text above
# it fills the window, else the text from its start fills it.
# When the whole title does not fit, the save hint goes first, then the start
# of the path, so the file name stays in view. A status too long to leave room
# for the path (an error) keeps the old cut: the status matters more.
# Each line is cut to the window's cols: the cursor's line keeps the cursor in
# view, the others their start. s.marks gets the selected part of each line as
# [line, from, to] (line 0 is the title), for marks().
fun _editor_lines(s)
    let head = "Editor [" + s.status + "] "
    let title = head + s.path + "  (ctrl+s save)"
    let cols = 0
    if "cols" in s and s.cols > 0
        cols = s.cols
    if cols > 0 and len(title) > cols
        title = head + s.path
        if len(head) + 4 <= cols
            title = _fit_path(head, s.path, cols)
    let rows = s.rows
    if rows >= 2
        rows = rows - 1   # the title takes one
    let pos = _editor_pos(s)
    let n = len(s.text)
    let line_end = _line_end(s.text, pos)
    let up = last_lines(slice(s.text, 0, pos) + "_" + slice(s.text, pos, line_end), rows)
    let cursor_line = len(up) - 1
    let below = []
    if line_end < n and (rows <= 0 or len(up) < rows)
        let want = 0
        if rows > 0
            want = rows - len(up)
        below = first_lines(slice(s.text, line_end + 1, n), want)
    # where in the text each shown line starts (the cursor's line counts its "_")
    let first = line_end - (len(up[cursor_line]) - 1)
    for i in 0..cursor_line
        first = first - len(up[i]) - 1
    let out = [title]
    let starts = []
    let at = first
    for i in 0..len(up)
        append(out, up[i])
        append(starts, at)
        at = at + len(up[i]) + 1
    at = at - 1   # the "_" is not in the text
    for line in below
        append(out, line)
        append(starts, at)
        at = at + len(line) + 1
    # cut to cols; the cursor's line keeps the cursor and the character after it in view
    let shift = []
    for i in 0..len(out) - 1
        let line = out[i + 1]
        let off = 0
        if cols > 0 and len(line) > cols
            if i == cursor_line
                off = math.min(len(line) - cols, math.max(0, pos - starts[i] + 2 - cols))
            out[i + 1] = slice(line, off, off + cols)
        append(shift, off)
    s.marks = []
    let sel = _editor_selection(s)
    if sel != none
        for i in 0..len(starts)
            let ls = starts[i]
            let le = ls + len(out[i + 1]) + shift[i]
            if i == cursor_line
                le = le - 1
            let a = math.max(sel[0], ls) - ls
            let b = math.min(sel[1], le) - ls
            if i == cursor_line and pos == sel[0]
                a = a + 1   # the "_" comes before the selection
                b = b + 1
            a = math.max(0, a - shift[i])
            b = b - shift[i]
            if cols > 0
                b = math.min(b, cols)
            if b > a
                append(s.marks, [i + 1, a, b])
    return out

fun _editor_marks(s)
    if "marks" in s
        return s.marks
    return []

fun _editor_click(s, x, y)
    return none

fun _editor_key(s, k)
    if k == "ctrl+s"
        # the same reasons the Terminal gives, shorter than "cannot write" and the whole path
        if vfs.is_dir(s.fs, s.path)
            s.status = "is a folder"
            return
        if not vfs.exists(s.fs, s.path) and _why_not_new(s.fs, s.path) != none
            s.status = _why_not_new(s.fs, s.path)
            return
        if not s.overwrite and _editor_disk_changed(s)
            s.status = _editor_changed
            s.overwrite = true
            return
        s.overwrite = false
        try
            vfs.write(s.fs, s.path, s.text)
            s.status = "saved"
            s.disk = s.text
        catch err
            s.status = err.message
    else if k == "ctrl+z"
        s.overwrite = false
        _editor_undo(s)
    else if k == "ctrl+y"
        s.overwrite = false
        _editor_redo(s)
    else if k == "ctrl+a"
        s.overwrite = false
        s.mark = len(s.text)
        s.back = 0
    else if k == "ctrl+l"
        # the cursor's line with its newline, as in most code editors; again
        # takes in the next line too
        s.overwrite = false
        let sel = _editor_selection(s)
        let from = _line_start(s.text, _editor_pos(s))
        if sel != none
            from = _line_start(s.text, sel[0])
        let to = _line_end(s.text, _editor_pos(s))
        if to < len(s.text)
            to = to + 1
        s.mark = len(s.text) - from
        _editor_set_pos(s, to)
    else if k == "ctrl+up" or k == "ctrl+down"
        # moves the cursor's line above the one before or below the one after
        # (Alt+Up and Alt+Down in VS Code), the cursor going with it; one undo
        s.overwrite = false
        let pos = _editor_pos(s)
        let a = _line_start(s.text, pos)
        let b = _line_end(s.text, pos)
        let line = slice(s.text, a, b)
        if k == "ctrl+up" and a > 0
            let pa = _line_start(s.text, a - 1)
            _editor_change(s, pa, b - pa, line + "\n" + slice(s.text, pa, a - 1))
            _editor_set_pos(s, pa + pos - a)
        else if k == "ctrl+down" and b < len(s.text)
            let nb = _line_end(s.text, b + 1)
            let after = slice(s.text, b + 1, nb)
            _editor_change(s, a, nb - a, after + "\n" + line)
            _editor_set_pos(s, a + len(after) + 1 + pos - a)
    else if k == "ctrl+j"
        # joins the next line onto the cursor's: its newline and leading spaces
        # become one space (none after an empty line), the cursor at the join
        s.overwrite = false
        let at = _line_end(s.text, _editor_pos(s))
        if at < len(s.text)
            let n = 1
            while at + n < len(s.text) and s.text[at + n] == " "
                n = n + 1
            let glue = " "
            if at == _line_start(s.text, at) or at + n == len(s.text) or s.text[at + n] == "\n"
                glue = ""
            _editor_change(s, at, n, glue)
            _editor_set_pos(s, at)
    else if k == "ctrl+k"
        # removes the cursor's line (or the lines the selection is on) with
        # its newline; the last line takes the newline before it instead
        s.overwrite = false
        let pos = _editor_pos(s)
        let sel = _editor_selection(s)
        let from = _line_start(s.text, pos)
        let to = _line_end(s.text, pos)
        if sel != none
            from = _line_start(s.text, sel[0])
            to = _line_end(s.text, sel[1])
        if to < len(s.text)
            to = to + 1
        else if from > 0
            from = from - 1
        if to > from
            _editor_change(s, from, to - from, "")
    else if k == "ctrl+d"
        # a copy of the cursor's line (or of the lines the selection is on)
        # under it, the cursor on the copy at the same column
        s.overwrite = false
        let pos = _editor_pos(s)
        let sel = _editor_selection(s)
        let from = _line_start(s.text, pos)
        let to = _line_end(s.text, pos)
        if sel != none
            from = _line_start(s.text, sel[0])
            to = _line_end(s.text, sel[1])
        let block = slice(s.text, from, to)
        _editor_change(s, to, 0, "\n" + block)
        _editor_set_pos(s, pos + len(block) + 1)
    else if k == "ctrl+c" or k == "ctrl+x"
        s.overwrite = false
        let sel = _editor_selection(s)
        if sel != none
            _clip.text = slice(s.text, sel[0], sel[1])
            if k == "ctrl+x"
                _editor_change(s, sel[0], sel[1] - sel[0], "")
    else if k == "ctrl+v"
        s.overwrite = false
        if _clip.text != ""
            _editor_type(s, _clip.text)
    else if k == "shift+tab" or k == "ctrl+["
        s.overwrite = false
        _editor_dedent(s)
    else if k == "ctrl+]"
        # one indent more at the line's start, wherever the cursor is in it
        s.overwrite = false
        let pos = _editor_pos(s)
        let start = _line_start(s.text, pos)
        _editor_change(s, start, 0, "    ")
        _editor_set_pos(s, pos + 4)
    else if k == "ctrl+backspace" or k == "ctrl+delete"
        s.overwrite = false
        _editor_delete_word(s, k)
    else if k in ["shift+left", "shift+right", "shift+up", "shift+down", "shift+home", "shift+end", "shift+pageup", "shift+pagedown"]
        s.overwrite = false
        _editor_select(s, slice(k, 6, len(k)))
    else if k in ["ctrl+shift+left", "ctrl+shift+right", "ctrl+shift+home", "ctrl+shift+end"]
        s.overwrite = false
        _editor_select(s, "ctrl+" + slice(k, 11, len(k)))
    else if k in ["left", "right", "up", "down", "home", "end", "ctrl+left", "ctrl+right", "ctrl+home", "ctrl+end", "pageup", "pagedown"]
        s.overwrite = false
        _editor_move(s, k)
    else
        s.overwrite = false   # the second Ctrl+S has to come right after the warning
        if k == "return" or k == "enter"
            _editor_type(s, "\n" + _editor_indent(s))
        else if k == "tab"
            # spaces to the next multiple of 4 (Relic's indent); never a tab character
            let pos = _editor_pos(s)
            if _editor_selection(s) != none
                pos = _editor_selection(s)[0]
            let col = pos - _line_start(s.text, pos)
            _editor_type(s, strings.repeat(" ", 4 - col % 4))
        else if k == "backspace"
            _editor_backspace(s)
        else if k == "delete"
            _editor_delete(s)
        else
            let typed = _typed("", k)
            if typed != ""
                _editor_type(s, typed)

# IDE: the Editor on a .relic file, with Ctrl+R to run the text (saved or not)
# and an output pane under it. The program runs in selfhost/interp, inside the
# desktop: its print and eprint lines go to the pane, a `use` of another file
# reads it from the desktop's files (std/ from Relic's), and the host built-ins
# that would exit, open a window or change files on disk are refused. When it
# reads a line (os.read_line, os.prompt) the run pauses and the pane ends in an
# input line: typing goes there, Return sends it, Esc stops the run. Between
# inputs it may take _ide_steps steps, so a loop that never ends cannot hang
# the desktop. An error shows as "line L: message" and Ctrl+E puts the cursor
# at the start of that line.
let _ide_steps = 200000
let _ide_pane = 6       # output lines shown at most, under a separator line
let _ide_out_keep = 200 # output lines kept

fun _ide_init()
    let s = _editor_init()
    s.out = []          # the last run's output, then its error if any
    s.err_line = none   # line of the last run's error in this file, or none
    s.run = none        # a run waiting for a line of input, or none
    s.input = ""        # the line typed so far for it
    return s

# host_* names a program in the IDE may not call.
fun _ide_denied()
    let out = {host_exit: true, host_write_file: true, host_remove: true, host_rename: true, host_make_dir: true, host_sleep: true}
    for b in host_names()
        if strings.starts_with(b[0], "host_gfx_") or strings.starts_with(b[0], "host_clipboard_")
            out[b[0]] = true
    return out

fun _ide_run(s)
    s.out = []
    s.err_line = none
    s.run = none
    s.input = ""
    let lexed = lexer.lex(s.text)
    let err = lexed.err
    if err == none
        let parsed = parser.parse(lexed.tokens)
        err = parsed.err
        if err == none
            let rt = interp.new_runtime()
            rt.out = s.out
            rt.steps = _ide_steps
            rt.denied = _ide_denied()
            rt.input = []
            let fs = s.fs
            fun load(path)
                if vfs.exists(fs, path) and not vfs.is_dir(fs, path)
                    return vfs.read(fs, path)
                return none
            rt.load = load
            interp.set_main(rt, s.path)
            interp.run(rt, parsed.tree)
            _ide_after(s, rt)
            return
    s.status = "error"
    _ide_error(s, err)

# After a run stopped or paused: keep the last lines, then the error if any.
fun _ide_after(s, rt)
    if len(rt.out) > _ide_out_keep
        s.out = slice(rt.out, len(rt.out) - _ide_out_keep, len(rt.out))
        rt.out = s.out
    if rt.waiting != none
        s.run = rt
        s.status = "waiting for input"
        return
    s.run = none
    if rt.err == none
        s.status = "ran"
        return
    s.status = "error"
    if rt.stopped
        append(s.out, rt.err.msg + " ({_ide_steps} steps)")
        return
    _ide_error(s, rt.err)

fun _ide_error(s, err)
    let where = "line {err.line}"
    if "file" in err and err.file != "" and err.file != s.path
        where = err.file + " line {err.line}"   # inside a module the program used
    else
        s.err_line = err.line
    append(s.out, where + ": " + err.msg)

# Keys while a run waits for a line: typing, Backspace, Return sends it.
fun _ide_input_key(s, k)
    if k == "return" or k == "enter"
        let rt = s.run
        let line = s.input
        s.input = ""
        rt.steps = _ide_steps
        interp.resume(rt, line)
        _ide_after(s, rt)
    else if k == "backspace"
        if len(s.input) > 0
            s.input = slice(s.input, 0, len(s.input) - 1)
    else if k == "space"
        s.input = s.input + " "
    else if k == "ctrl+v"
        s.input = s.input + _clip_line()
    else if k == "ctrl+backspace"
        s.input = _drop_word(s.input)
    else if k == "ctrl+u"
        s.input = ""
    else if k == "ctrl+c"
        _ide_escape(s)   # stops the run, as Esc does and as in a terminal
    else if len(k) == 1
        s.input = s.input + k

# Esc in the Editor (and the IDE): drops a selection, so an Esc meant for it
# does not quit the desktop. True when there was one.
fun _editor_escape(s)
    if _editor_selection(s) == none
        return false
    s.mark = none
    return true

# Esc: stops a run that waits for input, or else drops a selection. True when
# it did either.
fun _ide_escape(s)
    if s.run == none
        return _editor_escape(s)
    s.run = none
    s.input = ""
    s.status = "stopped"
    append(s.out, "stopped")
    return true

# Ctrl+/: comments the cursor's line out with "# " after its leading spaces,
# or takes a "#" (and one space after it) back off; one undo step.
fun _ide_toggle_comment(s)
    let pos = _editor_pos(s)
    let start = _line_start(s.text, pos)
    let at = start
    while at < len(s.text) and s.text[at] == " "
        at = at + 1
    if at < len(s.text) and s.text[at] == "#"
        let n = 1
        if at + 1 < len(s.text) and s.text[at + 1] == " "
            n = 2
        _editor_change(s, at, n, "")
        _editor_set_pos(s, math.max(at, pos - n))
    else
        _editor_change(s, at, 0, "# ")
        if pos >= at
            _editor_set_pos(s, pos + 2)
        else
            _editor_set_pos(s, pos)

# Ctrl+E: the cursor to the start of the error's line.
fun _ide_to_error(s)
    if s.err_line == none
        return
    let pos = 0
    let line = 1
    let n = len(s.text)
    while line < s.err_line and pos < n
        let e = _line_end(s.text, pos)
        if e >= n
            break
        pos = e + 1
        line = line + 1
    s.mark = none
    _editor_set_pos(s, pos)

# The Editor's lines over the rows left above the pane, then the pane.
fun _ide_lines(s)
    let pane = []
    if len(s.out) > 0
        pane = ["-- output --"]
        if s.err_line != none
            pane = ["-- output (ctrl+e: to line {s.err_line}) --"]
    if s.run != none
        pane = ["-- input (return: send, esc: stop) --"]
    if len(pane) > 0
        let shown = _ide_pane
        if s.run != none
            shown = shown - 1
        let n = math.min(len(s.out), shown)
        for line in slice(s.out, len(s.out) - n, len(s.out))
            append(pane, line)
        if s.run != none
            append(pane, str(s.run.waiting) + s.input + "_")
    let rows = s.rows
    if rows > 0
        s.rows = math.max(2, rows - len(pane))
    let out = _editor_lines(s)
    s.rows = rows
    out[0] = "IDE" + slice(out[0], 6, len(out[0]))   # "Editor [..." -> "IDE [..."
    out[0] = strings.replace(out[0], "(ctrl+s save)", "(ctrl+s save, ctrl+r run)")
    for line in pane
        append(out, line)
    return out

fun _ide_key(s, k)
    if k == "f5" or k == "ctrl+return" or k == "ctrl+keypad enter"
        k = "ctrl+r"   # F5 and Ctrl+Return run too, as in most IDEs and notebooks
    if s.run != none and k == "ctrl+s"
        # saving does not stop a run that waits for input (decided Oct 31)
        _editor_key(s, k)
        if s.status == "saved"
            s.status = "saved, waiting for input"
    else if s.run != none and k != "ctrl+r"
        _ide_input_key(s, k)
    else if k == "ctrl+r"
        _ide_run(s)
    else if k == "ctrl+e"
        _ide_to_error(s)
    else if k == "ctrl+/"
        _ide_toggle_comment(s)
    else
        _editor_key(s, k)

# ---- Paint ----
# A picture of _paint_w by _paint_h cells, each _paint_cell pixels, with a row
# of color swatches above it. Press and drag on the canvas to draw with the
# brush (a square of 1 to 4 cells), the eraser draws white. Keys: 1 to 8 pick a
# color, e or 0 the eraser, + and - the brush size, f the fill tool (a click
# fills the area of one color under it), l the line tool, r the rectangle and
# o the ellipse (press at one end or corner and drag to the other; until the
# button is let go the shape follows the pointer), R and O the filled
# rectangle and ellipse, i picks the color of the next cell clicked, and b
# the brush again, c clears,
# Ctrl+Z undoes a stroke, a fill, a shape or a clear, Ctrl+S saves, n saves as
# a name typed on the status line (Return saves, Esc gives up). A picture is a text file in the desktop's
# files: "paint W H" and then H lines of W digits (0 is white). Paint opens the
# file Files last opened when its name ends in .paint, else /home/picture.paint.
let _paint_w = 60
let _paint_h = 36
let _paint_cell = 4
let _paint_left = 6     # canvas position in the window's content
let _paint_top = 40
let _swatch_top = 22
let _swatch = 14        # swatch size; one every 18 pixels from _paint_left
let _paint_undo_keep = 20
let _paint_colors = [[255, 255, 255], [20, 20, 20], [210, 40, 40], [240, 140, 30], [240, 210, 40], [50, 160, 70], [50, 100, 210], [140, 70, 180], [130, 80, 40]]
let _paint_names = ["eraser", "black", "red", "orange", "yellow", "green", "blue", "purple", "brown"]

fun _paint_blank()
    let cells = []
    for i in 0.._paint_w * _paint_h
        append(cells, 0)
    return cells

fun _paint_init()
    let path = "/home/picture.paint"
    if strings.ends_with(_shell_open.path, ".paint")
        path = _shell_open.path
    let s = {fs: _shell_fs, path: path, cells: _paint_blank(), color: 1, size: 1, last: none, stroke: false, undo: [], redo: [], status: "new file", foreign: false, tool: "brush", anchor: none, base: none, naming: none}
    if vfs.exists(_shell_fs, path) and not vfs.is_dir(_shell_fs, path)
        _paint_load(s, vfs.read(_shell_fs, path))
    return s

# Reads a saved picture into s; a picture of another size keeps the part that fits.
fun _paint_load(s, text)
    let rows = strings.split(text, "\n")
    let head = strings.split(rows[0], " ")
    if len(head) != 3 or head[0] != "paint"
        s.status = "not a picture"
        s.foreign = true
        return
    let w = 0
    let h = 0
    try
        w = int(num(head[1]))
        h = int(num(head[2]))
    catch e
        s.status = "not a picture"
        s.foreign = true
        return
    let cells = _paint_blank()
    for y in 0..math.min(h, _paint_h)
        if y + 1 < len(rows)
            let row = rows[y + 1]
            for x in 0..math.min(math.min(w, len(row)), _paint_w)
                let k = ord(row[x]) - 48
                if k >= 0 and k < len(_paint_colors)
                    cells[y * _paint_w + x] = k
    s.cells = cells
    s.status = "open"

fun _paint_text(s)
    let rows = ["paint {_paint_w} {_paint_h}"]
    for y in 0.._paint_h
        let row = ""
        for x in 0.._paint_w
            row = row + str(s.cells[y * _paint_w + x])
        append(rows, row)
    return strings.join(rows, "\n") + "\n"

# A file that is not a picture is never written over.
fun _paint_save(s)
    if s.foreign
        s.status = "not saved: not a picture"
        return
    try
        vfs.write(s.fs, s.path, _paint_text(s))
        s.status = "saved"
    catch e
        s.status = e.message

fun _paint_snapshot(s)
    append(s.undo, slice(s.cells, 0, len(s.cells)))
    if len(s.undo) > _paint_undo_keep
        remove(s.undo, 0)
    s.redo = []   # a new change ends what Ctrl+Y could bring back

# The cell under content point (x, y), or none outside the canvas.
fun _paint_cell_at(x, y)
    let cx = math.floor((x - _paint_left) / _paint_cell)
    let cy = math.floor((y - _paint_top) / _paint_cell)
    if cx < 0 or cy < 0 or cx >= _paint_w or cy >= _paint_h
        return none
    return [int(cx), int(cy)]

# The brush, a square of s.size cells, centered on (cx, cy) as near as it can be.
fun _paint_stamp(s, cx, cy)
    let k = s.color
    let a = int((s.size - 1) / 2)
    for dy in 0..s.size
        let y = cy - a + dy
        if y >= 0 and y < _paint_h
            for dx in 0..s.size
                let x = cx - a + dx
                if x >= 0 and x < _paint_w
                    s.cells[y * _paint_w + x] = k

# Stamps every cell on the way from one point to the next, so a quick drag leaves no gaps.
fun _paint_line(s, from, to)
    let dx = to[0] - from[0]
    let dy = to[1] - from[1]
    let n = math.max(math.abs(dx), math.abs(dy))
    if n == 0
        _paint_stamp(s, to[0], to[1])
        return
    for i in 0..n + 1
        _paint_stamp(s, from[0] + int(math.round(dx * i / n)), from[1] + int(math.round(dy * i / n)))

# The cell under content point (x, y), moved onto the canvas's nearest edge
# when it is outside: a shape's far end stays on the canvas.
fun _paint_cell_near(x, y)
    let cx = math.floor((x - _paint_left) / _paint_cell)
    let cy = math.floor((y - _paint_top) / _paint_cell)
    return [int(math.max(0, math.min(_paint_w - 1, cx))), int(math.max(0, math.min(_paint_h - 1, cy)))]

# The line or rectangle from s.anchor to c, drawn over the picture as it was at the press.
fun _paint_shape(s, c)
    s.cells = slice(s.base, 0, len(s.base))
    let a = s.anchor
    if s.tool == "line"
        _paint_line(s, a, c)
    else if s.tool == "fill rect"
        for y in math.min(a[1], c[1])..math.max(a[1], c[1]) + 1
            for x in math.min(a[0], c[0])..math.max(a[0], c[0]) + 1
                s.cells[y * _paint_w + x] = s.color
    else if s.tool == "oval" or s.tool == "fill oval"
        _paint_oval(s, a, c)
    else
        _paint_line(s, a, [c[0], a[1]])
        _paint_line(s, [c[0], a[1]], c)
        _paint_line(s, c, [a[0], c[1]])
        _paint_line(s, [a[0], c[1]], a)

# The ellipse that fits the box with corners a and c: the cells whose middle
# is inside it, or, for the outline, those of them with a side on a cell that
# is not (each stamped with the brush).
fun _paint_oval(s, a, c)
    let x0 = math.min(a[0], c[0])
    let x1 = math.max(a[0], c[0])
    let y0 = math.min(a[1], c[1])
    let y1 = math.max(a[1], c[1])
    let rx = (x1 - x0 + 1) / 2
    let ry = (y1 - y0 + 1) / 2
    let mx = x0 + rx
    let my = y0 + ry
    let inside = {}
    for y in y0..y1 + 1
        for x in x0..x1 + 1
            let dx = (x + 0.5 - mx) / rx
            let dy = (y + 0.5 - my) / ry
            if dx * dx + dy * dy <= 1.0001
                inside[str(y * _paint_w + x)] = true
    for y in y0..y1 + 1
        for x in x0..x1 + 1
            if str(y * _paint_w + x) in inside
                if s.tool == "fill oval"
                    s.cells[y * _paint_w + x] = s.color
                else
                    let edge = false
                    for n in [[x - 1, y], [x + 1, y], [x, y - 1], [x, y + 1]]
                        if n[0] < x0 or n[0] > x1 or n[1] < y0 or n[1] > y1 or not str(n[1] * _paint_w + n[0]) in inside
                            edge = true
                    if edge
                        _paint_stamp(s, x, y)

# Fill: every cell joined to (cx, cy) through cells of its color, side by side
# (not corner to corner), takes the chosen color.
fun _paint_fill(s, cx, cy)
    let from = s.cells[cy * _paint_w + cx]
    let to = s.color
    if from == to
        return
    let todo = [cy * _paint_w + cx]
    s.cells[cy * _paint_w + cx] = to
    while len(todo) > 0
        let i = pop(todo)
        let x = i % _paint_w
        let y = int((i - x) / _paint_w)
        for n in [[x - 1, y], [x + 1, y], [x, y - 1], [x, y + 1]]
            if n[0] >= 0 and n[1] >= 0 and n[0] < _paint_w and n[1] < _paint_h
                let j = n[1] * _paint_w + n[0]
                if s.cells[j] == from
                    s.cells[j] = to
                    append(todo, j)

# Which swatch (a color index) is at content point (x, y), or none.
fun _paint_swatch_at(x, y)
    if y < _swatch_top or y >= _swatch_top + _swatch
        return none
    let i = math.floor((x - _paint_left) / 18)
    if i < 0 or i >= len(_paint_colors) or x - _paint_left - i * 18 >= _swatch
        return none
    # swatches run black, red, ... brown, then the eraser last
    if i == len(_paint_colors) - 1
        return 0
    return int(i) + 1

fun _paint_click(s, x, y)
    s.last = none
    s.stroke = false
    s.anchor = none
    let sw = _paint_swatch_at(x, y)
    if sw != none
        s.color = sw
        return
    let c = _paint_cell_at(x, y)
    if c == none
        return
    if s.tool == "pick"
        # the color under the click, then back to the tool before; not an edit
        s.color = s.cells[c[1] * _paint_w + c[0]]
        s.tool = s.tool_before
        return
    if s.tool == "fill" and s.cells[c[1] * _paint_w + c[0]] == s.color
        return   # a fill that would change nothing is not an undo step
    _paint_snapshot(s)
    s.status = "edited"
    if s.tool == "fill"
        _paint_fill(s, c[0], c[1])
        return
    if s.tool != "brush"
        s.base = slice(s.cells, 0, len(s.cells))
        s.anchor = c
        _paint_shape(s, c)
        return
    _paint_stamp(s, c[0], c[1])
    s.last = c
    s.stroke = true

# Dragging off the canvas pauses the stroke; it goes on from where it comes back.
fun _paint_drag(s, x, y)
    if s.anchor != none
        _paint_shape(s, _paint_cell_near(x, y))
        return
    if not s.stroke
        return
    let c = _paint_cell_at(x, y)
    if c == none
        s.last = none
        return
    if s.last == none
        _paint_stamp(s, c[0], c[1])
    else
        _paint_line(s, s.last, c)
    s.last = c

# Save as: the typed name is a file in /home (".paint" is added when it has
# no ending), or a whole path when it starts with "/". A file there that is not
# a picture, or a folder, is never written over.
fun _paint_save_as(s, name)
    let path = name
    if not strings.starts_with(path, "/")
        path = "/home/" + path
    if not strings.contains(paths.base(path), ".")
        path = path + ".paint"
    if vfs.exists(s.fs, path)
        if vfs.is_dir(s.fs, path)
            s.status = "not saved: {paths.base(path)} is a folder"
            return
        let probe = {status: "", foreign: false, cells: none}
        _paint_load(probe, vfs.read(s.fs, path))
        if probe.foreign
            s.status = "not saved: {paths.base(path)} is not a picture"
            return
    let was = [s.path, s.foreign]
    s.path = path
    s.foreign = false
    _paint_save(s)
    if s.status != "saved"
        s.path = was[0]
        s.foreign = was[1]

fun _paint_name_key(s, k)
    if k == "return"
        let name = strings.trim(s.naming)
        s.naming = none
        if name == "" or strings.ends_with(name, "/")
            s.status = "not saved: no name"
            return
        _paint_save_as(s, name)
    else if k == "backspace"
        if len(s.naming) > 0
            s.naming = slice(s.naming, 0, len(s.naming) - 1)
    else if k == "space"
        s.naming = s.naming + " "
    else if len(k) == 1
        s.naming = s.naming + k

# Esc gives up typing a name; otherwise Paint does not take it.
fun _paint_escape(s)
    if s.naming == none
        return false
    s.naming = none
    return true

fun _paint_key(s, k)
    if s.naming != none
        _paint_name_key(s, k)
        return
    # with Shift or Caps Lock a letter works as its small one, but R and O
    # are the filled shapes
    if len(k) == 1 and k != "R" and k != "O" and strings.upper(k) == k
        k = strings.lower(k)
    if len(k) == 1 and ord(k) >= 49 and ord(k) <= 56
        s.color = ord(k) - 48
    else if k == "e" or k == "0"
        s.color = 0
    else if k == "+" or k == "=" or k == "]"
        s.size = math.min(4, s.size + 1)
    else if k == "-" or k == "["
        s.size = math.max(1, s.size - 1)   # [ and ] as in most paint programs
    else if k == "i"
        if s.tool != "pick"
            s.tool_before = s.tool
        s.tool = "pick"
    else if k == "f"
        s.tool = "fill"
    else if k == "b"
        s.tool = "brush"
    else if k == "l"
        s.tool = "line"
    else if k == "r"
        s.tool = "rect"
    else if k == "R"
        s.tool = "fill rect"
    else if k == "o"
        s.tool = "oval"
    else if k == "O"
        s.tool = "fill oval"
    else if k == "n"
        s.naming = ""
    else if k == "c"
        _paint_snapshot(s)
        s.cells = _paint_blank()
        s.status = "edited"
    else if k == "ctrl+z"
        if len(s.undo) > 0
            append(s.redo, s.cells)
            s.cells = pop(s.undo)
            s.status = "edited"
    else if k == "ctrl+y"
        # what Ctrl+Z took back, newest first, until the next change
        if len(s.redo) > 0
            append(s.undo, s.cells)
            s.cells = pop(s.redo)
            s.status = "edited"
    else if k == "ctrl+s"
        _paint_save(s)

fun _paint_lines(s)
    if s.naming != none
        return ["Paint save as: {s.naming}_ (return saves, esc cancels)"]
    let tool = str(s.size)
    if s.tool == "fill" or s.tool == "pick"
        tool = s.tool
    else if s.tool == "fill rect" or s.tool == "fill oval"
        tool = "filled " + slice(s.tool, 5, len(s.tool))
    else if s.tool != "brush"
        tool = "{s.tool} {s.size}"
    return ["Paint [{s.status}] {_paint_names[s.color]} {tool} {paths.base(s.path)}"]

# The swatches (the chosen one framed), the canvas frame, white, and then runs
# of one color along each row, so a picture is a few hundred boxes at most.
fun _paint_paint(s)
    let out = []
    for i in 0..len(_paint_colors)
        let k = i + 1
        if i == len(_paint_colors) - 1
            k = 0
        let x = _paint_left + i * 18
        if k == s.color
            append(out, [x - 2, _swatch_top - 2, _swatch + 4, _swatch + 4, 60, 90, 160])
        let c = _paint_colors[k]
        append(out, [x, _swatch_top, _swatch, _swatch, 120, 120, 130])
        append(out, [x + 1, _swatch_top + 1, _swatch - 2, _swatch - 2, c[0], c[1], c[2]])
    let cw = _paint_w * _paint_cell
    let ch = _paint_h * _paint_cell
    append(out, [_paint_left - 1, _paint_top - 1, cw + 2, ch + 2, 120, 120, 130])
    append(out, [_paint_left, _paint_top, cw, ch, 255, 255, 255])
    for y in 0.._paint_h
        let x = 0
        while x < _paint_w
            let k = s.cells[y * _paint_w + x]
            let e = x + 1
            while e < _paint_w and s.cells[y * _paint_w + e] == k
                e = e + 1
            if k != 0
                let c = _paint_colors[k]
                append(out, [_paint_left + x * _paint_cell, _paint_top + y * _paint_cell, (e - x) * _paint_cell, _paint_cell, c[0], c[1], c[2]])
            x = e
    return out

# ---- Snake ----
# The snake moves one cell at a time on a _snake_w by _snake_h board, on the
# clock from wm.tick, and only while its window is focused. Arrows or W A S D
# turn it (not straight back), Space pauses and goes on, R starts again after
# a game ends. Eating the red food makes it one longer and a little faster;
# running into a wall or itself ends the game. The best score is kept in
# _snake_best_path in the desktop's files, read when a game starts and
# written when it is beaten.
let _snake_w = 24
let _snake_h = 16
let _snake_cell = 8
let _snake_left = 6
let _snake_top = 36
let _snake_best_path = "/home/snake-best.txt"
let _snake_dirs = {up: [0, -1], down: [0, 1], left: [-1, 0], right: [1, 0], w: [0, -1], s: [0, 1], a: [-1, 0], d: [1, 0]}

# The saved best score: 0 when there is no file or it holds no whole number.
fun _snake_read_best(fs)
    try
        if vfs.exists(fs, _snake_best_path) and not vfs.is_dir(fs, _snake_best_path)
            let n = num(strings.trim(vfs.read(fs, _snake_best_path)))
            if n >= 0 and n % 1 == 0
                return int(n)
    catch e
        return 0
    return 0

fun _snake_init()
    let s = {now: 0, seed: 1, fs: _shell_fs, best: 0}
    _snake_reset(s)
    return s

fun _snake_reset(s)
    # body runs from the tail to the head, which is last
    s.body = [[3, 8], [4, 8], [5, 8]]
    s.dir = [1, 0]
    s.turns = []     # turns pressed since the last step, at most 2 kept
    s.score = 0
    s.state = "ready"
    s.next_at = none
    s.best = math.max(s.best, _snake_read_best(s.fs))
    s.seed = (s.seed * 7 + s.now) % 2147483647 + 1
    _snake_place_food(s)

# A little LCG so a game can be played again the same way in a test.
fun _snake_rand(s, n)
    s.seed = (s.seed * 48271) % 2147483647
    return s.seed % n

fun _snake_on(s, c)
    for b in s.body
        if b[0] == c[0] and b[1] == c[1]
            return true
    return false

# Food goes on a free cell, picked among the free ones, so it never lands on the snake.
fun _snake_place_food(s)
    let free = []
    for y in 0.._snake_h
        for x in 0.._snake_w
            if not _snake_on(s, [x, y])
                append(free, [x, y])
    if len(free) == 0
        s.food = none
        return
    s.food = free[_snake_rand(s, len(free))]

fun _snake_interval(s) = math.max(70, 150 - 5 * s.score)

fun _snake_step(s)
    if len(s.turns) > 0
        s.dir = remove(s.turns, 0)
    let h = s.body[len(s.body) - 1]
    let n = [h[0] + s.dir[0], h[1] + s.dir[1]]
    let eats = s.food != none and n[0] == s.food[0] and n[1] == s.food[1]
    let tail = none
    if not eats
        tail = remove(s.body, 0)   # the tail moves on first, so the head may take its cell
    if n[0] < 0 or n[1] < 0 or n[0] >= _snake_w or n[1] >= _snake_h or _snake_on(s, n)
        if tail != none
            insert(s.body, 0, tail)   # the game ends with the snake where it was
        s.state = "over"
        return
    append(s.body, n)
    if eats
        s.score = s.score + 1
        if s.score > s.best
            s.best = s.score
            try
                vfs.write(s.fs, _snake_best_path, "{s.best}\n")
            catch e
                s.best = s.best   # a best that cannot be saved still shows
        _snake_place_food(s)
        if s.food == none
            s.state = "won"

fun _snake_tick(s, ms)
    s.now = ms
    if s.state != "playing"
        s.next_at = none
        return
    let iv = _snake_interval(s)
    # after a pause, a lost focus or a slow frame, start the beat again instead of catching up
    if s.next_at == none or ms - s.next_at > 3 * iv
        s.next_at = ms + iv
        return
    while ms >= s.next_at and s.state == "playing"
        _snake_step(s)
        s.next_at = s.next_at + _snake_interval(s)

fun _snake_key(s, k)
    if len(k) == 1
        k = strings.lower(k)   # Shift or Caps Lock: W, A, S, D and R work the same
    if k in _snake_dirs
        if s.state == "over" or s.state == "won"
            return
        let d = _snake_dirs[k]
        let last = s.dir
        if len(s.turns) > 0
            last = s.turns[len(s.turns) - 1]
        # no turning straight back, and no repeat of the same way
        if d[0] != -last[0] or d[1] != -last[1]
            if (d[0] != last[0] or d[1] != last[1]) and len(s.turns) < 2
                append(s.turns, d)
        if s.state == "ready"
            s.state = "playing"
    else if k == "space" or k == "p"
        if s.state == "playing"
            s.state = "paused"
        else if s.state == "paused" or s.state == "ready"
            s.state = "playing"
    else if k == "r" or k == "return"
        if s.state == "over" or s.state == "won"
            _snake_reset(s)
    else if k == "n"
        _snake_reset(s)   # a new game at any time, giving up the one going on

fun _snake_click(s, x, y) = none

fun _snake_lines(s)
    let help = {ready: "arrows or space to start", playing: "space to pause", paused: "paused: space to go on", over: "game over: r to play", won: "you won! r to play again"}
    return ["Snake  score {s.score}  best {s.best}", help[s.state]]

fun _snake_paint(s)
    let c = _snake_cell
    let out = [[_snake_left - 1, _snake_top - 1, _snake_w * c + 2, _snake_h * c + 2, 90, 90, 100], [_snake_left, _snake_top, _snake_w * c, _snake_h * c, 30, 70, 40]]
    if s.food != none
        append(out, [_snake_left + s.food[0] * c + 1, _snake_top + s.food[1] * c + 1, c - 2, c - 2, 220, 50, 50])
    let n = len(s.body)
    for i in 0..n
        let b = s.body[i]
        if i == n - 1
            append(out, [_snake_left + b[0] * c, _snake_top + b[1] * c, c, c, 250, 230, 90])
        else
            append(out, [_snake_left + b[0] * c + 1, _snake_top + b[1] * c + 1, c - 2, c - 2, 120, 210, 110])
    return out

let clicker = {name: "Clicker", width: 180, height: 60, init: _clicker_init, lines: _clicker_lines, on_click: _clicker_click, on_key: _clicker_key}
let notes = {name: "Notes", width: 220, height: 60, init: _notes_init, lines: _notes_lines, on_click: _notes_click, on_key: _notes_key, tail: true, pinned: 1}
let terminal = {name: "Terminal", width: 280, height: 120, init: _term_init, lines: _term_lines, on_click: _term_click, on_key: _term_key, tail: true, pinned: 0}
let files_app = {name: "Files", width: 260, height: 140, init: _files_init, lines: _files_lines, on_click: _files_click, on_key: _files_key, selected: _files_selected}
let editor = {name: "Editor", width: 320, height: 80, init: _editor_init, lines: _editor_lines, on_click: _editor_click, on_key: _editor_key, on_escape: _editor_escape, tail: true, pinned: 1, marks: _editor_marks}
let ide = {name: "IDE", width: 320, height: 200, init: _ide_init, lines: _ide_lines, on_click: _editor_click, on_key: _ide_key, on_escape: _ide_escape, tail: true, pinned: 1, marks: _editor_marks}
let paint_app = {name: "Paint", width: 256, height: 190, init: _paint_init, lines: _paint_lines, on_click: _paint_click, on_key: _paint_key, on_drag: _paint_drag, on_escape: _paint_escape, paint: _paint_paint}
let snake = {name: "Snake", width: 210, height: 170, init: _snake_init, lines: _snake_lines, on_click: _snake_click, on_key: _snake_key, on_tick: _snake_tick, paint: _snake_paint}
fun default_apps() = [clicker, notes, terminal, files_app, editor, ide, paint_app, snake]
