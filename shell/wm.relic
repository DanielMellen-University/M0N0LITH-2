# shell/wm.relic: the MONOLITH 2 desktop model (M11). No drawing here, so it
# runs and tests without SDL. shell/desktop.relic draws it with std/graphics.
#
# A desktop has apps (what the Start menu can launch) and windows (running
# apps, last one on top). An app is a map:
#   {name, width, height, init(), lines(state), on_click(state, x, y), on_key(state, key)}
# lines() gives the text rows for the window. visible_lines(w) cuts them to
# what fits, and that is what desktop.relic draws. An app may also have:
#   tail: true, pinned: n   keep the first n lines and the last ones (Terminal, Editor, Notes)
#   selected(state)         the line to keep in view (Files)
# visible_lines puts the window's rows and cols in the state of a tail app,
# and cols in the state of a selected app, before it calls lines().
# Input comes in as key(d, name) and click(d, x, y), or as a graphics event
# through handle(d, e). Drag and resize use press (via click), motion, and
# release. drag on the desktop is none, or {id, mode, ox, oy} with mode "move"
# or "resize".
# When the tabs would be narrower than min_tab, the ones that do not fit go
# behind a "+N" button at the end of the bar. It opens a list of those windows
# (d.overflow_open). The focused window always keeps a tab.
# A minimized window stays in windows and on the taskbar but is not drawn,
# takes no clicks or keys, and is never focused.

use std/strings
use std/time
use std/vfs
use std/paths
use std/math

let bar_height = 24     # taskbar along the bottom
let title_height = 16   # window title bar
let start_width = 56
let menu_row = 18
let tab_width = 90
let min_tab = 40         # the narrowest a tab gets: four letters of the name
let overflow_width = 40  # the "+N" button at the end of the tab strip (wider for a long N)
let overflow_col = 80    # a column of the hidden-windows list
let grip = 12           # bottom-right resize handle
let min_width = 80
let min_height = 40
let cascade_steps = 10   # windows per cascade before it wraps
let char_width = 8       # the font's characters
let line_height = 14     # text rows are this far apart
let text_left = 6        # text starts this far in from a window's left edge
let text_top = 6         # and this far below the title bar

# Shared in-memory VFS for Files, Editor and Terminal (not the host disk).
let _shell_fs = vfs.new()
# The file Editor opens next. Files sets it when you open a file.
let _shell_open = {path: "/home/welcome.txt"}

# p if it is a folder, else its nearest parent that is. Used when a folder
# an app is in gets removed or moved from another app.
fun _existing_dir(fs, p)
    let x = p
    while not vfs.is_dir(fs, x)
        x = paths.dir(x)
    return x

fun new_desktop(width, height, apps)
    return {width: width, height: height, apps: apps, windows: [], menu_open: false, overflow_open: false, next_id: 1, drag: none, clicks: 1}

fun bar_top(d) = d.height - bar_height

# Start menu rows, bottom up from the taskbar: [x, y, w, h] of row i.
fun menu_item_box(d, i)
    let n = len(d.apps)
    return [0, bar_top(d) - (n - i) * menu_row, 120, menu_row]

# Taskbar button i: [x, y, w, h]. Buttons run left to right in the order of shown_tabs(d).
fun tab_box(d, i)
    let w = tab_width_for(d)
    return [start_width + 4 + i * (w + 4), bar_top(d) + 3, w, bar_height - 6]

# How many tabs fit at min_tab, leaving room for the overflow button when they do not all fit.
fun tab_capacity(d)
    let room = d.width - start_width - 4
    if len(d.windows) * (min_tab + 4) <= room
        return len(d.windows)
    return math.max(1, int((room - overflow_width_for(d) - 4) / (min_tab + 4)))

# The tabs that get a button: all of them while they fit, else the first ones in
# launch order, with the focused window's tab in place of the last one.
fun shown_tabs(d)
    let t = tabs(d)
    let k = tab_capacity(d)
    if k >= len(t)
        return t
    let f = focused(d)
    let out = []
    for i in 0..k
        append(out, t[i])
    if f != none
        let present = false
        for w in out
            if w.id == f.id
                present = true
        if not present
            out[k - 1] = f
    return out

# The windows that have no tab, in launch order. They are behind the overflow button.
fun hidden_tabs(d)
    let shown = shown_tabs(d)
    let out = []
    for w in tabs(d)
        let seen = false
        for s in shown
            if s.id == w.id
                seen = true
        if not seen
            append(out, w)
    return out

# The "+N" button [x, y, w, h], at the right end of the bar, or none when every window has a tab.
fun overflow_box(d)
    if tab_capacity(d) >= len(d.windows)
        return none
    let w = overflow_width_for(d)
    return [d.width - w - 2, bar_top(d) + 3, w, bar_height - 6]

fun overflow_label(d) = "+{len(d.windows) - tab_capacity(d)}"

# The +N button's width: overflow_width, or wider when the window count has
# enough digits that the label (drawn 6 pixels in) would not fit. It goes by
# the window count, which N never passes, so the width does not depend on N.
fun overflow_width_for(d) = math.max(overflow_width, 8 + (1 + len("{len(d.windows)}")) * char_width)

# How many windows have no tab: the same as len(hidden_tabs(d)), without building
# the list, since the list layout below asks for it once per row.
fun _hidden_count(d) = len(d.windows) - math.min(len(d.windows), tab_capacity(d))

# Rows in a column of the hidden-windows list, and columns it takes (a new column
# starts to the left once the rows reach the top of the desktop).
fun overflow_rows(d) = math.max(1, math.min(_hidden_count(d), int(bar_top(d) / menu_row)))
fun overflow_cols(d) = int((_hidden_count(d) + overflow_rows(d) - 1) / overflow_rows(d))

# Row i of the hidden-windows list: [x, y, w, h]. Column 0 is at the right edge,
# the first row at the top, like the Start menu.
fun overflow_item_box(d, i)
    let rows = overflow_rows(d)
    let col = int(i / rows)
    return [d.width - (col + 1) * overflow_col, bar_top(d) - (rows - i % rows) * menu_row, overflow_col, menu_row]

# How many list rows get drawn and take clicks: what fits across the desktop.
fun overflow_shown(d) = math.min(_hidden_count(d), overflow_rows(d) * int(d.width / overflow_col))

# Tabs share the bar: tab_width while they fit, narrower after, never under
# min_tab, except on a bar too narrow for even one min_tab tab beside the +N
# button: there the one tab gets what is left, so it never overlaps the button.
fun tab_width_for(d)
    let n = len(d.windows)
    if n == 0
        return tab_width
    let shown = math.min(n, tab_capacity(d))
    let room = d.width - start_width - 4
    if shown < n
        room = room - overflow_width_for(d) - 4
    let w = int(room / shown) - 4
    if w > tab_width
        return tab_width
    if w < min_tab
        if shown < n
            return math.max(1, w)
        return min_tab
    return w

# A window's tab text, cut to what fits in its tab (the font is 8 pixels wide);
# empty in a tab too narrow for one letter.
fun tab_label(d, w)
    let room = math.max(0, int((tab_width_for(d) - char_width) / char_width))
    return slice(w.app.name, 0, room)

fun close_box(w) = [w.x + w.width - title_height, w.y, title_height, title_height]

# The window's name cut to the room the title bar has left of the _ and x boxes
# (desktop.relic draws it 4 pixels in).
fun title_text(w)
    let room = int((w.width - 2 * title_height - 4) / char_width)
    return slice(w.app.name, 0, math.max(0, room))

# The _ box, just left of the x box. It minimizes the window.
fun minimize_box(w) = [w.x + w.width - 2 * title_height, w.y, title_height, title_height]

fun resize_box(w) = [w.x + w.width - grip, w.y + title_height + w.height - grip, grip, grip]

fun _inside(b, x, y) = x >= b[0] and x < b[0] + b[2] and y >= b[1] and y < b[1] + b[3]

# New windows cascade down and right, then start over after cascade_steps, so
# they never open off the desktop.
fun launch(d, app)
    let n = _cascade_slot(d)
    let w = {id: d.next_id, app: app, state: app.init(), x: 40 + n * 24, y: 30 + n * 20, width: app.width, height: app.height, minimized: false}
    d.next_id = d.next_id + 1
    # Leave room for the minimum size before fitting a cascaded window.
    w.x = math.min(w.x, math.max(0, d.width - min_width))
    w.y = math.min(w.y, math.max(0, bar_top(d) - title_height - min_height))
    _clamp_size(d, w)   # a small desktop cuts the window to fit, as a resize would
    _clamp_pos(d, w)
    append(d.windows, w)
    return w

# The cascade step for a new window: the window count, or the next step after it
# that no window is sitting on. Counting alone put a new window exactly on top of
# another one after a close (open three, close the first, open one more).
fun _cascade_slot(d)
    let n = len(d.windows) % cascade_steps
    for k in 0..cascade_steps
        let slot = (n + k) % cascade_steps
        let taken = false
        for w in d.windows
            if w.x == 40 + slot * 24 and w.y == 30 + slot * 20
                taken = true
        if not taken
            return slot
    return n

# The top window that is not minimized, or none.
fun focused(d)
    let i = len(d.windows) - 1
    while i >= 0
        if not d.windows[i].minimized
            return d.windows[i]
        i = i - 1
    return none

fun _raise(d, i)
    let w = d.windows[i]
    remove(d.windows, i)
    append(d.windows, w)

fun _index_of(d, id)
    for i in 0..len(d.windows)
        if d.windows[i].id == id
            return i
    return -1

fun _end_drag_for(d, id)
    if d.drag != none and d.drag.id == id
        d.drag = none

fun close(d, id)
    let i = _index_of(d, id)
    if i >= 0
        remove(d.windows, i)
    _end_drag_for(d, id)
    if overflow_box(d) == none
        d.overflow_open = false

# Hide a window. Focus goes to the next visible window down.
fun minimize(d, id)
    let i = _index_of(d, id)
    if i < 0
        return
    d.windows[i].minimized = true
    _end_drag_for(d, id)

# Show a window again and bring it to the front.
fun restore(d, id)
    let i = _index_of(d, id)
    if i < 0
        return
    d.windows[i].minimized = false
    _raise(d, i)

# Keep enough of the title bar on screen so the window stays reachable: 40
# pixels of it at either edge. Off the left edge the _ and x boxes sit in the part
# that shows, so 40 more than those are kept there (it used to leave 8 to grab).
fun _clamp_pos(d, w)
    let max_x = d.width - 40
    let min_x = 40 + 2 * title_height - w.width
    if w.x < min_x
        w.x = min_x
    if w.x > max_x
        w.x = max_x
    let max_y = bar_top(d) - title_height
    if w.y < 0
        w.y = 0
    if w.y > max_y
        w.y = max_y

fun _clamp_size(d, w)
    if w.width < min_width
        w.width = min_width
    if w.height < min_height
        w.height = min_height
    if w.x + w.width > d.width
        w.width = d.width - w.x
        if w.width < min_width
            w.width = min_width
    let room = bar_top(d) - w.y - title_height
    if w.height > room
        w.height = room
        if w.height < min_height
            w.height = min_height

# The windows in taskbar order: launch order (by id), whatever their stacking is.
fun tabs(d)
    let out = []
    for w in d.windows
        let placed = false
        for i in 0..len(out)
            if not placed and w.id < out[i].id
                insert(out, i, w)
                placed = true
        if not placed
            append(out, w)
    return out

fun _begin_drag(d, w, mode, x, y)
    d.drag = {id: w.id, mode: mode, ox: x - w.x, oy: y - w.y}
    if mode == "resize"
        d.drag.ox = x - (w.x + w.width)
        d.drag.oy = y - (w.y + title_height + w.height)

# A mouse click at (x, y). Gives a short word saying what it hit:
#   "launch" a Start menu row (opened that app)   "start" the Start button
#   "tab" a taskbar button that showed its window  "minimize" the _ box, or a tab of the window on top
#   "overflow" the +N button (toggled the hidden-windows list)   "tab" also a row of that list
#   "bar" empty taskbar   "close" the x box   "title" and "resize" start a drag
#   "app" inside a window (its on_click ran)   "desktop" nothing
# Call motion and release after a "title" or "resize". A press first drops any drag still on.
fun click(d, x, y)
    d.drag = none   # a new press ends a drag whose release never came (let go outside the window)
    let menu_was_open = d.menu_open
    let overflow_was_open = d.overflow_open
    d.overflow_open = false   # any press closes the list; the button below reopens it
    if x < 0 or x >= d.width or y < 0 or y >= d.height
        d.menu_open = false
        return "desktop"
    if overflow_was_open
        let r = _click_overflow_list(d, x, y)
        if r != none
            return r
    if menu_was_open
        d.menu_open = false
        let r = _click_menu(d, x, y)
        if r != none
            return r
    if y >= bar_top(d)
        return _click_bar(d, x, y, menu_was_open, overflow_was_open)
    return _click_windows(d, x, y)

# A press while the Start menu is open: the app it picked, or none.
fun _click_menu(d, x, y)
    for i in 0..len(d.apps)
        if _inside(menu_item_box(d, i), x, y)
            launch(d, d.apps[i])
            return "launch"
    return none

# A press while the hidden-windows list is open: the window it picked (restored
# and in front, so it gets a tab), or none.
fun _click_overflow_list(d, x, y)
    let hidden = hidden_tabs(d)
    for i in 0..overflow_shown(d)
        if _inside(overflow_item_box(d, i), x, y)
            restore(d, hidden[i].id)
            return "tab"
    return none

# A press on the taskbar: Start (which toggles the menu), the +N button (which
# toggles the list), a tab, or empty bar.
fun _click_bar(d, x, y, menu_was_open, overflow_was_open)
    if x < start_width
        d.menu_open = not menu_was_open
        return "start"
    let ob = overflow_box(d)
    if ob != none and _inside(ob, x, y)
        d.overflow_open = not overflow_was_open
        return "overflow"
    let t = shown_tabs(d)
    for i in 0..len(t)
        if _inside(tab_box(d, i), x, y)
            let f = focused(d)
            if f != none and f.id == t[i].id
                minimize(d, t[i].id)
                return "minimize"
            restore(d, t[i].id)
            return "tab"
    return "bar"

# A press above the taskbar: the top window under it gets raised and takes the press.
fun _click_windows(d, x, y)
    let i = len(d.windows) - 1
    while i >= 0
        let w = d.windows[i]
        if not w.minimized and _inside([w.x, w.y, w.width, w.height + title_height], x, y)
            _raise(d, i)
            return _click_in(d, d.windows[len(d.windows) - 1], x, y)
        i = i - 1
    return "desktop"

# A press inside window w, already on top: its boxes first, then the app.
fun _click_in(d, w, x, y)
    if _inside(close_box(w), x, y)
        close(d, w.id)
        return "close"
    if _inside(minimize_box(w), x, y)
        minimize(d, w.id)
        return "minimize"
    if y < w.y + title_height
        _begin_drag(d, w, "move", x, y)
        return "title"
    if _inside(resize_box(w), x, y)
        _begin_drag(d, w, "resize", x, y)
        return "resize"
    if "selected" in w.app
        let lines = w.app.lines(w.state)
        # The rows under the pointer may have changed since the last frame.
        if "drawn" in w.state and (w.state.drawn != lines or w.state.drawn_rows != rows_fit(w))
            return "app"
        w.state.first = _first_row(w, lines)
        w.state.rows = rows_fit(w)
        w.state.clicks = d.clicks
    w.app.on_click(w.state, x - w.x, y - w.y - title_height)
    return "app"

# Mouse move while a button may be held. Updates a drag or resize in progress.
fun motion(d, x, y)
    if d.drag == none
        return
    let i = _index_of(d, d.drag.id)
    if i < 0
        d.drag = none
        return
    let w = d.windows[i]
    if d.drag.mode == "move"
        w.x = x - d.drag.ox
        w.y = y - d.drag.oy
        _clamp_pos(d, w)
    else if d.drag.mode == "resize"
        w.width = x - w.x - d.drag.ox
        w.height = y - w.y - title_height - d.drag.oy
        _clamp_size(d, w)

# Mouse button up ends any drag or resize.
fun release(d)
    d.drag = none

# Escape closes the Start menu or the hidden-windows list if one is open, and
# gives true; desktop.relic quits on an Escape that closed nothing. Quitting
# drops the whole in-memory filesystem, so it should not be how a menu closes.
fun dismiss(d)
    let was_open = d.menu_open or d.overflow_open
    d.menu_open = false
    d.overflow_open = false
    return was_open

# A key press goes to the window on top.
fun key(d, k)
    let w = focused(d)
    if w != none
        w.app.on_key(w.state, k)

# ---- input events ----

# Keys that are not typed text; the apps handle these by name. Letters, digits,
# punctuation and space come as text events, which carry shift, layout and Unicode.
let _named_keys = ["return", "backspace", "tab", "up", "down", "left", "right", "delete"]
let _modifier_keys = ["left ctrl", "right ctrl", "left shift", "right shift", "left alt", "right alt", "left gui", "right gui"]

# The app key for a key_down event, or none when it needs no key. With ctrl held
# the key is "ctrl+" and its name ("ctrl+s"); text events do not come with ctrl.
# Ctrl and Alt together is AltGr on Windows, which types characters such as the
# Polish s with an accent (AltGr+S): that comes as text, so it is not Ctrl+S.
fun key_of_event(e)
    if e.type != "key_down"
        return none
    let altgr = e.ctrl and "alt" in e and e.alt
    if e.ctrl and not altgr and not e.key in _modifier_keys
        return "ctrl+" + e.key
    if e.key == "keypad enter"
        return "return"
    if e.key in _named_keys
        return e.key
    return none

# Feeds one graphics event to the desktop: typed text and named keys go to the
# window on top, the left mouse button clicks, drags and releases. Gives the
# click result word for a click, else none.
fun handle(d, e)
    if e.type == "text"
        for ch in e.text
            if ch == " "
                key(d, "space")
            else
                key(d, ch)
    else if e.type == "key_down"
        let k = key_of_event(e)
        if k != none
            key(d, k)
    else if e.type == "mouse_down" and e.button == 1
        # clicks is 2 for the second press of a double-click (3 for a triple)
        d.clicks = 1
        if "clicks" in e
            d.clicks = e.clicks
        let r = click(d, e.x, e.y)
        d.clicks = 1
        return r
    else if e.type == "mouse_move"
        motion(d, e.x, e.y)
    else if e.type == "mouse_up" and e.button == 1
        release(d)
    return none

# ---- what fits in a window ----

# desktop.relic draws row r at y = text_top + r * line_height under the title
# bar, and each character char_width wide from text_left. A row counts as
# fitting with 4 pixels to spare below it, a column with 2 to spare on the right.
fun rows_fit(w) = math.max(1, int((w.height - 4) / line_height))
fun cols_fit(w) = math.max(1, int((w.width - text_left - 2) / char_width))

fun _fit(text, cols, keep_end)
    if len(text) <= cols
        return text
    if keep_end
        return slice(text, len(text) - cols, len(text))
    return slice(text, 0, cols)

# For a list app (one with selected): the index of the first list line shown
# under the title line, so the selected line is in view.
fun _first_row(w, lines)
    let avail = math.max(1, rows_fit(w) - 1)
    let sel = math.min(math.max(w.app.selected(w.state), 1), len(lines) - 1)
    let first = math.min(math.max(1, sel - avail + 1), len(lines) - avail)
    return math.max(first, 1)

# The lines of a window that fit it. An app with tail: true is one where you
# type at the end (Terminal, Editor, Notes): it keeps its first pinned lines
# and the last ones, and the last line, which has the cursor, keeps its end.
# An app with a selected(state) call (Files) keeps its title line and scrolls
# just far enough to show the selected line. Other apps show their first lines
# and the start of each line.
fun visible_lines(w)
    let rows = rows_fit(w)
    let tail = "tail" in w.app and w.app.tail
    if tail
        # lets an app build only the lines that can show, and wrap at the window's width
        w.state.rows = rows
    if tail or "selected" in w.app
        w.state.cols = cols_fit(w)   # Files shortens its title path to this
    let lines = w.app.lines(w.state)
    if "selected" in w.app
        w.state.drawn = lines
        w.state.drawn_rows = rows
    let cols = cols_fit(w)
    let out = []
    for i in _shown(w, lines, rows, tail)
        append(out, _fit(lines[i], cols, tail and i == len(lines) - 1))
    return out

# The indexes of the lines visible_lines shows, in order.
fun _shown(w, lines, rows, tail)
    let shown = []
    if len(lines) <= rows
        for i in 0..len(lines)
            append(shown, i)
    else if "selected" in w.app
        append(shown, 0)
        let first = _first_row(w, lines)
        for i in first..first + math.max(1, rows - 1)
            append(shown, i)
    else if not tail
        for i in 0..rows
            append(shown, i)
    else
        let pinned = math.min(w.app.pinned, rows - 1)
        for i in 0..pinned
            append(shown, i)
        for i in len(lines) - (rows - pinned)..len(lines)
            append(shown, i)
    return shown

# ---- small apps ----

fun _clicker_init() = {count: 0}
fun _clicker_lines(s) = ["Clicks: {s.count}", "Click here to count."]
fun _clicker_click(s, x, y)
    s.count = s.count + 1
fun _clicker_key(s, k)
    if k == "space"
        s.count = s.count + 1

# What typing key k does to text: backspace drops the last character, space and
# any single character except a newline are added. Return is handled separately
# by the Editor; Notes and Terminal keep their input on one line.
fun _typed(text, k)
    if k == "backspace"
        return slice(text, 0, math.max(0, len(text) - 1))
    if k == "space"
        return text + " "
    if len(k) == 1 and k != "\n"
        return text + k
    return text

fun _notes_init() = {text: ""}
fun _notes_lines(s) = ["Type something:", s.text + "_"]
fun _notes_click(s, x, y)
    return none
fun _notes_key(s, k)
    s.text = _typed(s.text, k)

# Seconds since 1970 as "2026-10-27 05:12:16 UTC" (days to a date by Howard Hinnant's civil_from_days).
fun format_time(secs)
    let total = math.max(0, int(secs))
    let days = int(total / 86400)
    let rest = total - days * 86400
    let z = days + 719468
    let era = int(z / 146097)
    let doe = z - era * 146097
    let yoe = int((doe - int(doe / 1460) + int(doe / 36524) - int(doe / 146096)) / 365)
    let doy = doe - (365 * yoe + int(yoe / 4) - int(yoe / 100))
    let mp = int((5 * doy + 2) / 153)
    let day = doy - int((153 * mp + 2) / 5) + 1
    let month = mp + 3
    if month > 12
        month = month - 12
    let year = yoe + era * 400
    if month <= 2
        year = year + 1
    return "{year}-{_two(month)}-{_two(day)} {_two(int(rest / 3600))}:{_two(int((rest % 3600) / 60))}:{_two(rest % 60)} UTC"

fun _two(n)
    if n < 10
        return "0{n}"
    return "{n}"

# Relic-native terminal (no host process spawn). It works on the shared VFS
# from a current folder that starts at /home. Paths may be relative to it.
fun _term_init() = {buf: ["Terminal. Type help."], input: "", cwd: "/home", fs: _shell_fs, cols: term_width}

# A line cut into pieces of at most width characters, so a long line wraps
# in the window instead of losing its end.
fun _wrap(line, width)
    let w = math.max(1, width)
    if len(line) <= w
        return [line]
    let out = []
    let at = 0
    while at < len(line)
        append(out, slice(line, at, math.min(len(line), at + w)))
        at = at + w
    return out

# The last k pieces _wrap(line, width) would give, without cutting the rest.
fun _wrap_last(line, width, k)
    let w = math.max(1, width)
    let n = int((len(line) + w - 1) / w)
    if n <= 1
        return [line]
    let out = []
    for p in math.max(0, n - k)..n
        append(out, slice(line, p * w, math.min(len(line), (p + 1) * w)))
    return out

# The output and the prompt, wrapped to cols. Once visible_lines has set rows,
# only the last rows rows are built: wrapping all 200 kept lines each frame took
# about 0.24 s after cat of a file with one 200,000-character line.
fun _term_lines(s)
    s.cwd = _existing_dir(s.fs, s.cwd)   # another Terminal may have removed or moved it
    let prompt = s.cwd + "> " + s.input + "_"
    let out = []
    if not "rows" in s or s.rows <= 0
        for line in s.buf
            for piece in _wrap(line, s.cols)
                append(out, piece)
        for piece in _wrap(prompt, s.cols)
            append(out, piece)
        return out
    let parts = [_wrap_last(prompt, s.cols, s.rows)]   # last line first
    let have = len(parts[0])
    let i = len(s.buf) - 1
    while i >= 0 and have < s.rows
        let p = _wrap_last(s.buf[i], s.cols, s.rows - have)
        append(parts, p)
        have = have + len(p)
        i = i - 1
    let j = len(parts) - 1
    while j >= 0
        for piece in parts[j]
            append(out, piece)
        j = j - 1
    return out

fun _term_click(s, x, y)
    return none

# Older output falls off the top, so `cat` of a big file cannot grow the buffer (and the frame time) without limit.
let term_history = 200

fun _term_reply(s, line)
    append(s.buf, line)
    if len(s.buf) > term_history
        s.buf = slice(s.buf, len(s.buf) - term_history, len(s.buf))

fun _term_path(s, p) = paths.normalize(paths.join(s.cwd, p))

# A word ending in / names a folder, but normalizing drops the slash, so without
# this check `rm notes.txt/` removed the file and `touch new/` made one. True (after
# printing the error) when word ends in / and is a file, or is not there and the
# command would create a file from it.
fun _term_not_folder(s, cmd, word, creates)
    if not (strings.ends_with(word, "/") or strings.ends_with(word, "\\"))
        return false
    let p = _term_path(s, word)
    if vfs.is_dir(s.fs, p) or not (creates or vfs.exists(s.fs, p))
        return false
    if vfs.exists(s.fs, p)
        _term_reply(s, cmd + ": not a folder: " + p)
    else
        _term_reply(s, cmd + ": no folder: " + p)   # touch new/ when there is no new
    return true

# cd and ls accept an optional path, with different defaults.
fun _term_optional_path(s, parts, default)
    if len(parts) > 1
        return _term_path(s, parts[1])
    return default

# True when the command got exactly n words after it, else prints usage. A word
# too many is an error too: `rm a b` must not quietly remove only a.
fun _term_args(s, parts, n, usage)
    if len(parts) - 1 == n
        return true
    _term_reply(s, "usage: " + usage)
    return false

# How many characters of output fit a new Terminal window (280 pixels), so ls
# does not run off the right edge where the names could not be read.
let term_width = 34

# The words joined with two spaces, in as few lines of at most width characters
# as fit; a word longer than that gets a line to itself.
fun _pack(words, width)
    let lines = []
    let line = ""
    for w in words
        if line == ""
            line = w
        else if len(line) + 2 + len(w) <= width
            line = line + "  " + w
        else
            append(lines, line)
            line = w
    if line != ""
        append(lines, line)
    return lines

fun _term_ls(s, parts)
    if len(parts) > 1 and _term_not_folder(s, "ls", parts[1], false)
        return
    let p = _term_optional_path(s, parts, s.cwd)
    if not vfs.exists(s.fs, p)
        _term_reply(s, "ls: " + _term_missing(s, p))
        return
    if not vfs.is_dir(s.fs, p)
        _term_reply(s, paths.base(p))
        return
    let names = []
    for n in vfs.list(s.fs, p)
        if vfs.is_dir(s.fs, paths.join(p, n))
            append(names, n + "/")
        else
            append(names, n)
    for line in _pack(names, s.cols)
        _term_reply(s, line)

fun _term_cat(s, path)
    if _term_not_folder(s, "cat", path, false)
        return
    let p = _term_path(s, path)
    if not vfs.exists(s.fs, p)
        _term_reply(s, "cat: " + _term_missing(s, p))
        return
    if vfs.is_dir(s.fs, p)
        _term_reply(s, "cat: is a folder: " + p)
        return
    try
        let text = vfs.read(s.fs, p)
        if strings.ends_with(text, "\n")
            text = slice(text, 0, len(text) - 1)
        if text != "" or vfs.size(s.fs, p) > 0
            # only the lines the history keeps, so a big file does not stall the frame
            for line in last_lines(text, term_history)
                _term_reply(s, line)
    catch err
        _term_reply(s, "cat: " + err.message)

fun _term_cd(s, parts)
    let p = _term_optional_path(s, parts, "/home")
    if vfs.is_dir(s.fs, p)
        s.cwd = p
    else if vfs.exists(s.fs, p)
        _term_reply(s, "cd: not a folder: " + p)
    else
        _term_reply(s, "cd: " + _term_missing(s, p))

# Why p cannot be made as a new file or folder, or none: the nearest part of
# the path that exists is a file, or the folder it should go in is missing.
# vfs only says "cannot write p", which does not say which part is wrong.
fun _why_not_new(fs, p)
    let up = paths.dir(p)
    while not vfs.exists(fs, up)
        up = paths.dir(up)
    if not vfs.is_dir(fs, up)
        return "not a folder: " + up
    if up != paths.dir(p)
        return "no folder: " + paths.dir(p)
    return none

# Why p is not there: a part of its path is a file, or it is simply missing.
fun _term_missing(s, p)
    let up = paths.dir(p)
    while not vfs.exists(s.fs, up)
        up = paths.dir(up)
    if not vfs.is_dir(s.fs, up)
        return "not a folder: " + up
    return "not found: " + p

fun _term_mkdir(s, path)
    let p = _term_path(s, path)
    if vfs.exists(s.fs, p)
        _term_reply(s, "mkdir: already there: " + p)
        return
    let up = paths.dir(p)
    while not vfs.exists(s.fs, up)
        up = paths.dir(up)
    if not vfs.is_dir(s.fs, up)   # mkdir makes missing folders, but not inside a file
        _term_reply(s, "mkdir: not a folder: " + up)
        return
    try
        vfs.make_dir(s.fs, p)
    catch err
        _term_reply(s, "mkdir: " + err.message)

fun _term_touch(s, path)
    if _term_not_folder(s, "touch", path, true)
        return
    let p = _term_path(s, path)
    if vfs.exists(s.fs, p)
        return
    let why = _why_not_new(s.fs, p)
    if why != none
        _term_reply(s, "touch: " + why)
        return
    try
        vfs.write(s.fs, p, "")
    catch err
        _term_reply(s, "touch: " + err.message)

# write and echo > replace the file; echo >> adds to the end. Each adds a newline.
fun _term_write(s, cmd, path, text, add)
    if _term_not_folder(s, cmd, path, true)
        return
    let p = _term_path(s, path)
    if vfs.is_dir(s.fs, p)
        _term_reply(s, cmd + ": is a folder: " + p)
        return
    if not vfs.exists(s.fs, p)
        let why = _why_not_new(s.fs, p)
        if why != none
            _term_reply(s, cmd + ": " + why)
            return
    try
        if add
            vfs.append(s.fs, p, text + "\n")
        else
            vfs.write(s.fs, p, text + "\n")
    catch err
        _term_reply(s, cmd + ": " + err.message)

fun _term_echo(s, parts)
    let n = len(parts)
    if n >= 2 and (parts[n - 1] == ">" or parts[n - 1] == ">>")
        _term_reply(s, "echo: missing redirect path")
    else if n >= 3 and (parts[n - 2] == ">" or parts[n - 2] == ">>") and strings.starts_with(parts[n - 1], "-")
        _term_reply(s, "echo: a path cannot start with -: " + parts[n - 1])
    else if n >= 3 and (parts[n - 2] == ">" or parts[n - 2] == ">>")
        _term_write(s, "echo", parts[n - 1], strings.join(slice(parts, 1, n - 2), " "), parts[n - 2] == ">>")
    else
        _term_reply(s, strings.join(slice(parts, 1, n), " "))

fun _term_rm(s, path)
    if _term_not_folder(s, "rm", path, false)
        return
    let p = _term_path(s, path)
    if not vfs.exists(s.fs, p)
        _term_reply(s, "rm: " + _term_missing(s, p))
    else if vfs.is_dir(s.fs, p) and len(vfs.list(s.fs, p)) > 0
        _term_reply(s, "rm: folder not empty: " + p)
    else
        try
            vfs.remove(s.fs, p)
        catch err
            _term_reply(s, "rm: " + err.message)

# mv a b: rename a to b, or move a into b when b is a folder.
fun _term_mv(s, a, b)
    # a folder may move to a new name ending in /, a file may not
    let file = not vfs.is_dir(s.fs, _term_path(s, a))
    if _term_not_folder(s, "mv", a, false) or _term_not_folder(s, "mv", b, file)
        return
    let src = _term_path(s, a)
    let dst = _term_path(s, b)
    if vfs.is_dir(s.fs, dst)
        dst = paths.join(dst, paths.base(src))
    if not vfs.exists(s.fs, src)
        _term_reply(s, "mv: " + _term_missing(s, src))
    else if vfs.is_dir(s.fs, src) and (src == "/" or strings.starts_with(dst, src + "/"))
        _term_reply(s, "mv: cannot move " + src + " into itself")
    else if vfs.exists(s.fs, dst)
        _term_reply(s, "mv: already there: " + dst)
    else if _why_not_new(s.fs, dst) != none
        _term_reply(s, "mv: " + _why_not_new(s.fs, dst))
    else
        try
            vfs.rename(s.fs, src, dst)
        catch err
            _term_reply(s, "mv: " + err.message)

# The words of a line; a run of spaces counts as one.
fun _words(line)
    let out = []
    for w in strings.split(line, " ")
        if w != ""
            append(out, w)
    return out

# Commands whose words are all paths, so a word like -l or -r is a mistake, not a name.
let _path_commands = ["cd", "ls", "cat", "mkdir", "touch", "rm", "mv"]

fun _term_run(s, line)
    s.cwd = _existing_dir(s.fs, s.cwd)
    let trimmed = strings.trim(line)
    _term_reply(s, s.cwd + "> " + line)
    if trimmed == ""
        return
    let parts = _words(trimmed)
    let cmd = parts[0]
    if cmd in _path_commands
        for word in slice(parts, 1, len(parts))
            if strings.starts_with(word, "-")
                _term_reply(s, cmd + ": no options, not even " + word)
                return
    # write's first word is a path too (the rest is text): a file named -x could
    # not be read or removed afterwards, since cat and rm refuse the word
    if cmd == "write" and len(parts) > 1 and strings.starts_with(parts[1], "-")
        _term_reply(s, "write: no options, not even " + parts[1])
        return
    if cmd == "help"
        _term_reply(s, "help clear echo apps date")
        _term_reply(s, "pwd cd ls cat mkdir touch")
        _term_reply(s, "write rm mv")
        _term_reply(s, "echo text > file, >> adds")
    else if cmd == "clear"
        if _term_args(s, parts, 0, "clear")
            s.buf = []
    else if cmd == "echo"
        _term_echo(s, parts)
    else if cmd == "apps"
        if _term_args(s, parts, 0, "apps")
            let names = []
            for app in default_apps()
                append(names, app.name)
            _term_reply(s, strings.join(names, ", "))
    else if cmd == "date"
        if _term_args(s, parts, 0, "date")
            _term_reply(s, format_time(time.now()))
    else if cmd == "pwd"
        if _term_args(s, parts, 0, "pwd")
            _term_reply(s, s.cwd)
    else if cmd == "cd"
        if len(parts) > 2
            _term_reply(s, "usage: cd [path]")
        else
            _term_cd(s, parts)
    else if cmd == "ls"
        if len(parts) > 2
            _term_reply(s, "usage: ls [path]")
        else
            _term_ls(s, parts)
    else if cmd == "cat"
        if _term_args(s, parts, 1, "cat <path>")
            _term_cat(s, parts[1])
    else if cmd == "mkdir"
        if _term_args(s, parts, 1, "mkdir <path>")
            _term_mkdir(s, parts[1])
    else if cmd == "touch"
        if _term_args(s, parts, 1, "touch <path>")
            _term_touch(s, parts[1])
    else if cmd == "write"
        if len(parts) > 1
            _term_write(s, "write", parts[1], strings.join(slice(parts, 2, len(parts)), " "), false)
        else
            _term_reply(s, "usage: write <path> <text>")
    else if cmd == "rm"
        if _term_args(s, parts, 1, "rm <path>")
            _term_rm(s, parts[1])
    else if cmd == "mv"
        if _term_args(s, parts, 2, "mv <from> <to>")
            _term_mv(s, parts[1], parts[2])
    else
        _term_reply(s, "unknown: " + cmd)

fun _term_key(s, k)
    if k == "return" or k == "enter"
        _term_run(s, s.input)
        s.input = ""
    else
        s.input = _typed(s.input, k)

# Files: browse the shared VFS. Click a row or use up/down/return/backspace.
fun _files_init() = {fs: _shell_fs, path: "/home", sel: 0, first: 1, rows: 0, names: [], names_path: "", stale: false, recovered: false}

fun _files_names(s)
    let old_path = s.path
    s.path = _existing_dir(s.fs, s.path)
    s.recovered = old_path != s.path
    let names = []
    if s.path != "/"
        append(names, "..")
    for n in vfs.list(s.fs, s.path)
        append(names, n)
    s.stale = false
    if s.names_path == s.path and s.sel < len(s.names) and s.sel >= 0
        let selected = s.names[s.sel]
        let found = false
        for i in 0..len(names)
            if names[i] == selected
                s.sel = i
                found = true
        if not found
            s.sel = 0
            s.stale = true
    else if s.names_path != "" and s.names_path != s.path
        s.sel = 0
    if s.recovered
        s.sel = 0
        s.stale = true
    s.names = names
    s.names_path = s.path
    return names

fun _files_full(s, name)
    if name == ".."
        return paths.dir(s.path)
    if s.path == "/"
        return "/" + name
    return s.path + "/" + name

fun _files_clamp_selection(s, names)
    if s.sel >= len(names)
        s.sel = len(names) - 1
    if s.sel < 0
        s.sel = 0

# prefix + path, with the start of the path replaced by ... when it is longer
# than cols, so the folder you are in stays readable in a narrow window. With
# no room for the prefix it goes too. cols 0 means not drawn yet: no change.
fun _fit_path(prefix, path, cols)
    if cols <= 3 or len(prefix) + len(path) <= cols
        return prefix + path
    let keep = cols - len(prefix) - 3
    if keep < 1
        return "..." + slice(path, math.max(0, len(path) - (cols - 3)), len(path))
    return prefix + "..." + slice(path, len(path) - keep, len(path))

fun _files_lines(s)
    let names = _files_names(s)
    let cols = 0
    if "cols" in s
        cols = s.cols
    let out = [_fit_path("Files: ", s.path, cols)]
    _files_clamp_selection(s, names)
    for i in 0..len(names)
        let mark = "  "
        if i == s.sel
            mark = "> "
        let name = names[i]
        if name != ".." and vfs.is_dir(s.fs, _files_full(s, name))
            append(out, mark + name + "/")
        else
            append(out, mark + name)
    return out

# The line of _files_lines that holds the selection (line 0 is the title).
fun _files_selected(s)
    return s.sel + 1

# Go to the parent folder with the folder you were in selected, so going back
# down is one key. Used by backspace and by opening "..".
fun _files_up(s)
    let child = paths.base(s.path)
    s.path = paths.dir(s.path)
    let names = _files_names(s)
    for i in 0..len(names)
        if names[i] == child
            s.sel = i

fun _files_open(s, name)
    let full = _files_full(s, name)
    if name == ".."
        _files_up(s)
    else if vfs.is_dir(s.fs, full)
        s.path = full
        s.sel = 0
    else
        # the next Editor window opens this file
        _shell_open.path = full

# Line r covers y from text_top + line_height * r. Line 0 is the title.
# A row opens on a single click. The second press of a double-click is
# ignored, so double-clicking a folder enters it once instead of also opening
# the row that lands under the pointer inside.
fun _files_click(s, x, y)
    if "clicks" in s and s.clicks >= 2
        return
    if y < text_top
        return
    let row = int((y - text_top) / line_height)
    if row <= 0 or row >= s.rows
        return
    let names = _files_names(s)
    let i = row - 1 + s.first - 1   # s.first is the first visible list line, set by _click_in
    if i >= 0 and i < len(names)
        s.sel = i
        _files_open(s, names[i])

fun _files_key(s, k)
    let names = _files_names(s)
    # another app may have removed files since the last draw
    _files_clamp_selection(s, names)
    if k == "up"
        if s.sel > 0
            s.sel = s.sel - 1
    else if k == "down"
        if s.sel < len(names) - 1
            s.sel = s.sel + 1
    else if k == "return" or k == "enter"
        if len(names) > 0 and not s.stale
            _files_open(s, names[s.sel])
    else if k == "backspace"
        if s.path != "/" and not s.recovered
            _files_up(s)

# Editor: text buffer over a VFS path. Type like Notes; ctrl+s saves.
# It opens the file last opened in Files, or /home/welcome.txt.
fun _editor_init()
    let path = _shell_open.path
    let text = ""
    let status = "open"
    if vfs.is_dir(_shell_fs, path)
        status = "is a folder"
    else if not vfs.exists(_shell_fs, path)
        # nothing to read yet: Ctrl+S makes it, unless a part of the path is wrong
        status = "new file"
        if _why_not_new(_shell_fs, path) != none
            status = _why_not_new(_shell_fs, path)
    else
        try
            text = vfs.read(_shell_fs, path)
        catch err
            status = err.message
    return {fs: _shell_fs, path: path, text: text, status: status, rows: 0}

# The last `count` lines of text, split on newlines (all of them when count is 0).
# It scans back from the end, so a big file costs a few rows, not a split of everything.
# It reads the text in chunks: indexing one character of a long string costs time
# in proportion to its length, so scanning a 200,000-character line one index at a
# time took seconds.
let _scan_chunk = 1024
fun last_lines(text, count)
    if count <= 0
        return strings.split(text, "\n")
    let found = 0
    let stop = len(text)
    while stop > 0
        let start = math.max(0, stop - _scan_chunk)
        let cs = []
        for c in slice(text, start, stop)
            append(cs, c)
        let j = len(cs) - 1
        while j >= 0
            if cs[j] == "\n"
                found = found + 1
                if found == count
                    return strings.split(slice(text, start + j + 1, len(text)), "\n")
            j = j - 1
        stop = start
    if found == 0
        return [text]
    return strings.split(text, "\n")

# The title line (the status first: a window is often too narrow for the end of it), then one line per line of text (the font has no newline glyph); the cursor is on the last.
# When the whole title does not fit, the save hint goes first, then the start
# of the path, so the file name stays in view. A status too long to leave room
# for the path (an error) keeps the old cut: the status matters more.
fun _editor_lines(s)
    let head = "Editor [" + s.status + "] "
    let title = head + s.path + "  (ctrl+s save)"
    if "cols" in s and s.cols > 0 and len(title) > s.cols
        title = head + s.path
        if len(head) + 4 <= s.cols
            title = _fit_path(head, s.path, s.cols)
    let out = [title]
    for line in last_lines(s.text + "_", s.rows)
        append(out, line)
    return out

fun _editor_click(s, x, y)
    return none

fun _editor_key(s, k)
    if k == "ctrl+s"
        # the same reasons the Terminal gives, shorter than "cannot write" and the whole path
        if vfs.is_dir(s.fs, s.path)
            s.status = "is a folder"
            return
        if not vfs.exists(s.fs, s.path) and _why_not_new(s.fs, s.path) != none
            s.status = _why_not_new(s.fs, s.path)
            return
        try
            vfs.write(s.fs, s.path, s.text)
            s.status = "saved"
        catch err
            s.status = err.message
    else
        let text = s.text
        if k == "return" or k == "enter"
            text = text + "\n"
        else
            text = _typed(text, k)
        if text != s.text
            s.text = text
            s.status = "edited"

let clicker = {name: "Clicker", width: 180, height: 60, init: _clicker_init, lines: _clicker_lines, on_click: _clicker_click, on_key: _clicker_key}
let notes = {name: "Notes", width: 220, height: 60, init: _notes_init, lines: _notes_lines, on_click: _notes_click, on_key: _notes_key, tail: true, pinned: 1}
let terminal = {name: "Terminal", width: 280, height: 120, init: _term_init, lines: _term_lines, on_click: _term_click, on_key: _term_key, tail: true, pinned: 0}
let files_app = {name: "Files", width: 260, height: 140, init: _files_init, lines: _files_lines, on_click: _files_click, on_key: _files_key, selected: _files_selected}
let editor = {name: "Editor", width: 320, height: 80, init: _editor_init, lines: _editor_lines, on_click: _editor_click, on_key: _editor_key, tail: true, pinned: 1}
fun default_apps() = [clicker, notes, terminal, files_app, editor]
