# shell/desktop.relic: a first MONOLITH 2 desktop, written in Relic (M11).
#   relic/build-sdl/relic shell/desktop.relic
# Click Start (again to close the menu), pick an app, click inside it or type.
# Drag a title bar to move, drag the bottom-right corner to resize. The x box
# closes a window, the _ box minimizes it. A taskbar button brings its window
# to the front, or minimizes it if it is already in front; click it again to
# restore. Ctrl+S saves in the Editor. Escape quits.
# Input comes as graphics events and wm.handle turns them into app input, so
# typed text keeps its case and symbols.
use wm
use std/graphics

fun draw_box(b, r, g, bl)
    graphics.rect(b[0], b[1], b[2], b[3], r, g, bl)

fun draw(d)
    graphics.clear(30, 60, 90)
    graphics.text(8, 8, "MONOLITH 2", 200, 220, 240)
    for w in d.windows
        if w.minimized
            next
        let top = w == wm.focused(d)
        if top
            draw_box([w.x, w.y, w.width, wm.title_height], 60, 90, 160)
        else
            draw_box([w.x, w.y, w.width, wm.title_height], 90, 90, 100)
        draw_box([w.x, w.y + wm.title_height, w.width, w.height], 235, 235, 235)
        graphics.text(w.x + 4, w.y + 2, w.app.name, 255, 255, 255)
        let cb = wm.close_box(w)
        draw_box(cb, 180, 60, 60)
        graphics.text(cb[0] + 4, cb[1] + 2, "x", 255, 255, 255)
        let mb = wm.minimize_box(w)
        draw_box(mb, 110, 110, 125)
        graphics.text(mb[0] + 4, mb[1] + 2, "_", 255, 255, 255)
        let row = 0
        for line in wm.visible_lines(w)
            graphics.text(w.x + 6, w.y + wm.title_height + 6 + row * 14, line, 20, 20, 20)
            row = row + 1
        let rb = wm.resize_box(w)
        draw_box(rb, 160, 160, 170)
    let bt = wm.bar_top(d)
    draw_box([0, bt, d.width, wm.bar_height], 50, 50, 55)
    draw_box([2, bt + 3, wm.start_width - 4, wm.bar_height - 6], 70, 130, 70)
    graphics.text(8, bt + 6, "Start", 255, 255, 255)
    let t = wm.tabs(d)
    for i in 0..len(t)
        let b = wm.tab_box(d, i)
        if t[i] == wm.focused(d)
            draw_box(b, 100, 100, 120)
        else
            draw_box(b, 75, 75, 85)
        graphics.text(b[0] + 6, b[1] + 3, wm.tab_label(d, t[i]), 255, 255, 255)
    if d.menu_open
        for i in 0..len(d.apps)
            let b = wm.menu_item_box(d, i)
            draw_box(b, 220, 220, 225)
            graphics.text(b[0] + 6, b[1] + 3, d.apps[i].name, 20, 20, 20)
    graphics.present()

if not graphics.available()
    print("this relic was built without graphics; rebuild with -DRELIC_SDL=ON")
else
    let d = wm.new_desktop(640, 480, wm.default_apps())
    graphics.open(d.width, d.height, "MONOLITH 2")
    let running = true
    while running and not graphics.quit_requested()
        let e = graphics.next_event()
        while e != none
            if e.type == "key_down" and e.key == "escape"
                running = false
            else
                wm.handle(d, e)
            e = graphics.next_event()
        draw(d)
        graphics.wait(16)
    graphics.close()
